# ==============================================================================
# Commands.psd1 - Catalogue des commandes pour Toolbox-SystemCommands_Win11.ps1
# ==============================================================================
# Fichier de donnees PowerShell (charge via Import-PowerShellDataFile, en mode
# "restricted language" : aucune variable, aucune execution de code n'est
# possible ici, uniquement des litteraux (chaines, nombres, $true/$false,
# tableaux @(), tables de hachage @{})).
#
# IMPORTANT - Champ "Cmd" :
# Toujours utiliser des GUILLEMETS SIMPLES ('...') pour le champ Cmd, jamais
# des guillemets doubles ("..."). Les guillemets simples ne sont JAMAIS
# interpoles par PowerShell : un $_ , $err ou toute autre variable y reste
# strictement litteral et sera transmis tel quel a la commande enfant. C'est
# ce qui a corrige plusieurs bugs historiques (v1.4.3 : $_ non echappe dans
# "Top processus RAM" ; v1.4.4-like risques similaires). Ne jamais revenir a
# des guillemets doubles pour Cmd, meme pour un besoin ponctuel.
# Si le texte contient lui-meme un guillemet simple (ex: Where-Object Status
# -eq 'Error'), le doubler : '' (deux guillemets simples consecutifs).
#
# Chaque commande : Label (texte du bouton), Cmd (commande executee),
# Desc (explication affichee), Confirm (demande une confirmation Oui/Non
# avant de lancer, $true/$false).
# ==============================================================================
@{
    Categories = @(
        @{
            Name = "Integrite systeme"
            Commands = @(
                @{ Label = "SFC /scannow"
                   Cmd   = 'sfc /scannow'
                   Desc  = "Verifie l'integrite de tous les fichiers systeme proteges et remplace automatiquement les versions corrompues par une copie saine (cache local). Duree : 10-20 min."
                   Confirm = $false }
                @{ Label = "SFC /verifyonly"
                   Cmd   = 'sfc /verifyonly'
                   Desc  = "Meme verification que /scannow mais sans rien corriger : plus rapide, utile pour juste diagnostiquer avant d'agir."
                   Confirm = $false }
                @{ Label = "DISM CheckHealth"
                   Cmd   = 'DISM /Online /Cleanup-Image /CheckHealth'
                   Desc  = "Verification rapide (quelques secondes) qui indique si l'image Windows (le magasin de composants) est marquee comme corrompue, sans scan approfondi."
                   Confirm = $false }
                @{ Label = "DISM ScanHealth"
                   Cmd   = 'DISM /Online /Cleanup-Image /ScanHealth'
                   Desc  = "Scan approfondi du magasin de composants Windows (WinSxS) pour detecter une corruption. Plus long que CheckHealth (5-10 min), mais plus fiable."
                   Confirm = $false }
                @{ Label = "DISM RestoreHealth"
                   Cmd   = 'DISM /Online /Cleanup-Image /RestoreHealth'
                   Desc  = "Repare le magasin de composants en telechargeant les fichiers sains via Windows Update. A lancer si ScanHealth signale une corruption. Necessite une connexion internet."
                   Confirm = $false }
                @{ Label = "DISM StartComponentCleanup"
                   Cmd   = 'DISM /Online /Cleanup-Image /StartComponentCleanup'
                   Desc  = "Purge les anciennes versions de composants (mises a jour remplacees, etc.) dans WinSxS pour liberer de l'espace disque. Sans risque, ne touche pas aux composants actifs."
                   Confirm = $false }
                @{ Label = "Repair-WindowsImage RestoreHealth (PS)"
                   Cmd   = 'powershell -NoExit -Command Repair-WindowsImage -Online -RestoreHealth'
                   Desc  = "Equivalent PowerShell natif de DISM RestoreHealth. Meme resultat, juste une autre commande si tu prefes rester en contexte PowerShell."
                   Confirm = $false }
                @{ Label = "Pack Integrite complet (CHKDSK+DISM+SFC)"
                   Cmd   = 'powershell -NoExit -Command Write-Host; Write-Host; Write-Host ''=== CHKDSK C: /scan ==='' -ForegroundColor Cyan; chkdsk C: /scan; Write-Host; Write-Host; Write-Host ''=== DISM CheckHealth ==='' -ForegroundColor Cyan; DISM /Online /Cleanup-Image /CheckHealth; Write-Host; Write-Host; Write-Host ''=== DISM ScanHealth ==='' -ForegroundColor Cyan; DISM /Online /Cleanup-Image /ScanHealth; Write-Host; Write-Host; Write-Host ''=== SFC /verifyonly ==='' -ForegroundColor Cyan; sfc /verifyonly; Write-Host; Write-Host; Write-Host ''Si CHKDSK, DISM ou SFC ont signale une anomalie ci-dessus : lancez DISM RestoreHealth (commande separee du catalogue) si le magasin de composants est corrompu, puis SFC /scannow pour reparer les fichiers systeme.'' -ForegroundColor Yellow'
                   Desc  = "Enchaine 4 verifications purement diagnostiques, sans aucune reparation automatique : CHKDSK C: /scan, DISM CheckHealth, DISM ScanHealth, puis SFC /verifyonly (verifie l'integrite des fichiers systeme SANS les modifier, contrairement a /scannow). Si une anomalie est signalee par l'une des 4 etapes, un message jaune final rappelle la marche a suivre (DISM RestoreHealth puis SFC /scannow, a lancer manuellement via les commandes separees du catalogue). Chaque etape est annoncee par un en-tete cyan natif (-ForegroundColor Cyan), precede de 2 lignes vides. Duree : 10-20 min selon la machine."
                   Confirm = $false
                   Help  = "Ce pack est volontairement 100% diagnostique - aucune des 4 etapes ne modifie quoi que ce soit sur le systeme, y compris SFC qui tourne ici en /verifyonly (verification) et non /scannow (reparation).`n`nPourquoi /verifyonly plutot que /scannow : SFC /scannow puise dans le magasin de composants Windows (WinSxS) pour remplacer les fichiers systeme corrompus - si ce magasin est lui-meme corrompu (ce que DISM ScanHealth peut detecter juste avant), une reparation automatique risquerait de se faire depuis une source non fiable, sans erreur visible. En restant en /verifyonly, ce risque n'existe structurellement plus : rien n'est jamais repare automatiquement par ce pack, seulement diagnostique. La reparation reelle (DISM RestoreHealth puis SFC /scannow) reste une decision humaine, prise en lisant les resultats affiches ci-dessus et en lancant les commandes correspondantes separement.`n`nCHKDSK, DISM et SFC sont ici tous les trois des outils natifs Windows (chkdsk.exe, dism.exe, sfc.exe) invoques directement - PowerShell ne sert que d'enveloppe legere pour l'affichage (en-tetes en cyan natif de la console, -ForegroundColor Cyan, et 2 lignes vides de separation entre chaque etape pour la lisibilite dans le long defilement de sortie CHKDSK/DISM/SFC). Le cyan natif suffit ici : le rendu depend du theme Windows Terminal utilise, et n'a pas besoin d'un code ANSI dedie sur les machines ou ce theme offre deja un bon contraste." }
                @{ Label = "Points de restauration existants"
                   Cmd   = 'powershell -NoExit -Command try { Get-ComputerRestorePoint ^| Select-Object SequenceNumber,Description,CreationTime,RestorePointType ^| Format-Table -AutoSize } catch { Write-Host ''Aucun point de restauration trouve (protection systeme probablement desactivee sur C:).'' -ForegroundColor Yellow }'
                   Desc  = "Liste les points de restauration systeme disponibles. Utile a consulter avant de lancer une operation risquee (CHKDSK /f, DISM RestoreHealth, Reset Winsock/TCP-IP...) pour savoir si un retour arriere est possible. Message clair si la protection systeme est desactivee sur C:, plutot qu'une erreur bloquante."
                   Confirm = $false }
                @{ Label = "Creer un point de restauration"
                   Cmd   = 'powershell -NoExit -Command try { Checkpoint-Computer -Description ''Toolbox_manuel'' -RestorePointType ''MODIFY_SETTINGS''; Write-Host ''Point de restauration demande.'' -ForegroundColor Green } catch { Write-Host ''Echec : la protection systeme (System Restore) est probablement desactivee sur C:.'' -ForegroundColor Red }'
                   Desc  = "Cree un point de restauration avant une manipulation risquee. Non destructif, aucune confirmation necessaire. Attention : Windows limite nativement la creation a un point toutes les 24h (SystemRestorePointCreationFrequency) - un appel repete dans cette fenetre est silencieusement ignore par Windows lui-meme, pas un bug de cette commande."
                   Confirm = $false }
                @{ Label = "Etat service TrustedInstaller"
                   Cmd   = 'powershell -NoExit -Command $svc = Get-Service TrustedInstaller; Write-Host (''Statut actuel : '' + $svc.Status + '' - Mode de demarrage : '' + $svc.StartType) -ForegroundColor Cyan; if ($svc.StartType -eq ''Manual'' -and $svc.Status -eq ''Stopped'') { Write-Host ''Etat normal : ce service demarre uniquement a la demande (SFC, DISM, Windows Update) puis se coupe automatiquement une fois la tache terminee - rester sur Stopped en dehors de ces operations est un comportement attendu, pas une anomalie.'' -ForegroundColor Green } elseif ($svc.StartType -eq ''Disabled'') { Write-Host ''ANOMALIE : ce service est desactive - SFC, DISM et Windows Update echoueront tant que ce service reste desactive.'' -ForegroundColor Red } else { Write-Host ''Etat a verifier au cas par cas (voir le bouton ? pour le detail des etats possibles).'' -ForegroundColor Yellow }'
                   Desc  = "Verifie l'etat du service TrustedInstaller (Windows Modules Installer), dont dependent SFC, DISM et Windows Update pour modifier les fichiers systeme proteges. Signale clairement si l'etat observe (Stopped/Manual) est normal ou s'il s'agit d'une anomalie (service desactive), plutot que de laisser deviner - a verifier en premier reflexe en cas d'echec inexplique du Pack Integrite ou d'une mise a jour."
                   Confirm = $false
                   Help  = "Le service TrustedInstaller (nom affiche 'Windows Modules Installer') est responsable de l'installation, la modification et la suppression des composants Windows proteges, ainsi que de l'application des mises a jour systeme - il detient reellement les droits d'ecriture sur les fichiers systeme les plus sensibles, au-dela meme d'un compte Administrateur local classique.`n`nSon mode de demarrage normal est 'Manual' (a la demande) et non 'Automatic' : il ne tourne pas en permanence, seulement le temps d'une operation SFC, DISM ou Windows Update, puis s'arrete de lui-meme une fois la tache terminee. Un statut 'Stopped' au repos est donc parfaitement normal et ne signifie pas un probleme - c'est au contraire l'etat attendu la plupart du temps.`n`nCe qui EST anormal : un mode de demarrage passe sur 'Disabled'. Dans ce cas, SFC /scannow, DISM RestoreHealth et l'installation de mises a jour Windows echoueront systematiquement avec des erreurs peu explicites, sans lien evident avec ce service en apparence. Si un Pack Integrite ou une mise a jour echoue de maniere inexpliquee, verifier cet etat en premier est un reflexe utile avant de chercher plus loin." }
                @{ Label = "CBS.log filtre (reparations SFC)"
                   Cmd   = 'powershell -NoExit -Command $chemin = Join-Path $env:windir ''Logs\CBS\CBS.log''; if (Test-Path $chemin) { $lignes = Select-String -Path $chemin -Pattern ''\[SR\]'' -ErrorAction SilentlyContinue; if ($lignes) { $lignes ^| Select-Object -Last 30 ^| ForEach-Object { Write-Host $_.Line } } else { Write-Host ''Aucune ligne [SR] trouvee dans CBS.log (aucune reparation SFC recente enregistree).'' -ForegroundColor Green } } else { Write-Host ''Fichier CBS.log introuvable.'' -ForegroundColor Yellow }'
                   Desc  = "Filtre le journal CBS.log (Component-Based Servicing) sur les lignes marquees [SR] (Servicing Repair), qui detaillent precisement quels fichiers SFC a repare ou tente de reparer lors de son dernier passage - information plus fine que le simple resultat global affiche par 'SFC /scannow'. Affiche les 30 dernieres lignes correspondantes."
                   Confirm = $false
                   Help  = "CBS.log est le journal complet de toutes les operations de maintenance de composants Windows (SFC, DISM, installation de mises a jour...) - un fichier qui grossit en continu et peut rapidement atteindre plusieurs dizaines de Mo, melangeant des milliers de lignes non liees a SFC. Le marqueur [SR] (Servicing Repair) isole specifiquement les lignes ecrites par le sous-systeme de reparation utilise par SFC, permettant de voir precisement quel fichier a ete identifie comme corrompu et si son remplacement a reussi ou echoue - une information que 'SFC /scannow' resume seulement en un compte global (X fichiers corrompus trouves/repares).`n`nA executer juste apres un 'SFC /scannow' ou 'SFC /verifyonly' pour le detail complet, plutot que d'ouvrir manuellement le fichier (souvent volumineux) dans un editeur de texte. Si aucune ligne [SR] n'est trouvee, c'est soit qu'aucun SFC n'a jamais ete execute sur cette machine, soit qu'aucune corruption n'a jamais ete detectee lors des executions precedentes." }
            )
        }
        @{
            Name = "Disque"
            Commands = @(
                @{ Label = "CHKDSK C: (lecture seule)"
                   Cmd   = 'chkdsk C:'
                   Desc  = "Analyse le systeme de fichiers du disque C: SANS rien corriger et sans demonter le volume. Sans danger, s'execute immediatement."
                   Confirm = $false
                   Help  = "Utilise le moteur CHKDSK historique (present depuis les debuts de Windows NT) : verifie la structure de base du systeme de fichiers - enregistrements de fichiers (MFT), index de dossiers, descripteurs de securite - en trois etapes classiques. Sans /f ni /scan, aucune correction n'est ecrite, meme si une erreur est detectee : c'est un diagnostic pur.`n`nDifference avec 'CHKDSK C: /scan' juste en dessous : cette version-ci n'utilise PAS le moteur de verification 'en ligne' plus recent (introduit avec Windows 8), et ne s'integre pas au systeme d'auto-reparation NTFS moderne. C'est le mode le plus simple et le plus rapide des deux, mais aussi le moins approfondi - pense a lui comme une verification de surface, la ou /scan va plus loin avec de meilleurs outils." }
                @{ Label = "CHKDSK C: /scan"
                   Cmd   = 'chkdsk C: /scan'
                   Desc  = "Scan en ligne du volume (le disque reste utilisable pendant l'analyse) qui signale les erreurs trouvees, sans les corriger ni necessiter de redemarrage."
                   Confirm = $false
                   Help  = "Utilise le moteur de verification 'en ligne' introduit avec Windows 8/Server 2012 - le meme moteur que Windows utilise automatiquement en arriere-plan pour surveiller periodiquement l'etat des volumes NTFS. Plus complet et plus moderne que le CHKDSK classique, il s'integre au systeme d'auto-reparation NTFS.`n`nDifference avec 'CHKDSK C: (lecture seule)' juste au-dessus : /scan est le mode recommande aujourd'hui pour un diagnostic serieux sans corriger - plus approfondi que le CHKDSK basique, sans les inconvenients du /f /r (pas de demontage, pas de redemarrage necessaire).`n`nCe que /scan fait de plus : si des corruptions sont detectees, elles sont consignees dans une liste interne a corriger plus tard, plutot que perdues ou nécessitant immédiatement un CHKDSK complet. La suite logique en cas de probleme detecte serait 'chkdsk C: /spotfix' (non present dans ce catalogue) - une correction ciblee et rapide de ces elements precis, qui ne necessite qu'un tres bref demontage du volume plutot que le scan+reparation complet et beaucoup plus long de 'CHKDSK C: /f /r (au reboot)' deja present dans le catalogue." }
                @{ Label = "CHKDSK C: /f /r (au reboot)"
                   Cmd   = 'chkdsk C: /f /r'
                   Desc  = "ATTENTION : programme une verification ET reparation complete du disque (secteurs defectueux inclus) au PROCHAIN REDEMARRAGE. Le PC redemarrera en mode texte et l'operation peut prendre 30 min a plusieurs heures selon la taille du disque."
                   Confirm = $true
                   Help  = "Ce que fait exactement cette commande : /f verifie et corrige les erreurs du systeme de fichiers (entrees corrompues, index de fichiers incoherents) ; /r fait tout ce que /f fait PLUS un scan physique de chaque secteur du disque pour reperer les secteurs defectueux et migrer les donnees concernees. Comme le disque C: est en cours d'utilisation par Windows lui-meme, l'operation ne peut pas se faire a chaud : elle est programmee via le registre (BootExecute) et se declenche au redemarrage suivant, avant meme que Windows ne charge.`n`nCe que ca implique concretement : le PC redemarre en mode texte noir et blanc (pas d'interface graphique), l'ecran affiche une progression en pourcentage par etape (4 a 5 etapes selon le systeme de fichiers), et la machine est INUTILISABLE pendant toute la duree - pas d'autre usage possible en parallele. Duree tres variable : quelques minutes sur un petit SSD sain, plusieurs heures sur un gros disque avec beaucoup de secteurs a verifier ou des erreurs a corriger.`n`nSi tu changes d'avis : au tout debut du redemarrage, Windows affiche un compte a rebours de quelques secondes avec la possibilite d'appuyer sur une touche pour annuler l'operation programmee - a saisir cette fenetre precise, une fois le scan reellement demarre il vaut mieux le laisser terminer plutot que de forcer un arret (risque d'aggraver une corruption en cours de reparation)." }
                @{ Label = "fsutil dirty query C:"
                   Cmd   = 'fsutil dirty query C:'
                   Desc  = "Indique si le volume C: est marque 'dirty', c'est-a-dire si un CHKDSK est deja planifie au prochain demarrage. Pratique pour verifier avant de relancer /f /r."
                   Confirm = $false }
                @{ Label = "Optimize-Volume ReTrim (SSD)"
                   Cmd   = 'powershell -NoExit -Command Optimize-Volume -DriveLetter C -ReTrim -Verbose'
                   Desc  = "Envoie la commande TRIM au SSD pour l'informer des blocs libres a effacer en interne (maintien des performances long terme). Adapte a un SSD, pas a un HDD."
                   Confirm = $false }
                @{ Label = "Optimize-Volume Defrag (HDD)"
                   Cmd   = 'powershell -NoExit -Command try { $lettre = (Read-Host -Prompt ''Lettre du lecteur a defragmenter (ex: D, sans les deux-points)'').Trim().TrimEnd('':''); $mediaType = (Get-Partition -DriveLetter $lettre -ErrorAction Stop ^| Get-Disk ^| Get-PhysicalDisk).MediaType; if ($mediaType -eq ''HDD'') { Write-Host ($lettre + '' : detecte comme HDD, lancement de la defragmentation...'') -ForegroundColor Green; Optimize-Volume -DriveLetter $lettre -Defrag -Verbose } else { Write-Host ($lettre + '' : detecte comme '' + $mediaType + '' - defragmentation refusee par securite. Seul un HDD confirme est accepte ; utilise la commande ReTrim prevue pour un SSD si besoin.'') -ForegroundColor Red } } catch { Write-Host (''Erreur : '' + $_.Exception.Message) -ForegroundColor Red }'
                   Desc  = "Demande la lettre du lecteur a defragmenter, verifie automatiquement son type de media reel (SSD/HDD/Non specifie) via Get-PhysicalDisk, et refuse de lancer la defragmentation si ce n'est pas un HDD confirme - protection contre une defragmentation accidentelle d'un SSD, qui n'apporte aucun gain et use inutilement ses cycles d'ecriture. Duree variable selon la taille du disque et le niveau de fragmentation (de quelques minutes a plus d'une heure)."
                   Confirm = $false
                   Help  = "La detection du type de media passe par la chaine Get-Partition -> Get-Disk -> Get-PhysicalDisk (association standard du module Storage de Windows), qui remonte la propriete MediaType du disque physique reel derriere la lettre de lecteur choisie.`n`nTrois resultats possibles :`n- HDD : la defragmentation se lance normalement.`n- SSD : refusee, avec suggestion d'utiliser 'Optimize-Volume ReTrim (SSD)' a la place.`n- Non specifie (Unspecified) : egalement refusee par prudence - ce statut apparait parfois sur certains disques externes/USB ou configurations ou Windows ne peut pas determiner le type avec certitude ; mieux vaut verifier manuellement (Gestionnaire de disques, specifications du fabricant) avant de forcer une defragmentation dans ce cas.`n`nSi la lettre de lecteur saisie n'existe pas, un message d'erreur clair s'affiche plutot qu'un plantage." }
                @{ Label = "Etat SMART des disques"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_DiskDrive ^| Select-Object Model,Status,Size ^| Format-Table -AutoSize'
                   Desc  = "Affiche pour chaque disque physique son modele, sa taille et son statut SMART ('OK' si sain). Premiere alerte simple en cas de disque en fin de vie. (Remplace wmic, retire par defaut depuis Windows 11 24H2)."
                   Confirm = $false }
                @{ Label = "Etat disques detaille"
                   Cmd   = 'powershell -NoExit -Command Get-PhysicalDisk ^| Select-Object FriendlyName,MediaType,Size,HealthStatus,OperationalStatus ^| Format-Table -AutoSize'
                   Desc  = "Vue plus complete que le statut SMART simple : type de media (SSD/HDD detecte automatiquement), taille, et surtout HealthStatus + OperationalStatus qui distinguent un disque degrade mais fonctionnel d'un disque en panne franche."
                   Confirm = $false }
                @{ Label = "Latence disque en temps reel"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_PerfFormattedData_PerfDisk_PhysicalDisk ^| Where-Object { $_.Name -eq ''_Total'' } ^| Select-Object Name,AvgDisksecPerTransfer,AvgDiskQueueLength,PercentDiskTime ^| Format-List'
                   Desc  = "Mesure instantanee de la performance disque sous la charge actuelle (pas la sante SMART, voir 'Etat disques detaille' pour ca) : AvgDisksecPerTransfer = latence moyenne par operation (un SSD sain est generalement bien en dessous de 0,005s), AvgDiskQueueLength = operations en attente (proche de 0-1 = sain), PercentDiskTime = % du temps ou le disque est sollicite. Utilise une classe WMI (noms de proprietes fixes en anglais) plutot que Get-Counter, dont les chemins de compteurs sont localises et auraient echoue sur une machine Windows en francais."
                   Confirm = $false }
                @{ Label = "Verifier support TRIM actif"
                   Cmd   = 'powershell -NoExit -Command $sortie = fsutil behavior query DisableDeleteNotify; foreach ($ligne in $sortie) { if ($ligne -match ''(\S+) DisableDeleteNotify = (\d)'') { $fs = $matches[1]; $val = $matches[2]; $etat = if ($val -eq ''0'') { ''TRIM actif (Windows notifie le SSD des blocs a effacer)'' } else { ''TRIM DESACTIVE (deconseille sur un SSD)'' }; Write-Host ($fs + '' : '' + $etat) } }'
                   Desc  = "Verifie si le support TRIM est actif au niveau systeme (NTFS et ReFS separement) : Windows notifie-t-il en continu le SSD des blocs de donnees supprimes a effacer en interne, un comportement permanent en arriere-plan plutot qu'un passage ponctuel comme le fait 'Optimize-Volume ReTrim (SSD)' juste au-dessus. Traduit les valeurs 0/1 renvoyees par fsutil, dont le sens est contre-intuitif (0 = actif, 1 = desactive)."
                   Confirm = $false
                   Help  = "Le nom du parametre fsutil (DisableDeleteNotify) est trompeur si on ne lit pas la valeur avec attention : une valeur de 0 signifie que la desactivation N'EST PAS appliquee, donc que les notifications de suppression (TRIM) SONT envoyees normalement au SSD - et inversement, 1 signifie TRIM reellement desactive. Cette commande traduit directement les deux en 'actif'/'DESACTIVE' pour eviter toute confusion a la lecture.`n`nDifference avec 'Optimize-Volume ReTrim (SSD)' juste au-dessus dans le catalogue : ReTrim declenche un passage TRIM manuel et ponctuel sur un lecteur precis, a l'instant ou tu le lances. Cette commande-ci verifie plutot le comportement systeme permanent : est-ce que Windows envoie ces notifications en continu, au fil de l'utilisation normale de la machine (chaque suppression de fichier), sans intervention manuelle. Les deux sont complementaires, pas redondants : un TRIM systeme actif rend le ReTrim manuel moins necessaire au quotidien, mais un ReTrim ponctuel reste utile apres une operation inhabituelle (grosse suppression, restauration d'image disque) meme si TRIM systeme est actif.`n`nSur un SSD standard, qu'il soit SATA ou NVMe, TRIM devrait normalement etre actif par defaut sans intervention - une valeur DESACTIVE ici serait le signe d'une modification manuelle anterieure (ou d'un logiciel tiers l'ayant desactive), pas un comportement Windows standard a corriger autrement." }
                @{ Label = "Historique erreurs disque (IDs 7/11/51)"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''System''; ProviderName=''disk''; Id=7,11,51} -MaxEvents 10 -ErrorAction Stop ^| Select-Object TimeCreated,@{N=''Type'';E={switch($_.Id){7{''ID 7 - Secteur defectueux detecte''} 11{''ID 11 - Erreur remontee par le controleur de disque''} 51{''ID 51 - Erreur ecriture ou lecture (fichier page ou fichier standard)''} default{''ID '' + $_.Id}}}},Message ^| Format-List } catch { Write-Host ''Aucune erreur disque (IDs 7/11/51) trouvee dans le journal System (bon signe).'' -ForegroundColor Green }'
                   Desc  = "Liste les 10 dernieres erreurs disque de bas niveau (IDs 7, 11, 51, source 'disk') consignees dans le journal System : secteurs defectueux, erreurs remontees par le controleur, echecs de lecture/ecriture. Signal precoce distinct du statut SMART global ('Etat SMART des disques') : SMART peut encore afficher OK alors que ces evenements ponctuels s'accumulent deja en arriere-plan. Message clair si aucune erreur n'est trouvee, plutot qu'une erreur bloquante."
                   Confirm = $false
                   Help  = "Ces trois identifiants sont parmi les erreurs disque les plus anciennes et les plus fiables de Windows, presentes depuis les tout premiers journaux d'evenements NT, bien avant que SMART ne soit expose nativement par les outils modernes :`n`n- ID 7 : le pilote de disque a detecte un secteur defectueux (bad block) lors d'une operation de lecture ou d'ecriture. Un evenement isole peut arriver meme sur un disque sain (secteur reaffecte automatiquement par le disque lui-meme, mecanisme transparent) ; des occurrences repetees et rapprochees indiquent une degradation physique reelle.`n`n- ID 11 : le pilote de disque a signale une erreur remontee par le controleur (I/O error generique) - cable/connexion defaillante, alimentation instable, ou probleme de controleur SATA/NVMe selon le cas, pas necessairement le disque lui-meme en cause.`n`n- ID 51 : erreur d'ecriture ou de lecture sur une operation de pagination (fichier d'echange) ou un fichier standard - peut survenir sur un disque en fin de vie, mais aussi ponctuellement lors d'un arret brutal en cours d'ecriture, sans etre systematiquement le signe d'un disque defaillant.`n`nAucun de ces evenements pris isolement n'est automatiquement alarmant - c'est la FREQUENCE et la RECURRENCE sur plusieurs jours ou semaines qui constituent le vrai signal a surveiller, exactement comme pour 'Historique arrets/redemarrages inattendus' dans la categorie Divers. En cas de doute, croiser avec 'Etat SMART des disques' et 'Etat disques detaille' (HealthStatus/OperationalStatus) pour une image plus complete." }
            )
        }
        @{
            Name = "Reseau"
            Commands = @(
                @{ Label = "Flush DNS"
                   Cmd   = 'ipconfig /flushdns'
                   Desc  = "Vide le cache DNS local. Utile apres un changement de serveur DNS (ex: NextDNS) ou en cas de resolution de nom incorrecte/obsolete."
                   Confirm = $false }
                @{ Label = "Afficher config IP complete"
                   Cmd   = 'ipconfig /all'
                   Desc  = "Affiche en detail la configuration reseau de toutes les interfaces : adresses IP, passerelle, serveurs DNS, adresses MAC, bail DHCP."
                   Confirm = $false }
                @{ Label = "Reset Winsock"
                   Cmd   = 'netsh winsock reset'
                   Desc  = "ATTENTION : reinitialise la pile Winsock (catalogue des protocoles reseau). A utiliser en cas de probleme de connectivite persistant. NECESSITE UN REDEMARRAGE pour prendre effet."
                   Confirm = $true
                   Help  = "Le catalogue Winsock est la liste ordonnee des 'fournisseurs de services' (LSP - Layered Service Providers) que Windows utilise pour chaque connexion reseau : c'est la couche juste au-dessus de la carte reseau elle-meme, avant que les applications ne voient les donnees. Certains logiciels (VPN, certains antivirus avec 'bouclier reseau', logiciels de controle parental) s'inserent dans cette chaine - et un LSP mal desinstalle ou corrompu peut casser TOUTE la connectivite internet, meme si la carte reseau elle-meme fonctionne parfaitement.`n`nCe que fait la commande : reconstruit ce catalogue a son etat par defaut Windows, en retirant tous les LSP tiers qui s'y etaient inseres.`n`nCe que ca implique concretement : si tu utilises un VPN, un antivirus avec filtrage reseau actif, ou tout logiciel qui s'accroche a la pile reseau, il faudra probablement le reinstaller ou le reactiver apres coup - son propre LSP aura ete efface avec le reste. Ne resout PAS un probleme materiel (carte reseau defectueuse, cable, pilote) ni un probleme de routeur/box - uniquement les problemes situes dans cette couche logicielle Windows precise." }
                @{ Label = "Reset pile TCP/IP"
                   Cmd   = 'netsh int ip reset'
                   Desc  = "ATTENTION : reinitialise completement la configuration TCP/IP a son etat par defaut (equivalent a reinstaller la pile reseau). A utiliser en dernier recours. NECESSITE UN REDEMARRAGE."
                   Confirm = $true
                   Help  = "Different de 'Reset Winsock' (qui vise le catalogue des LSP) : celle-ci reinitialise le protocole TCP/IP lui-meme - le mecanisme qui decoupe et achemine les donnees sur le reseau. C'est une couche plus profonde et plus large que Winsock.`n`nCe que ca implique concretement : toute configuration reseau personnalisee sur tes interfaces (adresse IP statique, serveurs DNS manuels, passerelle personnalisee, parametres avances comme la taille de fenetre TCP) est remise a zero et repasse en configuration automatique (DHCP). Si tu avais configure une IP fixe ou des DNS personnalises (un fournisseur DNS tiers configure manuellement, par exemple), il faudra les reconfigurer apres coup. Sans effet sur le materiel (carte reseau, pilote) - uniquement la configuration logicielle du protocole.`n`nA utiliser seulement si 'Reset Winsock' n'a pas suffi a resoudre le probleme - c'est un outil plus radical, pas la premiere chose a essayer." }
                @{ Label = "Renouveler bail IP"
                   Cmd   = 'ipconfig /release && ipconfig /renew'
                   Desc  = "Libere puis redemande une adresse IP aupres du serveur DHCP. Utile si l'IP actuelle semble en conflit ou perimee."
                   Confirm = $false }
                @{ Label = "Connexions actives (netstat)"
                   Cmd   = 'netstat -ano'
                   Desc  = "Liste toutes les connexions reseau actives avec le PID du processus associe. Utile pour identifier ce qui communique sur le reseau en ce moment."
                   Confirm = $false }
                @{ Label = "Table ARP"
                   Cmd   = 'arp -a'
                   Desc  = "Affiche la table de correspondance IP <-> adresse MAC pour les appareils recemment contactes sur le reseau local."
                   Confirm = $false }
                @{ Label = "Test NextDNS (test.nextdns.io)"
                   Cmd   = 'curl.exe -L https://test.nextdns.io'
                   Desc  = "Test officiel NextDNS : verifie si le trafic DNS de la machine passe reellement par NextDNS (interception WFP de l'app desktop y compris), le protocole utilise (DoH/DoT/DoQ) et le point de presence le plus proche. 'status: ok' = actif, 'status: unconfigured' = pas utilise actuellement."
                   Confirm = $false }
                @{ Label = "DNS configure par interface"
                   Cmd   = 'powershell -NoExit -Command Get-DnsClientServerAddress ^| Format-Table -AutoSize'
                   Desc  = "Affiche le ou les serveurs DNS declares sur chaque interface reseau. Utile en diagnostic generique (machine sans NextDNS, autre resolveur) ; ne detecte pas une interception transparente type app NextDNS Desktop (voir Test NextDNS ci-dessus dans ce cas)."
                   Confirm = $false }
                @{ Label = "Etat des adaptateurs reseau"
                   Cmd   = 'powershell -NoExit -Command Get-NetAdapter ^| Format-Table -AutoSize'
                   Desc  = "Liste les interfaces reseau avec leur etat (Up/Down) et leur vitesse de liaison."
                   Confirm = $false }
                @{ Label = "Cache DNS actuel"
                   Cmd   = 'ipconfig /displaydns'
                   Desc  = "Affiche le contenu actuel du cache DNS local, entree par entree, avant de decider de le vider avec Flush DNS. Utile pour reperer precisement une entree perimee ou incorrecte."
                   Confirm = $false }
                @{ Label = "Reseaux Wifi enregistres"
                   Cmd   = 'netsh wlan show profiles'
                   Desc  = "Liste les profils Wifi enregistres sur la machine, sans afficher les mots de passe (il faut l'option 'key=clear' explicite pour ca, absente ici par securite). Renvoie une erreur normale si le service Wifi (wlansvc) est desactive ou si aucun adaptateur sans fil n'est present."
                   Confirm = $false }
                @{ Label = "Vitesse Wifi actuelle"
                   Cmd   = 'netsh wlan show interfaces'
                   Desc  = "Affiche l'etat de la connexion Wifi active : signal, bande (2,4/5 GHz), debit de liaison actuel. Complementaire a 'Reseaux Wifi enregistres' (qui liste les profils connus, pas la connexion en cours). Message d'erreur normal si aucune interface sans fil active."
                   Confirm = $false }
                @{ Label = "Adresse IP publique"
                   Cmd   = 'curl.exe -s https://api.ipify.org'
                   Desc  = "Affiche l'adresse IP publique actuelle de la machine, via une requete HTTPS vers le service tiers api.ipify.org (meme principe de requete externe que 'Test NextDNS' ci-dessus). Utile apres un changement de config reseau ou de VPN pour confirmer par quelle IP tu sors reellement."
                   Confirm = $false }
                @{ Label = "Diagnostic connectivite multi-niveaux"
                   Cmd   = 'powershell -NoExit -Command $gw = (Get-NetRoute -DestinationPrefix ''0.0.0.0/0'' -ErrorAction SilentlyContinue ^| Sort-Object RouteMetric ^| Select-Object -First 1 -ExpandProperty NextHop); if (-not $gw) { $gw = ''introuvable'' }; $cibles = @(@{Nom=''Passerelle locale''; Hote=$gw}, @{Nom=''DNS public (1.1.1.1)''; Hote=''1.1.1.1''}, @{Nom=''Site externe (microsoft.com)''; Hote=''www.microsoft.com''}); $cibles ^| ForEach-Object { $joignable = if ($_.Hote -eq ''introuvable'') { $false } else { Test-NetConnection -ComputerName $_.Hote -InformationLevel Quiet -WarningAction SilentlyContinue }; [PSCustomObject]@{Cible=$_.Nom; Hote=$_.Hote; Joignable=$joignable} } ^| Format-Table -AutoSize'
                   Desc  = "Teste la joignabilite de 3 cibles a des niveaux differents (passerelle locale, DNS public 1.1.1.1, site externe) pour situer rapidement l'origine d'une panne de connectivite : passerelle injoignable = probleme local (Wifi/cable/carte reseau), passerelle OK mais 1.1.1.1 injoignable = probleme cote FAI/box, 1.1.1.1 OK mais site externe injoignable = probleme de resolution DNS specifiquement plutot qu'une panne generale."
                   Confirm = $false
                   Help  = "La logique de ce diagnostic est de tester la chaine de connectivite couche par couche plutot que de se limiter a un seul test 'ca marche / ca marche pas' :`n`n1. Passerelle locale (recuperee automatiquement via la table de routage) : si injoignable, le probleme se situe avant meme de sortir du reseau local - carte reseau, cable, Wifi, ou routeur/box lui-meme eteint ou en panne.`n`n2. 1.1.1.1 (DNS public Cloudflare, teste par IP directe donc sans dependance a la resolution DNS) : si la passerelle repond mais pas cette cible, le probleme se situe typiquement cote fournisseur d'acces (FAI) ou sur la liaison entre la box et internet, pas sur le reseau local.`n`n3. www.microsoft.com (cible externe testee par nom, donc dependante de la resolution DNS) : si 1.1.1.1 repond mais pas cette derniere cible, le probleme est probablement isole a la resolution DNS (serveur DNS configure en panne, filtrage DNS trop agressif, cache corrompu) plutot qu'a la connectivite reseau elle-meme - a rapprocher de 'Cache DNS actuel' et 'Flush DNS' dans ce cas.`n`nUn resultat 'introuvable' pour la passerelle signifie qu'aucune route par defaut n'a ete detectee sur la machine (carte reseau desactivee, aucune interface connectee) - ce n'est pas une erreur de la commande elle-meme." }
                @{ Label = "Connexions TCP avec processus"
                   Cmd   = 'powershell -NoExit -Command Get-NetTCPConnection -State Established,Listen -ErrorAction SilentlyContinue ^| Select-Object LocalAddress,LocalPort,RemoteAddress,RemotePort,State,@{N=''Processus'';E={(Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).ProcessName}},OwningProcess ^| Sort-Object State,Processus ^| Format-Table -AutoSize'
                   Desc  = "Equivalent de 'Connexions actives (netstat)' mais avec le nom du processus deja resolu dans une colonne dediee (Processus), plutot qu'un simple PID a chercher soi-meme dans le Gestionnaire des taches. Limite aux connexions etablies et en ecoute (State Established/Listen), pour eviter le bruit des connexions transitoires (TimeWait, CloseWait) qui encombrent souvent la sortie brute de netstat."
                   Confirm = $false
                   Help  = "Get-NetTCPConnection est le remplacant PowerShell natif de netstat, avec un avantage cle exploite ici : chaque connexion expose directement la propriete OwningProcess (le PID), qu'on peut resoudre en nom de processus lisible via Get-Process dans la meme commande - alors que netstat -ano affiche seulement le PID brut, obligeant a le rechercher separement dans le Gestionnaire des taches ou via une commande a part.`n`nLe filtre sur State Established (connexion active, donnees en cours d'echange) et Listen (port en ecoute, en attente d'une connexion entrante) exclut volontairement les etats transitoires comme TimeWait ou CloseWait, qui representent des connexions en cours de fermeture normale et ajoutent surtout du bruit visuel sans grand interet diagnostique dans la plupart des cas d'usage courants.`n`nUtile pour identifier rapidement quel logiciel a ouvert quel port, en cas de port en conflit, de comportement reseau suspect a investiguer, ou simplement pour verifier concretement ce qui communique sur le reseau a un instant donne." }
                @{ Label = "MTU des interfaces reseau"
                   Cmd   = 'powershell -NoExit -Command Get-NetIPInterface -ErrorAction SilentlyContinue ^| Where-Object ConnectionState -eq ''Connected'' ^| Select-Object InterfaceAlias,AddressFamily,NlMtu,ConnectionState ^| Sort-Object InterfaceAlias ^| Format-Table -AutoSize'
                   Desc  = "Affiche la taille de MTU (Maximum Transmission Unit) actuellement configuree sur chaque interface reseau connectee, en IPv4 et IPv6 separement. Utile pour diagnostiquer des symptomes specifiques comme des pages web qui chargent partiellement, des connexions VPN instables, ou des transferts qui echouent sur de gros paquets alors que les petites requetes passent normalement."
                   Confirm = $false
                   Help  = "Le MTU definit la taille maximale (en octets) qu'un paquet reseau peut atteindre sur une interface donnee avant d'etre fragmente en plusieurs morceaux plus petits. La valeur standard Ethernet est de 1500 - une valeur differente n'est pas automatiquement une anomalie, mais peut le devenir selon le contexte (interfaces VPN, certains adaptateurs virtuels, ou configuration manuelle passee).`n`nCe que ca implique concretement en cas de MTU mal adapte le long du trajet reseau (typiquement plus courant avec un tunnel VPN, qui ajoute son propre overhead d'encapsulation par-dessus les donnees) : les petits paquets (requetes DNS, debut de connexion) passent normalement, mais les gros paquets (chargement d'images, transferts de fichiers, flux video) echouent ou se bloquent partiellement - un symptome caracteristique qui pointe vers ce reglage precis plutot que vers une panne de connectivite generale.`n`nA rapprocher du 'Diagnostic connectivite multi-niveaux' ci-dessus : si ce dernier montre une connectivite fonctionnelle mais que certains usages specifiques (souvent gros volumes de donnees) echouent quand meme, une verification du MTU sur l'interface concernee est une piste pertinente a explorer avant d'aller chercher plus loin." }
            )
        }
        @{
            Name = "Windows Update"
            Commands = @(
                @{ Label = "Reset composants WU"
                   Cmd   = 'net stop wuauserv && net stop bits && ren %windir%\SoftwareDistribution SoftwareDistribution.bak && net start wuauserv && net start bits'
                   Desc  = "ATTENTION : arrete les services Windows Update, renomme le dossier de cache des mises a jour (il sera regenere vide) puis relance les services. Resout la plupart des blocages de Windows Update mais efface l'historique de telechargement en cours."
                   Confirm = $true
                   Help  = "Le dossier SoftwareDistribution est le cache local de Windows Update : les fichiers de mise a jour deja telecharges (partiellement ou completement) et les metadonnees du catalogue. C'est souvent la cause d'un Windows Update bloque ou qui boucle sur une erreur : un fichier corrompu dans ce cache empeche la suite du processus.`n`nCe que fait la commande, etape par etape : arrete les deux services concernes (wuauserv = Windows Update lui-meme, bits = le service de transfert en arriere-plan utilise pour les telechargements), renomme le dossier existant en .bak (il n'est PAS supprime, juste mis de cote), puis relance les services - Windows recree alors automatiquement un dossier SoftwareDistribution vide et repart de zero.`n`nCe que ca implique concretement : toute mise a jour en cours de telechargement doit recommencer entierement depuis le debut (pas de reprise partielle). Les mises a jour DEJA installees ne sont pas affectees. L'ancien dossier .bak reste sur le disque et prend de la place - tu peux le supprimer manuellement plus tard une fois confirme que tout fonctionne a nouveau normalement, sinon il s'accumule au fil des utilisations repetees de cette commande." }
                @{ Label = "Analyser le magasin de composants"
                   Cmd   = 'DISM /Online /Cleanup-Image /AnalyzeComponentStore'
                   Desc  = "Analyse le dossier WinSxS et indique si un nettoyage (StartComponentCleanup) est recommande, avec l'espace recuperable estime."
                   Confirm = $false }
                @{ Label = "Forcer un scan Windows Update"
                   Cmd   = 'UsoClient StartScan'
                   Desc  = "Declenche un scan immediat de disponibilite des mises a jour, sans toucher aux services ni au cache. Plus leger qu'un reset complet."
                   Confirm = $false }
                @{ Label = "Reset Microsoft Store"
                   Cmd   = 'wsreset.exe'
                   Desc  = "Vide le cache du Microsoft Store (aucune fenetre ne s'affiche, l'app se ferme puis se rouvre au bout de quelques secondes). Corrige les blocages de telechargement/mise a jour d'apps Store."
                   Confirm = $false }
                @{ Label = "Dernieres mises a jour installees"
                   Cmd   = 'powershell -NoExit -Command Get-HotFix ^| Sort-Object InstalledOn -Descending ^| Select-Object -First 10 ^| Format-Table -AutoSize'
                   Desc  = "Liste les 10 dernieres mises a jour Windows installees avec leur date. Pratique pour verifier ce qui a change juste avant l'apparition d'un probleme."
                   Confirm = $false }
                @{ Label = "Commande Regedit Windows Update"
                   Cmd   = 'powershell -NoExit -Command $key = ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate''; if (Test-Path $key) { Get-ItemProperty $key ^| Format-List * } else { Write-Host ''Cle de policy Windows Update absente (aucune strategie appliquee).'' -ForegroundColor Yellow }'
                   Desc  = "Affiche toutes les valeurs de registre sous la cle de policy Windows Update, pour verifier qu'une modification (GPO, script, reglage manuel) est bien active. Message clair si la cle n'existe pas sur la machine (aucune strategie appliquee), plutot qu'une erreur bloquante."
                   Confirm = $false }
                @{ Label = "Historique des erreurs Windows Update"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''Microsoft-Windows-WindowsUpdateClient/Operational'';Level=2} -MaxEvents 10 ^| Select-Object TimeCreated,Id,Message ^| Format-List } catch { Write-Host ''Aucune erreur Windows Update trouvee dans le journal.'' -ForegroundColor Green }'
                   Desc  = "Liste les 10 dernieres erreurs (niveau Erreur uniquement) du journal Windows Update, avec leur message complet. Complementaire a 'Dernieres mises a jour installees' : celle-la dit ce qui a reussi, celle-ci dit ce qui a echoue et pourquoi. Message clair si aucune erreur n'est trouvee, plutot qu'une erreur bloquante sur un journal vide."
                   Confirm = $false }
                @{ Label = "Taille du cache SoftwareDistribution"
                   Cmd   = 'powershell -NoExit -Command $dossier = Join-Path $env:windir ''SoftwareDistribution''; if (Test-Path $dossier) { $taille = (Get-ChildItem $dossier -Recurse -Force -ErrorAction SilentlyContinue ^| Measure-Object -Property Length -Sum).Sum; $tailleMo = [math]::Round($taille/1MB,1); Write-Host (''Cache SoftwareDistribution actuel : '' + $tailleMo + '' Mo'') -ForegroundColor Cyan } else { Write-Host ''Dossier SoftwareDistribution introuvable.'' -ForegroundColor Yellow }; $dossierBak = Join-Path $env:windir ''SoftwareDistribution.bak''; if (Test-Path $dossierBak) { $tailleBak = (Get-ChildItem $dossierBak -Recurse -Force -ErrorAction SilentlyContinue ^| Measure-Object -Property Length -Sum).Sum; $tailleBakMo = [math]::Round($tailleBak/1MB,1); Write-Host (''Ancien dossier SoftwareDistribution.bak trouve : '' + $tailleBakMo + '' Mo - laisse par un Reset composants WU precedent, supprimable manuellement si tout fonctionne normalement depuis'') -ForegroundColor Yellow }'
                   Desc  = "Calcule la taille actuelle du dossier cache SoftwareDistribution (fichiers de mise a jour deja telecharges, partiellement ou completement, plus les metadonnees du catalogue) et signale au passage si un ancien dossier .bak existe (laisse par un 'Reset composants WU' precedent). Utile avant de lancer un reset pour savoir combien de telechargement en cours serait perdu, et pour reperer un .bak oublie qui prend de la place inutilement sur le disque."
                   Confirm = $false
                   Help  = "SoftwareDistribution peut legitimement peser plusieurs Go, en particulier juste apres une mise a jour de fonctionnalite majeure (type 24H2) dont les fichiers ne sont pas toujours nettoyes immediatement apres installation. Une taille elevee n'est donc pas forcement le signe d'un probleme a corriger - c'est avant tout une information de contexte avant de decider de lancer 'Reset composants WU' (qui renomme ce dossier et force Windows a tout retelecharger depuis zero au prochain scan).`n`nLe second bloc de cette commande verifie specifiquement l'existence de SoftwareDistribution.bak : ce nom precis est celui que cree 'Reset composants WU' en renommant l'ancien dossier plutot que de le supprimer. Comme ce dossier .bak n'est jamais nettoye automatiquement par la suite (rappel deja present dans le Help de 'Reset composants WU'), il peut s'accumuler silencieusement au fil des utilisations repetees de ce reset si tu ne le supprimes pas manuellement de temps en temps une fois confirme que tout fonctionne normalement." }
                @{ Label = "Redemarrage en attente requis ?"
                   Cmd   = 'powershell -NoExit -Command $motifs = @(); if (Test-Path ''HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending'') { $motifs += ''Composants Windows (CBS) en attente de finalisation'' }; if (Test-Path ''HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired'') { $motifs += ''Windows Update signale un redemarrage requis'' }; $pfro = Get-ItemProperty -Path ''HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager'' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue; if ($pfro -and $pfro.PendingFileRenameOperations) { $motifs += ''Operations de renommage de fichiers en attente (PendingFileRenameOperations)'' }; if ($motifs.Count -gt 0) { Write-Host ''Redemarrage requis : OUI'' -ForegroundColor Red; foreach ($m in $motifs) { Write-Host (''  - '' + $m) -ForegroundColor Yellow } } else { Write-Host ''Redemarrage requis : NON (aucun indicateur de redemarrage en attente detecte)'' -ForegroundColor Green }'
                   Desc  = "Verifie en un coup d'oeil si la machine attend un redemarrage pour finaliser des changements deja appliques, en croisant trois indicateurs distincts : composants Windows (CBS) en attente, Windows Update signalant un redemarrage requis, et operations de renommage de fichiers en attente (PendingFileRenameOperations, utilise aussi par des installeurs classiques). Cas frequent apres un Pack Integrite, du SFC/DISM, ou une installation de mise a jour - repond directement a la question plutot que de redemarrer a l'aveugle pour verifier."
                   Confirm = $false
                   Help  = "Trois emplacements distincts sont verifies, car aucun a lui seul n'est fiable a 100% pour couvrir tous les cas :`n`n1. Component Based Servicing\RebootPending (cle presente ou non, peu importe sa valeur) : signale que le magasin de composants Windows (WinSxS) a des changements qui ne peuvent pas etre finalises sans redemarrage - typiquement apres DISM RestoreHealth ou une mise a jour cumulative.`n`n2. WindowsUpdate\Auto Update\RebootRequired : indicateur pose directement par le service Windows Update lui-meme apres l'installation d'une mise a jour qui necessite un redemarrage pour s'activer completement.`n`n3. PendingFileRenameOperations (Session Manager) : liste des fichiers qu'un installeur n'a pas pu remplacer directement (fichier verrouille en cours d'utilisation) et que Windows renommera/remplacera au prochain demarrage, avant que quoi que ce soit d'autre ne charge. Utilise par de nombreux installeurs classiques, pas seulement Windows Update - une valeur presente ici peut donc aussi venir d'une installation logicielle recente, pas uniquement d'une mise a jour systeme.`n`nSi les trois indicateurs sont negatifs, aucun redemarrage n'est necessaire pour l'instant - mais ca ne garantit pas qu'aucun processus ne tourne encore avec une ancienne version d'un fichier deja remplace sur le disque (un cas plus rare et plus difficile a detecter de maniere generique)." }
            )
        }
        @{
            Name = "Performance"
            Commands = @(
                @{ Label = "Applications au demarrage"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_StartupCommand ^| Select-Object Name,Command,Location ^| Format-Table -AutoSize'
                   Desc  = "Liste les programmes configures pour se lancer automatiquement au demarrage de Windows. Utile pour reperer ce qui ralentit le boot."
                   Confirm = $false }
                @{ Label = "Temps de demarrage detaille"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''Microsoft-Windows-Diagnostics-Performance/Operational'';Id=100} -MaxEvents 5 ^| Select-Object TimeCreated,Message ^| Format-List } catch { Write-Host ''Aucun evenement de temps de demarrage trouve dans le journal.'' -ForegroundColor Yellow }'
                   Desc  = "Affiche la duree detaillee des 5 derniers demarrages Windows via le journal Diagnostics-Performance, complementaire a 'Applications au demarrage' qui liste plutot ce qui se lance. Message clair si le journal ne contient aucun evenement correspondant, plutot qu'une erreur bloquante (meme logique defensive que le fix historique sur Get-PnpDevice)."
                   Confirm = $false }
                @{ Label = "Score global du PC (WinSAT)"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_WinSAT ^| Select-Object CPUScore,D3DScore,DiskScore,GraphicsScore,MemoryScore,WinSPRLevel,@{N=''Etat'';E={switch($_.WinSATAssessmentState){0{''Inconnu''};1{''Valide''};2{''Invalide (materiel modifie)''};3{''Non disponible''};4{''Invalide''};default{''Inconnu''}}}} ^| Format-List'
                   Desc  = "Scores WinSAT par composant (CPU, D3D=3D/gaming, Disque, Graphics=rendu 2D bureau, Memoire) plus le score global WinSPRLevel (= le plus bas des sous-scores, le vrai goulot d'etranglement). Champ 'Etat' traduit en clair : 'Valide' signifie une evaluation a jour et coherente avec le materiel actuel. Sur une config hybride Intel/NVIDIA, un ecart entre D3DScore et GraphicsScore est normal (deux puces graphiques differentes sollicitees). Ne se met a jour automatiquement que rarement (depuis Windows 8.1) - relancer 'winsat formal' manuellement apres un changement materiel majeur si le score semble incoherent ou si Etat n'est pas 'Valide'."
                   Confirm = $false }
                @{ Label = "Erreurs systeme recentes"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''System'';Level=1,2} -MaxEvents 10 ^| Select-Object TimeCreated,Id,LevelDisplayName,ProviderName,Message ^| Format-List } catch { Write-Host ''Aucune erreur/critique recente trouvee dans le journal System.'' -ForegroundColor Green }'
                   Desc  = "Liste les 10 derniers evenements de niveau Critique ou Erreur du journal System. Complement leger et rapide, pas un remplacement d'un outil d'analyse dedie (badges MITRE, detection de pics, filtrage des sources bruyantes connues) si un tel script existe par ailleurs. Message clair si aucun evenement correspondant n'est trouve."
                   Confirm = $false }
                @{ Label = "Applications au demarrage (taches planifiees)"
                   Cmd   = 'powershell -NoExit -Command Get-ScheduledTask ^| Where-Object { $_.State -eq ''Ready'' -and $_.Triggers.CimClass.CimClassName -contains ''MSFT_TaskLogonTrigger'' } ^| Select-Object TaskName,TaskPath ^| Format-Table -AutoSize'
                   Desc  = "Liste les taches planifiees configurees pour se lancer a la connexion. Complementaire a 'Applications au demarrage' (qui ne couvre que le dossier Demarrage et les cles Run du registre) : beaucoup de logiciels (mises a jour, agents divers) utilisent plutot une tache planifiee, un angle mort courant si on ne regarde que l'un ou l'autre."
                   Confirm = $false }
                @{ Label = "Taches planifiees actives (hors demarrage)"
                   Cmd   = 'powershell -NoExit -Command try { $taches = Get-ScheduledTask -ErrorAction Stop ^| Where-Object { $_.State -eq ''Ready'' -and $_.TaskPath -notlike ''\Microsoft\Windows\*'' -and $_.Triggers.CimClass.CimClassName -notcontains ''MSFT_TaskLogonTrigger'' }; if ($taches) { $taches ^| Select-Object TaskName,TaskPath,@{N=''ProchainDeclenchement'';E={(Get-ScheduledTaskInfo -TaskName $_.TaskName -TaskPath $_.TaskPath -ErrorAction SilentlyContinue).NextRunTime}} ^| Sort-Object TaskPath ^| Format-Table -AutoSize -Wrap } else { Write-Host ''Aucune tache planifiee active hors demarrage et hors taches internes Microsoft.'' -ForegroundColor Green } } catch { Write-Host ''Impossible de recuperer la liste des taches planifiees.'' -ForegroundColor Red }'
                   Desc  = "Liste les taches planifiees actuellement actives (etat Ready) qui ne se declenchent PAS a la connexion (deja couvertes par 'Applications au demarrage (taches planifiees)' juste au-dessus) et qui ne font pas partie des taches internes Microsoft (dossier Microsoft\Windows, plusieurs centaines par defaut sur toute installation Windows standard, exclues pour eviter le bruit). Ne restent que les taches tierces sur declencheur horaire, quotidien ou evenementiel - typiquement installees par des logiciels (mises a jour automatiques, agents de synchronisation, telemetrie tierce) et potentiellement oubliees avec le temps."
                   Confirm = $false
                   Help  = "Une installation Windows standard contient plusieurs centaines de taches planifiees internes sous Microsoft\Windows (maintenance, diagnostics, telemetrie systeme...) qui sont normales et ne doivent pas etre modifiees - elles sont exclues d'office de cette commande pour ne montrer que ce qui a ete ajoute par des logiciels tiers ou l'utilisateur.`n`nCette commande exclut egalement les taches declenchees a la connexion (deja couvertes par 'Applications au demarrage (taches planifiees)'), pour se concentrer specifiquement sur les taches qui s'executent independamment d'une session ouverte : sur un horaire fixe (quotidien, hebdomadaire...), au demarrage du systeme lui-meme (pas a la connexion utilisateur), sur un evenement systeme precis, ou en tache de fond periodique. Ce sont souvent les moins visibles au quotidien puisqu'elles ne generent ni icone dans la barre des taches ni fenetre au demarrage de session.`n`nLa colonne ProchainDeclenchement indique quand la tache doit s'executer la prochaine fois - une valeur vide ou tres eloignee dans le temps peut indiquer une tache desactivee au niveau de son declencheur (differemment de l'etat Ready global de la tache elle-meme) ou un declencheur mal configure.`n`nA croiser avec le Planificateur de taches (taskschd.msc) pour desactiver ou supprimer une tache identifiee comme inutile - cette commande est en lecture seule et ne modifie rien." }
                @{ Label = "Etat virtualisation materielle (Hyperviseur / VBS)"
                   Cmd   = 'powershell -NoExit -Command $hv = if ((Get-CimInstance Win32_ComputerSystem).HypervisorPresent) { ''Oui'' } else { ''Non'' }; Write-Host (''Hyperviseur present : '' + $hv) -ForegroundColor Green; try { $dg = Get-CimInstance -Namespace ''root\Microsoft\Windows\DeviceGuard'' -ClassName Win32_DeviceGuard -ErrorAction Stop; Write-Host (''VirtualizationBasedSecurityStatus (VBS) : '' + $dg.VirtualizationBasedSecurityStatus + '' (0=VBS desactive, 1=configure mais pas demarre, 2=actif)'') -ForegroundColor Green; Write-Host (''SecurityServicesConfigured : '' + ($dg.SecurityServicesConfigured -join '', '') + '' (0=aucun, 1=Credential Guard, 2=HVCI/integrite memoire, 3=System Guard, 4=SMM Firmware Measurement)'') -ForegroundColor Green; Write-Host (''SecurityServicesRunning : '' + ($dg.SecurityServicesRunning -join '', '') + '' (0=aucun, 1=Credential Guard, 2=HVCI/integrite memoire, 3=System Guard, 4=SMM Firmware Measurement)'') -ForegroundColor Green } catch { Write-Host ''Info VBS (Device Guard) non disponible sur cette edition/version de Windows.'' -ForegroundColor Yellow }'
                   Desc  = "Indique si un hyperviseur (Hyper-V, VBS...) tourne actuellement (Oui/Non), l'etat natif de VirtualizationBasedSecurityStatus (VBS) avec sa legende, et le detail des services de securite configures et actifs par-dessus (Credential Guard, HVCI, System Guard...). Important : VirtualizationBasedSecurityStatus=2 confirme seulement que la couche VBS de base tourne, pas que HVCI (valeur 2 dans SecurityServicesRunning) en fait partie - les deux sont independants, la premiere est un niveau (0/1/2), les deux autres sont des listes d'identifiants de services distincts (pas une echelle). System Guard Secure Launch (valeur 3) peut etre absent sur du materiel avec un firmware anterieur a 2019 (echec typique de liaison PCR 7), meme si VBS et HVCI eux-memes peuvent tourner normalement. Message clair si la classe DeviceGuard n'existe pas sur cette edition de Windows, plutot qu'une erreur bloquante."
                   Confirm = $false
                   Help  = "SecurityServicesConfigured / SecurityServicesRunning ne sont PAS une echelle de niveau : chaque numero designe un service DIFFERENT, plusieurs peuvent apparaitre en meme temps (ex: '1, 2' = Credential Guard ET HVCI actifs ensemble).`n`n1 = Credential Guard`nIsole le processus qui gere les identifiants Windows (mots de passe en cache, tickets Kerberos) dans un conteneur virtualise separe. Protege contre le vol d'identifiants (pass-the-hash). Cible surtout les machines jointes a un domaine d'entreprise - peu utile en usage personnel.`n`n2 = HVCI / Integrite de la memoire`nVerifie que le code execute en mode noyau est signe et non modifie. Bloque l'injection de code malveillant via un pilote compromis.`n`n3 = System Guard Secure Launch`nVerifie cryptographiquement, via le TPM et une mesure materielle du demarrage (DRTM), que le firmware n'a pas ete altere avant meme que VBS ne demarre. Peut etre absent sur du materiel avec un firmware anterieur a 2019 (echec typique de liaison PCR 7), independamment de l'etat de VBS/HVCI.`n`n4 = SMM Firmware Measurement`nSurveille le SMM (System Management Mode), un mode CPU ultra-privilegie utilise par le firmware, historiquement cible par des rootkits tres furtifs. Plutot oriente entreprise/materiel certifie." }
                @{ Label = "Desactiver Memory Integrity (HVCI)"
                   Cmd   = 'reg add HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity /v Enabled /t REG_DWORD /d 0 /f'
                   Desc  = "ATTENTION : desactive Memory Integrity (HVCI), la protection qui isole le noyau Windows contre les rootkits/malwares bas niveau. Meme bascule que Windows Security > Securite de l'appareil > Isolation du noyau > Integrite de la memoire, via le registre. NECESSITE UN REDEMARRAGE pour prendre effet - rien ne change avant le prochain reboot. But : recuperer les quelques pourcents de FPS perdus (environ 8% de moyenne mesuree sur du materiel recent, variable selon le jeu) sur du jeu solo sans anti-triche qui exige HVCI actif. Reactivable avec 'Reactiver Memory Integrity (HVCI)' juste en dessous. N'affecte pas VBS dans son ensemble : Credential Guard et les autres services restent inchanges."
                   Confirm = $true
                   Help  = "Mecanisme precis : HVCI s'appuie sur l'hyperviseur pour empecher qu'une meme page de memoire soit a la fois modifiable ET executable en meme temps - une technique qui bloque une large classe d'exploits cherchant a injecter du code malveillant directement dans le noyau Windows via un pilote vulnerable ou compromis.`n`nCe que ca engendre concretement en le desactivant : le noyau redevient protege uniquement par les mecanismes plus anciens (signature de pilotes classique, sans la verification renforcee par l'hyperviseur). Le risque reel reste mesure : ca ne rend pas la machine vulnerable en soi, ca retire une couche de defense en profondeur specifiquement efficace contre les attaques niveau noyau - qui restent rares en usage personnel compare a du phishing ou des malwares classiques deja bloques par Defender.`n`nLa cle de registre ne prend effet qu'au prochain redemarrage - lancer cette commande seule, sans redemarrer, ne change rien immediatement. Le catalogue contient 'Reactiver Memory Integrity (HVCI)' juste en dessous pour revenir en arriere, avec le meme besoin de redemarrage." }
                @{ Label = "Reactiver Memory Integrity (HVCI)"
                   Cmd   = 'reg add HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity /v Enabled /t REG_DWORD /d 1 /f'
                   Desc  = "Reactive Memory Integrity (HVCI) apres un test de performance gaming, restaurant la protection contre les rootkits/malwares bas niveau. NECESSITE UN REDEMARRAGE pour prendre effet. A lancer une fois le test de FPS termine, pour ne pas laisser la machine sans cette protection plus longtemps que necessaire."
                   Confirm = $true
                   Help  = "Remet la meme cle de registre a sa valeur active (Enabled=1). Comme pour la desactivation, rien ne change avant le prochain redemarrage - la protection reste absente jusque-la, meme apres avoir lance cette commande. Sans effet secondaire ni perte de donnees : c'est une bascule reversible a l'identique, pas une reinstallation ou une reparation." }
                @{ Label = "Desactiver VBS (Virtualization-Based Security)"
                   Cmd   = 'reg add HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard /v EnableVirtualizationBasedSecurity /t REG_DWORD /d 0 /f'
                   Desc  = "ATTENTION : desactive VBS dans son ensemble (la couche hyperviseur de base sur laquelle HVCI et les autres services de securite reposent), pas juste HVCI seul. Ca revient a empecher l'hyperviseur de se charger au demarrage (aucun gain supplementaire a couper l'hyperviseur separement via bcdedit). NECESSITE UN REDEMARRAGE pour prendre effet. Casse ou desactive Hyper-V, WSL2, l'acceleration VMware/VirtualBox, les emulateurs Android et Docker Desktop si ces outils sont utilises sur la machine. Gain potentiel plus large que HVCI seul (jusqu'a 15% mesure sur certaines taches selon Tom's Hardware), mais une bonne partie de cet ecart est deja capturee par la desactivation de HVCI seule - teste et compare avant de conclure a un vrai gain supplementaire. Reactivable avec 'Reactiver VBS' juste en dessous."
                   Confirm = $true
                   Help  = "Mecanisme precis : cette cle coupe la couche hyperviseur elle-meme (basee sur les extensions VT-x du CPU), le socle sur lequel VBS et donc HVCI reposent tous les deux. Sans cette fondation, aucun service de securite qui en depend ne peut fonctionner, quel que soit son propre reglage individuel.`n`nCe que ca engendre concretement, au-dela de HVCI : contrairement a la desactivation de HVCI seul (qui ne touche qu'un service precis), celle-ci retire la possibilite meme d'utiliser Hyper-V, WSL2, l'acceleration materielle de VMware/VirtualBox, les emulateurs Android (type BlueStacks en mode hardware) ou Docker Desktop - ces outils ont besoin de l'hyperviseur pour fonctionner et refuseraient simplement de demarrer tant que VBS est coupe. Verifie si l'un de ces usages est actif sur la machine avant de desactiver.`n`nPoint de vigilance trouve dans des retours d'autres utilisateurs (pas garanti sur toutes les machines) : sur certaines configurations, ce reglage se reactive tout seul apres redemarrage a cause d'une politique de groupe ou d'un verrouillage constructeur - plus frequent sur une machine jointe a un domaine d'entreprise. Si le reglage ne 'tient' pas apres redemarrage, ce serait le signal a creuser plutot qu'un signe que la commande a echoue." }
                @{ Label = "Reactiver VBS (Virtualization-Based Security)"
                   Cmd   = 'reg add HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard /v EnableVirtualizationBasedSecurity /t REG_DWORD /d 1 /f'
                   Desc  = "Reactive VBS dans son ensemble apres un test de performance gaming, restaurant la fondation sur laquelle HVCI et les autres protections reposent. NECESSITE UN REDEMARRAGE pour prendre effet. Si HVCI etait actif avant la desactivation de VBS, il redevient actif automatiquement (sa propre cle de registre n'est pas touchee par cette commande)."
                   Confirm = $true
                   Help  = "Remet la cle EnableVirtualizationBasedSecurity a 1, restaurant l'hyperviseur et donc la possibilite pour VBS/HVCI de fonctionner a nouveau. Comme pour HVCI seul, aucun effet avant le prochain redemarrage. Puisque la cle HVCI elle-meme (Scenarios\\HypervisorEnforcedCodeIntegrity) n'est pas touchee par cette commande, l'etat d'avant (actif ou non) revient automatiquement une fois VBS de nouveau disponible - pas besoin de relancer 'Reactiver Memory Integrity (HVCI)' separement si tu ne l'avais pas explicitement desactive de son cote." }
                @{ Label = "Top processus RAM"
                   Cmd   = 'powershell -NoExit -Command Get-Process ^| Sort-Object WorkingSet64 -Descending ^| Select-Object -First 15 Name,Id,@{N=''RAM_Mo'';E={[math]::Round($_.WorkingSet64/1MB,1)}} ^| Format-Table -AutoSize'
                   Desc  = "Liste les 15 processus consommant le plus de RAM (Working Set, en Mo), tries par ordre decroissant. Diagnostic rapide en cas de ralentissement ou de saturation memoire, sans passer par le Gestionnaire des taches."
                   Confirm = $false
                   Help  = "Le Working Set (WorkingSet64) mesure la memoire physique reellement occupee par le processus a l'instant present, pas la memoire virtuelle allouee (souvent bien plus large et peu representative de l'usage reel) ni la memoire partagee comptee plusieurs fois entre plusieurs processus. C'est la meme metrique que la colonne 'Memoire' par defaut du Gestionnaire des taches. Un processus presentant un Working Set anormalement eleve et croissant d'une execution a l'autre de cette commande est un candidat a surveiller pour une fuite memoire." }
                @{ Label = "Top processus CPU"
                   Cmd   = 'powershell -NoExit -Command $cores = [Environment]::ProcessorCount; $avant = Get-Process ^| Select-Object Id,ProcessName,CPU; Write-Host ''Mesure en cours (echantillon sur 1 seconde)...'' -ForegroundColor Cyan; Start-Sleep -Seconds 1; $apres = Get-Process ^| Select-Object Id,ProcessName,CPU; $resultats = foreach ($p in $apres) { $prec = $avant ^| Where-Object { $_.Id -eq $p.Id }; if ($prec -and $p.CPU -and $prec.CPU) { $delta = $p.CPU - $prec.CPU; $pct = [math]::Round(($delta / $cores) * 100, 1); [PSCustomObject]@{ Nom = $p.ProcessName; PID = $p.Id; CPU_Pourcent = $pct } } }; $resultats ^| Sort-Object CPU_Pourcent -Descending ^| Select-Object -First 15 ^| Format-Table -AutoSize'
                   Desc  = "Liste les 15 processus consommant le plus de CPU, en pourcentage instantane mesure sur un echantillon d'une seconde (et non le temps CPU cumule depuis le demarrage du processus, qui serait trompeur). Diagnostic rapide en cas de ventilateurs qui s'emballent ou de machine qui rame, sans passer par le Gestionnaire des taches."
                   Confirm = $false
                   Help  = "La propriete .CPU native de Get-Process n'est PAS un pourcentage instantane : c'est le temps processeur cumule (en secondes) consomme par le processus depuis son demarrage, une valeur qui ne fait qu'augmenter et qui devient de moins en moins representative de l'activite actuelle a mesure que le processus vieillit (un processus lance il y a 3 jours peut afficher un CPU cumule enorme sans etre actif la maintenant).`n`nCette commande contourne le probleme en prenant deux mesures espacees d'une seconde, puis en calculant le delta de temps CPU consomme pendant cet intervalle, divise par le nombre de coeurs logiques (via [Environment]::ProcessorCount) pour ramener le resultat a une echelle de 0-100% comparable a celle du Gestionnaire des taches - plutot que 0-800% sur une machine a 8 coeurs si tous tournaient a fond simultanement sur le meme processus.`n`nUn processus present uniquement dans le second echantillon (lance pendant la seconde d'attente) ou disparu entre les deux (ferme entre-temps) est silencieusement exclu du resultat plutot que de faire planter la commande - la correspondance entre les deux echantillons se fait par identifiant de processus (Id), absente dans ce cas precis." }
                @{ Label = "Processus par handles/threads"
                   Cmd   = 'powershell -NoExit -Command Get-Process ^| Sort-Object HandleCount -Descending ^| Select-Object -First 15 Name,Id,HandleCount,@{N=''Threads'';E={$_.Threads.Count}} ^| Format-Table -AutoSize'
                   Desc  = "Liste les 15 processus avec le plus grand nombre de handles systeme ouverts (fichiers, cles de registre, evenements...) et de threads actifs, tries par nombre de handles decroissant. Angle de diagnostic distinct de Top processus RAM/CPU : un nombre de handles ou de threads qui grimpe en continu au fil du temps est un signe classique de fuite de ressources, meme quand la consommation memoire immediate parait encore normale."
                   Confirm = $false
                   Help  = "Chaque fichier ouvert, cle de registre consultee, evenement systeme cree ou objet de synchronisation utilise par un processus consomme un handle - une reference geree par le noyau Windows. Un processus sain ouvre et ferme ses handles au fil de son execution, maintenant un nombre globalement stable dans le temps. Un processus dont le nombre de handles augmente de facon continue et ne redescend jamais (meme apres inactivite) indique typiquement un bug de fuite de ressources dans le code de l'application - le processus ne libere jamais ce qu'il ouvre - qui finit par degrader les performances generales voire provoquer un plantage une fois une limite systeme atteinte, souvent bien avant qu'un probleme de RAM ne devienne visible dans Top processus RAM.`n`nMeme logique pour le nombre de threads : une valeur elevee et croissante sans rapport avec la charge de travail reelle du processus (au repos, sans activite utilisateur) est un signal similaire.`n`nCette commande ne donne qu'un instantane a un moment donne - pour reellement detecter une fuite, il faut comparer les valeurs d'un meme processus entre deux executions espacees de plusieurs heures ou jours, plutot que de juger sur une seule lecture." }
                @{ Label = "Verification service WSearch"
                   Cmd   = 'powershell -NoExit -Command Get-Service WSearch ^| Select-Object Name,Status,StartType ^| Format-Table -AutoSize'
                   Desc  = "Verifie l'etat du service Windows Search (indexation), qui permet une recherche rapide dans le menu Demarrer et l'Explorateur de fichiers. Ni un enjeu de securite ni de vie privee - un compromis performance pur, distinct des services de telemetrie regroupes dans la categorie Confidentialite / Telemetrie."
                   Confirm = $false }
                @{ Label = "Desactiver WSearch (indexation)"
                   Cmd   = 'powershell -NoExit -Command try { Stop-Service -Name WSearch -Force -ErrorAction Stop; Set-Service -Name WSearch -StartupType Disabled -ErrorAction Stop; Write-Host ''WSearch : desactive'' -ForegroundColor Green } catch { Write-Host (''WSearch : echec - '' + $_.Exception.Message) -ForegroundColor Red }'
                   Desc  = "ATTENTION : arrete et desactive le service d'indexation Windows Search. Libere un peu de CPU/disque en arriere-plan (l'indexation continue tourne perpetuellement pour rester a jour), mais au prix d'une recherche de fichiers beaucoup plus lente dans le menu Demarrer et l'Explorateur (recherche brute au lieu d'un index pre-construit). A reserver a une machine ou la reactivite de recherche importe peu, ou en test de diagnostic performance temporaire."
                   Confirm = $true
                   Help  = "Windows Search maintient en permanence un index du contenu du disque (noms de fichiers, et pour certains types, leur contenu textuel) pour rendre la recherche quasi instantanee dans le menu Demarrer et l'Explorateur - ce processus d'indexation continu consomme un peu de CPU et d'I/O disque en arriere-plan, particulierement notable juste apres l'ajout ou la modification d'un grand nombre de fichiers.`n`nDesactiver ce service ne touche a aucun aspect de securite ou de confidentialite : c'est un compromis purement performance, a l'oppose des services regroupes dans la categorie Confidentialite / Telemetrie qui reduisent l'envoi de donnees a Microsoft sans contrepartie fonctionnelle. Une fois desactive, la recherche fonctionne toujours mais parcourt les fichiers directement a chaque recherche (beaucoup plus lente, surtout sur un grand nombre de fichiers ou un disque mecanique).`n`nPour reactiver : Set-Service -Name WSearch -StartupType Automatic puis Start-Service -Name WSearch (la reconstruction de l'index prend ensuite du temps en arriere-plan avant que la recherche redevienne rapide)." }
            )
        }
        @{
            Name = "Pilotes / Materiel"
            Commands = @(
                @{ Label = "Peripheriques en erreur"
                   Cmd   = 'powershell -NoExit -Command $err = Get-PnpDevice ^| Where-Object Status -eq ''Error''; if ($err) { $err ^| Format-Table -AutoSize } else { Write-Host ''Aucun peripherique en erreur detecte.'' -ForegroundColor Green }'
                   Desc  = "Liste les peripheriques signales en erreur dans le Gestionnaire de peripheriques (pilote manquant ou defaillant). Diagnostic rapide, sans lancer un audit complet des pilotes. Affiche un message si aucun n'est en erreur (au lieu de planter, comportement connu de -Status Error sur un resultat vide)."
                   Confirm = $false }
                @{ Label = "Etat GPU NVIDIA (nvidia-smi)"
                   Cmd   = 'powershell -NoExit -Command if (Get-Command nvidia-smi -ErrorAction SilentlyContinue) { nvidia-smi } else { Write-Host ''nvidia-smi introuvable : aucun GPU NVIDIA detecte ou pilote NVIDIA non installe sur cette machine.'' -ForegroundColor Yellow }'
                   Desc  = "Affiche l'etat du GPU NVIDIA : temperature, utilisation, memoire VRAM utilisee, version du pilote. Ne s'applique qu'aux machines avec un GPU NVIDIA et son pilote installe (nvidia-smi dans le PATH) - message clair sinon, plutot qu'une erreur brute de commande introuvable."
                   Confirm = $false }
                @{ Label = "GPU detectes"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_VideoController ^| Select-Object Name,DriverVersion,AdapterRAM ^| Format-Table -AutoSize'
                   Desc  = "Liste tous les GPU detectes par Windows, quel que soit le fabricant (Intel, AMD, NVIDIA) - utile en particulier sur une config hybride avec plusieurs puces graphiques (iGPU + carte dediee) pour voir lesquelles sont exposees. Attention : AdapterRAM est un champ WMI limite a 32 bits, qui peut afficher une valeur incorrecte ou negative sur une carte avec 4 Go de VRAM ou plus (limitation connue, pas un bug de cette commande) - pour la VRAM reelle d'une carte NVIDIA, se fier plutot a 'Etat GPU NVIDIA (nvidia-smi)' ci-dessus."
                   Confirm = $false }
                @{ Label = "Info BIOS / carte mere"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_BIOS ^| Select-Object Manufacturer,SMBIOSBIOSVersion,ReleaseDate ^| Format-List'
                   Desc  = "Affiche le fabricant, la version et la date de sortie du BIOS/UEFI actuellement installe. Pratique pour verifier rapidement avant de comparer avec la derniere version disponible sur le site du fabricant."
                   Confirm = $false }
                @{ Label = "RAM installee (barrettes)"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_PhysicalMemory ^| Select-Object Manufacturer,@{N=''Capacite(Go)'';E={[math]::Round($_.Capacity/1GB,1)}},Speed,DeviceLocator ^| Format-Table -AutoSize'
                   Desc  = "Liste chaque barrette de RAM installee avec sa capacite (convertie en Go, pas en octets bruts), sa frequence reelle (MHz) et son slot (DeviceLocator). Utile pour verifier combien de slots sont occupes et si la frequence reelle correspond a ce qui est attendu (parfois inferieure au XMP/JEDEC max sans profil active)."
                   Confirm = $false }
                @{ Label = "Pilotes recemment installes"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_PnPSignedDriver ^| Where-Object { $_.DriverDate } ^| Sort-Object DriverDate -Descending ^| Select-Object -First 15 DeviceName,DriverVersion,DriverDate ^| Format-Table -AutoSize'
                   Desc  = "Liste les 15 pilotes les plus recemment installes, tries par date. Complementaire a 'Peripheriques en erreur' : celle-ci dit ce qui ne va pas maintenant, celle-la aide a corriger un probleme recent avec une mise a jour de pilote qui vient de se produire."
                   Confirm = $false }
                @{ Label = "Peripheriques USB connectes"
                   Cmd   = 'powershell -NoExit -Command Get-PnpDevice -PresentOnly ^| Where-Object { $_.InstanceId -like ''USB\*'' } ^| Select-Object FriendlyName,Status,Class ^| Sort-Object Class ^| Format-Table -AutoSize'
                   Desc  = "Liste tout ce qui est actuellement connecte sur le bus USB (filtre sur l'InstanceId, pas seulement la classe 'USB'), donc inclut aussi bien les hubs que les souris, claviers ou disques externes branches en USB - contrairement a un filtre par Class qui manquerait la plupart des peripheriques USB reels."
                   Confirm = $false }
                @{ Label = "Peripheriques audio"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_SoundDevice ^| Select-Object Name,Manufacturer,Status ^| Format-Table -AutoSize'
                   Desc  = "Liste les peripheriques audio detectes (carte son integree, casque/DAC USB, etc.) avec leur statut. Rien d'autre dans le catalogue ne couvrait l'audio jusqu'ici, alors que les soucis de pilote son sont frequents."
                   Confirm = $false }
                @{ Label = "Resolution et frequence d'affichage actuelles"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_VideoController ^| Where-Object { $_.CurrentHorizontalResolution } ^| Select-Object Name,CurrentHorizontalResolution,CurrentVerticalResolution,CurrentRefreshRate ^| Format-Table -AutoSize'
                   Desc  = "Affiche la resolution et le taux de rafraichissement actuellement utilises. Le filtre ne garde que le controleur graphique reellement actif (sur une config avec plusieurs GPU, celui qui n'est pas sollicite pour l'affichage renvoie des valeurs vides et disparait naturellement du resultat). Reflete le mode actif au niveau GPU, pas necessairement un detail distinct par ecran sur une config multi-moniteurs."
                   Confirm = $false }
                @{ Label = "Export des pilotes installes"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Exporte l'ensemble des pilotes tiers actuellement installes (hors pilotes Windows natifs) vers un dossier horodate sous Desktop\Rapports_Maintenance\Export_Pilotes\, accompagne d'un manifeste (Manifeste_Pilotes.txt/.csv) qui associe chaque dossier - nomme d'apres son fichier .inf technique, generalement pas reconnaissable - a son vrai fabricant et sa categorie reelle. Utile en sauvegarde preventive avant une reinstallation de Windows ou un changement de materiel majeur (carte mere, GPU...). Necessite generalement des droits administrateur."
                   Confirm = $false
                   Help  = "Export-WindowsDriver copie, pour chaque pilote tiers installe et signe (hors pilotes fournis nativement par Windows), l'ensemble de ses fichiers (.inf, .sys, .cat, .dll associes) dans un sous-dossier dedie du dossier de destination - un backup complet et directement reinstallable via 'pnputil /add-driver *.inf /subdirs /install', sans redependre de Windows Update ou du site du fabricant pour les retrouver.`n`nCe que ca N'inclut PAS : les pilotes integres a Windows lui-meme (stockes dans le magasin de pilotes mais jamais installes separement en tant que paquet tiers), et les applications associees a un pilote (par exemple un logiciel de gestion GPU du type NVIDIA App, AMD Software ou Intel Graphics Command Center n'est pas exporte, seul le pilote proprement dit l'est).`n`nPOURQUOI LES NOMS DE DOSSIERS SONT CRYPTIQUES : chaque sous-dossier est nomme d'apres le fichier .inf d'origine du paquet pilote (ex: 'acer_s271hl.inf_amd64_f829e28ddd19503b'), tel qu'il a ete soumis a Windows Update ou par le fabricant - un nom technique interne, pas le nom commercial du materiel. Il est tout a fait normal de ne reconnaitre aucun de ces noms au premier coup d'oeil, meme sur une machine d'un seul fabricant : de nombreux pilotes (USB generique, chipset, composants partages) sont certifies sous un paquet dont le nom ne correspond ni au fabricant de la machine ni au peripherique concerne.`n`nC'est pourquoi cette commande genere en plus un manifeste (Manifeste_Pilotes.txt et .csv, dans le meme dossier que l'export) qui interroge Get-WindowsDriver pour associer chaque dossier a son vrai fabricant (ProviderName), sa categorie (ClassName, ex: Monitor/USB/System/MEDIA) et sa version - de quoi identifier chaque dossier sans avoir a ouvrir manuellement chaque .inf pour en lire le contenu. Une ligne 'Inconnu' dans le manifeste signifie que la correspondance n'a pas pu etre etablie automatiquement (rare, generalement du a un renommage entre l'export et l'interrogation du magasin) - le dossier reste neanmoins valide et reinstallable, seule l'identification a echoue.`n`nUn nouveau sous-dossier horodate (format AAAAMMJJ_HHMMSS) est cree a chaque execution plutot que d'ecraser le precedent, pour conserver plusieurs points de sauvegarde dans le temps si besoin - a nettoyer manuellement dans Rapports_Maintenance\\Export_Pilotes\\ si l'accumulation devient genante avec le temps.`n`nSi la commande echoue avec un message lie aux droits/acces refuse, c'est le cas le plus frequent : Export-WindowsDriver necessite une session PowerShell elevee (administrateur) pour lire integralement le magasin de pilotes." }
                @{ Label = "Peripheriques desactives manuellement"
                   Cmd   = 'powershell -NoExit -Command $disabled = Get-CimInstance Win32_PnPEntity ^| Where-Object { $_.ConfigManagerErrorCode -eq 22 }; if ($disabled) { $disabled ^| Select-Object Name,DeviceID ^| Format-Table -AutoSize } else { Write-Host ''Aucun peripherique desactive manuellement detecte.'' -ForegroundColor Green }'
                   Desc  = "Liste les peripheriques desactives volontairement dans le Gestionnaire de peripheriques (code d'erreur 22 = CM_PROB_DISABLED), distinct des peripheriques reellement en panne ou avec un pilote manquant deja couverts par 'Peripheriques en erreur'. Evite de confondre une desactivation intentionnelle (webcam, Bluetooth inutilise, etc.) avec un vrai probleme materiel."
                   Confirm = $false
                   Help  = "Le champ Status de Get-PnpDevice (utilise par 'Peripheriques en erreur' juste au-dessus) regroupe sous la seule valeur 'Error' plusieurs situations tres differentes : un pilote reellement manquant ou en echec, ET un peripherique simplement desactive a la main - ce qui peut faire remonter une fausse alerte alors que tout est parfaitement normal.`n`nCette commande interroge directement la classe CIM Win32_PnPEntity et son champ ConfigManagerErrorCode, plus precis que le Status simplifie de Get-PnpDevice : le code 22 signifie specifiquement 'CM_PROB_DISABLED' (peripherique desactive intentionnellement), a distinguer d'autres codes comme 28 (pilote non installe) ou 31 (pilote charge mais peripherique refusant de demarrer) qui restent couverts par 'Peripheriques en erreur'.`n`nUtile typiquement apres avoir desactive volontairement une webcam, une carte reseau secondaire ou un Bluetooth inutilise via le Gestionnaire de peripheriques : cette commande confirme que c'est bien une desactivation volontaire enregistree, sans la confondre avec une panne reelle." }
                @{ Label = "Peripheriques sur pilote Microsoft"
                   Cmd   = 'powershell -NoExit -Command try { $classes = @(''Display'',''Net'',''MEDIA'',''HDC'',''SCSIAdapter''); $exclusions = ''WAN Miniport^|Wi-Fi Direct Virtual Adapter^|Kernel Debug Network Adapter^|Storage Spaces Controller^|Streaming Service Proxy^|ISATAP Adapter^|Teredo Tunneling^|6to4 Adapter^|RAS Async Adapter^|Hyper-V Virtual^|Virtual WiFi Miniport^|Bluetooth Device \(Personal Area Network\)''; $drivers = Get-CimInstance Win32_PnPSignedDriver -ErrorAction Stop ^| Where-Object { $_.DriverProviderName -eq ''Microsoft'' -and $classes -contains $_.DeviceClass -and $_.DeviceName -notmatch $exclusions }; if ($drivers) { $drivers ^| Select-Object DeviceName,DeviceClass,DriverVersion ^| Format-Table -AutoSize -Wrap } else { Write-Host ''Aucun peripherique physique (graphique, reseau, audio, stockage) ne tourne sur un pilote Microsoft generique - tous utilisent un pilote constructeur specifique.'' -ForegroundColor Green } } catch { Write-Host ''Impossible d interroger Win32_PnPSignedDriver.'' -ForegroundColor Red }'
                   Desc  = "Recherche les peripheriques PHYSIQUES graphiques, reseau, audio ou de stockage (classes Display/Net/MEDIA/HDC/SCSIAdapter) qui tournent actuellement sur un pilote fourni par Microsoft plutot que par le constructeur du materiel. Les adaptateurs virtuels systeme (WAN Miniport pour VPN, Wi-Fi Direct, Storage Spaces, etc.) sont exclus du resultat : ils sont Microsoft par nature et n'ont jamais de pilote constructeur, leur presence serait juste du bruit sans valeur diagnostique. Signal different de 'Peripheriques en erreur' : le materiel fonctionne, mais potentiellement en mode degrade (fonctionnalites reduites, performances moindres) faute du pilote specifique installe."
                   Confirm = $false
                   Help  = "Chaque pilote installe declare un fournisseur (DriverProviderName) dans ses metadonnees - generalement le nom du constructeur (NVIDIA, Realtek, Intel...) pour un pilote specifique au materiel, ou Microsoft pour les pilotes generiques integres nativement a Windows (utilises par defaut quand aucun pilote specifique n'est installe, ou temporairement juste apres une reinstallation de Windows avant l'installation manuelle des pilotes constructeur).`n`nCette commande cible volontairement les classes de materiel ou un pilote constructeur specifique apporte generalement un reel benefice fonctionnel (Display = carte graphique, Net = reseau, MEDIA = audio, HDC/SCSIAdapter = controleurs de stockage) plutot que la totalite des peripheriques - une souris ou un clavier fonctionnant sur pilote Microsoft generique est parfaitement normal et n'apporte aucune limitation, contrairement a une carte graphique qui perdrait alors l'acceleration 3D complete, le controle des ventilateurs, l'overclocking, etc.`n`nUne liste d'exclusion filtre en plus les adaptateurs et controleurs purement virtuels que Windows cree lui-meme et qui n'ont, par construction, jamais de pilote constructeur a installer : les WAN Miniport (piles de protocoles VPN/dial-up virtuelles), l'adaptateur Wi-Fi Direct, l'adaptateur de debogage noyau, le controleur Storage Spaces, le proxy de service de streaming, et les tunnels IPv6 (ISATAP, Teredo, 6to4). Sans ce filtre, ces peripheriques systeme normaux et omnipresents auraient noye tout signal reellement utile sous une longue liste sans interet diagnostique.`n`nNuance importante : la presence de Microsoft ici n'est pas automatiquement un probleme a corriger. Certains peripheriques, notamment certains controleurs de stockage AHCI/NVMe standards, sont volontairement geres par le pilote generique Microsoft meme sur une installation saine, ce pilote etant parfaitement suffisant et parfois plus stable que certaines alternatives constructeur. C'est surtout pertinent a verifier pour le GPU (a croiser avec 'Etat GPU NVIDIA (nvidia-smi)' ou 'GPU detectes' plus haut dans ce catalogue) et la carte reseau physique, ou l'ecart de performances et de fonctionnalites entre pilote generique et pilote constructeur est generalement le plus visible." }
            )
        }
        @{
            Name = "Securite rapide"
            Commands = @(
                @{ Label = "Etat Windows Defender"
                   Cmd   = 'powershell -NoExit -Command Get-MpComputerStatus ^| Format-List AntivirusEnabled,RealTimeProtectionEnabled,AntivirusSignatureLastUpdated,QuickScanAge'
                   Desc  = "Vue rapide de l'etat de Windows Defender (protection active, date de la derniere signature, age du dernier scan rapide), sans lancer un audit de securite complet."
                   Confirm = $false }
                @{ Label = "SMBv1 actif ?"
                   Cmd   = 'powershell -NoExit -Command try { $smb = Get-SmbServerConfiguration -ErrorAction Stop; $etat = if ($smb.EnableSMB1Protocol) { ''ACTIF - protocole obsolete et vulnerable (EternalBlue/WannaCry), a desactiver sauf besoin explicite avec un materiel tres ancien'' } else { ''Inactif (etat recommande)'' }; Write-Host (''SMBv1 : '' + $etat) -ForegroundColor Cyan } catch { Write-Host ''Impossible de verifier l etat SMBv1 (Get-SmbServerConfiguration indisponible).'' -ForegroundColor Red }'
                   Desc  = "Verifie si le protocole SMBv1 est actif sur la machine - un protocole de partage de fichiers obsolete, remplace par SMBv2/v3 depuis longtemps, et vecteur d'attaque historique majeur (EternalBlue, exploite par le ransomware WannaCry en 2017). Desactive par defaut depuis plusieurs versions de Windows, mais peut avoir ete reactive manuellement pour compatibilite avec un NAS ou une imprimante reseau tres ancienne."
                   Confirm = $false
                   Help  = "SMBv1 date des annees 1990 et souffre de faiblesses de conception connues (pas de chiffrement, authentification faible, vulnerable a des attaques comme EternalBlue exploitee par WannaCry et NotPetya en 2017). Windows 10/11 le desactive par defaut depuis plusieurs annees precisement pour cette raison.`n`nS'il apparait ACTIF ici, la cause la plus frequente est une reactivation manuelle anterieure pour permettre la compatibilite avec un peripherique reseau ancien (NAS, imprimante reseau tres ancienne) qui ne supporte que ce protocole - dans ce cas, le risque est limite au reseau local mais reste reel si d'autres appareils du meme reseau sont compromis.`n`nCette commande est en lecture seule. Pour desactiver, la commande native est Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol (necessite un redemarrage) - non incluse directement ici par prudence : une desactivation impactant potentiellement un peripherique reseau en cours d'usage merite une verification manuelle prealable de ce qui en depend reellement sur le reseau local." }
                @{ Label = "Profil reseau actif"
                   Cmd   = 'powershell -NoExit -Command try { Get-NetConnectionProfile -ErrorAction Stop ^| Select-Object Name,InterfaceAlias,NetworkCategory ^| Format-Table -AutoSize } catch { Write-Host ''Impossible de recuperer le profil reseau.'' -ForegroundColor Red }'
                   Desc  = "Affiche la categorie de reseau (Public/Prive/Domaine) actuellement appliquee a chaque interface reseau connectee. Une categorie 'Prive' sur un reseau qui devrait etre 'Public' (Wifi d'un cafe, hotel, aeroport) expose bien plus que necessaire : decouverte reseau active, partages simplifies, regles de pare-feu plus permissives - complementaire a 'Partages reseau actifs' deja present, qui montre CE qui est partage sans dire SUR QUEL type de reseau ce partage est visible."
                   Confirm = $false
                   Help  = "Windows applique des regles de pare-feu et de decouverte reseau differentes selon la categorie attribuee a chaque reseau auquel la machine se connecte :`n`n- Public : profil le plus restrictif, pense pour les reseaux non fiables (Wifi public, hotspot mobile). Decouverte reseau desactivee, partage de fichiers/imprimantes bloque par defaut, regles de pare-feu plus strictes.`n`n- Prive : pense pour un reseau domestique ou professionnel de confiance. Decouverte reseau activee, partage simplifie entre appareils du meme reseau.`n`n- Domaine : attribue automatiquement sur un reseau d'entreprise avec Active Directory, regles generalement gerees via GPO plutot que manuellement.`n`nLa categorie est normalement demandee a l'utilisateur lors de la premiere connexion a un nouveau reseau, mais peut se retrouver incorrecte si la reponse a ete donnee par erreur, ou si le reseau a change de nature sans nouvelle demande (ex. un routeur personnel remplace par un partage de connexion mobile sur le meme nom de reseau Wifi memorise).`n`nPour corriger une categorie incorrecte : Parametres > Reseau et Internet > le reseau concerne > basculer Public/Prive. Cette commande est en lecture seule et ne modifie rien." }
                @{ Label = "Verification Pare-feu"
                   Cmd   = 'powershell -NoExit -Command Get-NetFirewallProfile ^| Select-Object Name,Enabled,DefaultInboundAction,DefaultOutboundAction ^| Format-Table -AutoSize; netsh advfirewall show allprofiles state; Get-Service MpsSvc ^| Select-Object Name,Status ^| Format-Table -AutoSize'
                   Desc  = "Verifie l'etat du pare-feu Windows sur trois niveaux : profils actifs (Domaine/Prive/Public), politique reelle par defaut via netsh (plus fiable que 'NotConfigured' de Get-NetFirewallProfile qui peut etre trompeur), et etat du service sous-jacent MpsSvc. Les trois doivent etre coherents pour confirmer une protection reellement active."
                   Confirm = $false }
                @{ Label = "Etat Secure Boot / TPM"
                   Cmd   = 'powershell -NoExit -Command try { $sb = Confirm-SecureBootUEFI; Write-Host ''Secure Boot :'' $sb } catch { Write-Host ''Secure Boot : non applicable (mode BIOS Legacy, pas UEFI).'' -ForegroundColor Yellow }; Get-Tpm ^| Select-Object TpmPresent,TpmReady,TpmEnabled ^| Format-Table -AutoSize'
                   Desc  = "Verifie rapidement l'etat de Secure Boot et du TPM sans lancer un audit de securite complet. Message clair si la machine est en BIOS Legacy plutot qu'une erreur bloquante (Confirm-SecureBootUEFI echoue sur un systeme non-UEFI). TpmPresent = False signale l'absence de puce TPM active ou fonctionnelle sur la machine - a rapprocher d'un eventuel FAIL BitLocker structurel si c'est le cas, plutot qu'a corriger via cette seule commande."
                   Confirm = $false }
                @{ Label = "Certificats Secure Boot 2023 (DB / KEK)"
                   Cmd   = 'powershell -NoExit -Command try { $sbActif = Confirm-SecureBootUEFI; Write-Host (''Secure Boot actif : '' + $sbActif) -ForegroundColor Green; $dbTexte = [System.Text.Encoding]::ASCII.GetString((Get-SecureBootUEFI db).bytes); $db2023uefi = $dbTexte -match ''Microsoft UEFI CA 2023''; Write-Host (''DB contient Microsoft UEFI CA 2023 (bootloaders tiers) : '' + $db2023uefi) -ForegroundColor Green; $db2023win = $dbTexte -match ''Windows UEFI CA 2023''; Write-Host (''DB contient Windows UEFI CA 2023 (Boot Manager Windows) : '' + $db2023win) -ForegroundColor Green; $kekTexte = [System.Text.Encoding]::ASCII.GetString((Get-SecureBootUEFI KEK).bytes); $kek2023 = ($kekTexte -match ''KEK'') -and ($kekTexte -match ''CA 2023''); Write-Host (''KEK contient Microsoft Corporation KEK 2K CA 2023 : '' + $kek2023) -ForegroundColor Green } catch { Write-Host ''Secure Boot non actif ou non pris en charge sur ce systeme (BIOS Legacy ou Secure Boot desactive).'' -ForegroundColor Yellow }'
                   Desc  = "Verifie en detail si les TROIS certificats UEFI 2023 (remplacants des certificats 2011 qui expirent entre juin et octobre 2026) sont bien integres dans la base Secure Boot DB et KEK. Complementaire a 'Etat Secure Boot / TPM' : celle-ci confirme juste si Secure Boot est actif, celle-ci verifie precisement quels certificats de confiance sont enregistres. Message clair si Secure Boot n'est pas actif ou pris en charge, plutot qu'une erreur bloquante."
                   Confirm = $false
                   Help  = "Contexte : Microsoft renouvelle en 2026 trois certificats Secure Boot emis en 2011, qui expirent a des dates differentes :`n- Microsoft Corporation KEK CA 2011 (24 juin 2026) - autorise les mises a jour de DB/DBX`n- Microsoft Corporation UEFI CA 2011 (27 juin 2026) - signe les bootloaders tiers/option ROMs`n- Microsoft Windows Production PCA 2011 (19 octobre 2026) - signe le Boot Manager Windows lui-meme (le plus critique des trois)`n`nSans mise a jour vers les certificats 2023 correspondants, une machine continue de demarrer normalement, mais risque de ne plus pouvoir recevoir de futures mises a jour de securite liees au demarrage - un etat que Microsoft qualifie lui-meme de 'securite degradee'.`n`nCe que verifie precisement cette commande, une ligne par certificat :`n- DB doit contenir 'Microsoft UEFI CA 2023' (remplace UEFI CA 2011, bootloaders tiers)`n- DB doit AUSSI contenir 'Windows UEFI CA 2023' (remplace Production PCA 2011, Boot Manager Windows - a ne pas confondre avec le precedent, noms tres proches mais certificats distincts)`n- KEK doit contenir 'Microsoft Corporation KEK 2K CA 2023' (remplace KEK CA 2011)`n`nSi l'une des verifications renvoie 'False', la mise a jour correspondante n'a pas encore eu lieu sur cette machine. Generalement appliquee automatiquement par Windows Update si le firmware le permet, mais certains firmwares plus anciens necessitent une action manuelle du fabricant." }
                @{ Label = "Etat BitLocker"
                   Cmd   = 'powershell -NoExit -Command Get-BitLockerVolume ^| Select-Object MountPoint,VolumeStatus,ProtectionStatus,EncryptionPercentage ^| Format-Table -AutoSize'
                   Desc  = "Affiche l'etat de chiffrement BitLocker de chaque volume (protege/non protege, pourcentage de chiffrement). Utile pour un audit de securite rapide - le resultat varie fortement d'une machine a l'autre selon la presence d'un TPM fonctionnel."
                   Confirm = $false }
                @{ Label = "Comptes locaux et administrateurs"
                   Cmd   = 'powershell -NoExit -Command Get-LocalUser ^| Select-Object Name,Enabled,LastLogon ^| Format-Table -AutoSize; Get-LocalGroupMember -SID ''S-1-5-32-544'' ^| Select-Object Name,PrincipalSource ^| Format-Table -AutoSize'
                   Desc  = "Liste les comptes locaux (actifs/desactives, dernier logon) puis les membres du groupe Administrateurs via son SID fixe (S-1-5-32-544) plutot que son nom localise - fonctionne donc identiquement sur une machine Windows en anglais ou en francais. Verifie qu'aucun compte inattendu n'a les droits admin."
                   Confirm = $false }
                @{ Label = "Tentatives de connexion echouees"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''Security'';Id=4625} -MaxEvents 10 ^| Select-Object TimeCreated,Message ^| Format-List } catch { Write-Host ''Aucune tentative de connexion echouee trouvee dans le journal Security.'' -ForegroundColor Green }'
                   Desc  = "Liste les 10 dernieres tentatives de connexion echouees (evenement 4625 du journal Security). Complementaire a 'Comptes locaux et administrateurs' : celle-la montre qui a le droit, celle-ci montre qui a essaye et echoue - un indicateur simple de tentative de bruteforce local. Message clair si le journal ne contient aucun evenement correspondant, plutot qu'une erreur bloquante."
                   Confirm = $false }
                @{ Label = "Etat des regles ASR de Defender"
                   Cmd   = 'powershell -NoExit -Command $asr = Get-MpPreference; if ($asr.AttackSurfaceReductionRules_Ids) { $legendeAction = @{ ''0''=''Desactivee''; ''1''=''Bloquer''; ''2''=''Mode audit (log seulement, rien de bloque)''; ''6''=''Avertir (bloque avec possibilite de contournement utilisateur)'' }; $nomsRegles = @{ ''01443614-cd74-433a-b99e-2ecdc07bfc25''=''Bloquer les executables ne repondant pas aux criteres de prevalence/anciennete/liste de confiance''; ''26190899-1602-49e8-8b27-eb1d0a1ce869''=''Bloquer Outlook (app de communication Office) creant des processus enfants''; ''33ddedf1-c6e0-47cb-833e-de6133960387''=''Bloquer le redemarrage en Mode sans echec''; ''3b576869-a4ec-4529-8536-b80a7769e899''=''Bloquer la creation de contenu executable par les apps Office''; ''56a863a9-875e-4185-98a7-b882c64b5ce5''=''Bloquer abus de pilotes signes vulnerables''; ''5beb7efe-fd9a-4556-801d-275e5ffc04cc''=''Bloquer execution de scripts obfusques''; ''75668c1f-73b5-4cf0-bb93-3ecf5cb7cc84''=''Bloquer injection de code Office dans autres processus''; ''7674ba52-37eb-4a4f-a9a1-f0f9a1619a2c''=''Bloquer Adobe Reader creant des processus enfants''; ''92e97fa1-2edf-4476-bdd6-9dd0b4dddc7b''=''Bloquer appels Win32 API depuis macros Office''; ''9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2''=''Bloquer vol identifiants depuis LSASS''; ''b2b3f03d-6a65-4f7b-a9c7-1c7ef74a9ba4''=''Bloquer processus non signes lances depuis USB''; ''be9ba2d9-53ea-4cdc-84e5-9b1eeee46550''=''Bloquer contenu executable via email/webmail''; ''c0033c00-d16d-4114-a5a0-dc9b3a7d2ceb''=''Bloquer usage outils systeme copies/usurpes''; ''c1db55ab-c21a-4637-bb3f-a12568109d35''=''Protection avancee anti-ransomware''; ''d1e49aac-8f56-4280-b9ba-993a6d77406c''=''Bloquer processus lances via PsExec et WMI''; ''d3e037e1-3eb8-44c8-a917-57927947596d''=''Bloquer JS/VBScript lancant du contenu telecharge''; ''d4f940ab-401b-4efc-aadc-ad5f3c50688a''=''Bloquer toutes les apps Office creant des processus enfants''; ''e6db77e5-3df2-4cf1-b95a-636979351e5b''=''Bloquer persistance via abonnement evenements WMI'' }; for ($i = 0; $i -lt $asr.AttackSurfaceReductionRules_Ids.Count; $i++) { $id = $asr.AttackSurfaceReductionRules_Ids[$i]; $idKey = $id.ToLower(); $action = [string]$asr.AttackSurfaceReductionRules_Actions[$i]; $labelAction = if ($legendeAction.ContainsKey($action)) { $legendeAction[$action] } else { ''Inconnu'' }; $nomRegle = if ($nomsRegles.ContainsKey($idKey)) { $nomsRegles[$idKey] } else { ''Regle non repertoriee (GUID: '' + $id + '')'' }; Write-Host ($nomRegle + '' : '' + $labelAction + '' (code '' + $action + '')'') } } else { Write-Host ''Aucune regle ASR (Attack Surface Reduction) configuree sur cette machine.'' -ForegroundColor Yellow }'
                   Desc  = "Affiche l'etat des regles ASR (Attack Surface Reduction) de Windows Defender : pour chaque regle configuree, son nom traduit en francais et son action actuelle (Desactivee/Bloquer/Mode audit/Avertir). Complementaire a 'Etat Windows Defender' et 'Verification Pare-feu' : les regles ASR bloquent des comportements precis (macros Office lancant du code, vol d'identifiants dans LSASS, etc.), une couche que rien d'autre dans le catalogue ne couvrait jusqu'ici. Message clair si aucune regle n'est configuree, plutot qu'un tableau vide."
                   Confirm = $false
                   Help  = "Les regles ASR (Attack Surface Reduction) sont un ensemble de 19 regles predefinies par Microsoft (18 recensees ici, la 19e - Block Webshell creation for Servers - ne s'applique qu'aux serveurs Exchange), chacune identifiee cote systeme par un GUID fixe et non par un nom lisible. Cette commande traduit chaque GUID rencontre vers son nom en francais via une table de correspondance verifiee sur la documentation officielle Microsoft (Attack surface reduction rules reference). Si un GUID inconnu de cette table apparait (nouvelle regle ajoutee par Microsoft depuis), il s'affiche tel quel avec la mention 'Regle non repertoriee' plutot que d'echouer silencieusement.`n`nSignification des codes d'action affiches :`n- 0 = Desactivee (regle presente mais inactive)`n- 1 = Bloquer (l'action est empechee)`n- 2 = Mode audit (rien n'est bloque, seulement journalise dans l'Observateur d'evenements - utile pour tester une regle avant de l'activer en blocage reel)`n- 6 = Avertir (bloque par defaut, avec une possibilite pour l'utilisateur de forcer le contournement via une notification)`n`nSur une machine grand public (hors Defender for Endpoint / GPO d'entreprise), il est parfaitement normal qu'aucune regle ne soit configuree par defaut - le message correspondant s'affiche alors plutot qu'un tableau vide, sans que ce soit une anomalie a corriger." }
                @{ Label = "Etat UAC"
                   Cmd   = 'powershell -NoExit -Command try { $uac = Get-ItemProperty -Path ''HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'' -ErrorAction Stop; $etatLua = if ($uac.EnableLUA -eq 1) { ''Actif'' } else { ''INACTIF - UAC completement desactive (fortement deconseille)'' }; Write-Host (''EnableLUA (UAC actif) : '' + $etatLua) -ForegroundColor Cyan; $cle = [string]$uac.ConsentPromptBehaviorAdmin + ''-'' + [string]$uac.PromptOnSecureDesktop; $niveau = switch ($cle) { ''2-1'' { ''Toujours avertir (niveau le plus eleve du curseur)'' } ''5-1'' { ''Avertir seulement si une app tente des modifications - reglage par defaut Windows'' } ''5-0'' { ''Avertir seulement si une app tente des modifications, sans assombrir le bureau'' } ''0-0'' { ''Ne jamais avertir (niveau le plus bas - fortement deconseille)'' } default { ''Combinaison non standard (ConsentPromptBehaviorAdmin='' + $uac.ConsentPromptBehaviorAdmin + '', PromptOnSecureDesktop='' + $uac.PromptOnSecureDesktop + '')'' } }; Write-Host (''Niveau du curseur UAC : '' + $niveau) -ForegroundColor Cyan } catch { Write-Host ''Cle de registre UAC introuvable (EnableLUA par defaut = actif sur une installation Windows standard).'' -ForegroundColor Yellow }'
                   Desc  = "Verifie si UAC (controle de compte utilisateur) est actif (EnableLUA) et identifie le niveau exact du curseur configure (Toujours avertir / Avertir seulement si modifications / idem sans assombrir le bureau / Ne jamais avertir), en combinant ConsentPromptBehaviorAdmin et PromptOnSecureDesktop plutot qu'une seule valeur isolee qui serait ambigue. Message clair si la cle de registre n'existe pas (UAC actif par defaut dans ce cas), plutot qu'une erreur bloquante."
                   Confirm = $false
                   Help  = "UAC repose sur deux cles de registre distinctes sous HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System, et le niveau affiche par le curseur du Panneau de configuration est en realite une COMBINAISON des deux, pas une seule valeur :`n`n- EnableLUA : bascule globale (1=actif, 0=UAC entierement desactive - la machine tourne alors en permanence avec les pleins droits admin, sans aucune demande de confirmation, meme pour les logiciels malveillants).`n`n- ConsentPromptBehaviorAdmin + PromptOnSecureDesktop : ensemble, ces deux valeurs determinent laquelle des 4 positions du curseur UAC est active :`n  - 2/1 = Toujours avertir (position la plus haute)`n  - 5/1 = Avertir seulement si une app tente des modifications, bureau assombri (reglage par defaut de Windows)`n  - 5/0 = Meme niveau que le defaut mais SANS assombrir le bureau (le bureau securise/assombri empeche normalement un malware de simuler un clic automatique sur la boite de dialogue UAC - le retirer reduit legerement cette protection)`n  - 0/0 = Ne jamais avertir (position la plus basse, quasiment equivalent a EnableLUA=0 en pratique pour les applications, meme si UAC reste techniquement actif)`n`nSi la combinaison releve ne correspond a aucune des 4 positions standard du curseur, la commande l'affiche telle quelle plutot que de forcer une correspondance approximative - situation rare, generalement le signe d'une modification manuelle du registre plutot que via le Panneau de configuration." }
                @{ Label = "Exploit Protection (mitigations systeme)"
                   Cmd   = 'powershell -NoExit -Command try { $m = Get-ProcessMitigation -System -ErrorAction Stop; Write-Host (''DEP (Data Execution Prevention) : '' + $m.DEP.Enable) -ForegroundColor Cyan; Write-Host (''SEHOP : '' + $m.SEHOP.Enable) -ForegroundColor Cyan; Write-Host (''CFG (Control Flow Guard) : '' + $m.CFG.Enable) -ForegroundColor Cyan; Write-Host (''ASLR BottomUp : '' + $m.ASLR.BottomUp) -ForegroundColor Cyan; Write-Host (''ASLR ForceRelocateImages : '' + $m.ASLR.ForceRelocateImages) -ForegroundColor Cyan; Write-Host (''ASLR HighEntropy : '' + $m.ASLR.HighEntropy) -ForegroundColor Cyan } catch { Write-Host ''Impossible de recuperer les parametres Exploit Protection (Get-ProcessMitigation indisponible).'' -ForegroundColor Red }'
                   Desc  = "Affiche les principales mitigations systeme d'Exploit Protection (DEP, SEHOP, CFG, ASLR sous ses trois variantes) telles que configurees globalement pour la machine. Complementaire aux regles ASR de Defender deja presentes : ASR bloque des comportements applicatifs precis, Exploit Protection agit a un niveau plus bas, sur les mecanismes memoire exploites par la plupart des techniques d'exploitation de vulnerabilites, independamment de toute signature ou regle comportementale."
                   Confirm = $false
                   Help  = "Exploit Protection (anciennement EMET, integre nativement a Windows Defender depuis Windows 10) applique un ensemble de mitigations au niveau du systeme d'exploitation qui rendent l'exploitation de vulnerabilites memoire (buffer overflow, corruption de tas, etc.) structurellement plus difficile, independamment de la nature du logiciel malveillant ou de la vulnerabilite exacte exploitee :`n`n- DEP (Data Execution Prevention) : empeche l'execution de code depuis des zones memoire marquees comme donnees uniquement - la mitigation la plus ancienne et la plus fondamentale, active par defaut depuis longtemps.`n`n- SEHOP : protege la chaine de gestion des exceptions structurees contre son detournement, une technique d'exploitation classique sur systemes 32 bits.`n`n- CFG (Control Flow Guard) : verifie a l'execution que les appels de fonction indirects pointent vers une destination legitime connue au moment de la compilation, complique fortement les techniques de detournement de flux d'execution (ROP/JOP).`n`n- ASLR (Address Space Layout Randomization, trois variantes) : randomise l'emplacement en memoire du code et des donnees a chaque execution, empechant un attaquant de predire a l'avance ou se trouve une fonction ou une structure a cibler.`n`nLa valeur 'NOTSET' pour un parametre ne signifie pas desactive : elle indique qu'aucune configuration explicite au niveau systeme n'a ete appliquee, et que le comportement par defaut de Windows (generalement actif pour la plupart de ces mitigations sur les systemes modernes) s'applique silencieusement. Une valeur explicite 'OFF' serait en revanche le signe d'une desactivation volontaire, potentiellement problematique si elle n'est pas intentionnelle." }
                @{ Label = "Partages reseau actifs"
                   Cmd   = 'powershell -NoExit -Command try { Get-SmbShare -ErrorAction Stop ^| Select-Object Name,Path,@{N=''Type'';E={if ($_.Special) { ''Administratif (cache, systeme)'' } else { ''Partage utilisateur'' }}} ^| Format-Table -AutoSize } catch { Write-Host ''Impossible de recuperer la liste des partages SMB.'' -ForegroundColor Red }'
                   Desc  = "Liste tous les partages SMB actifs sur la machine (partages utilisateur crees manuellement et partages administratifs par defaut comme C`$, ADMIN`$, IPC`$), avec leur chemin local. Audit rapide de ce qui est expose sur le reseau local, absent du catalogue jusqu'ici - a verifier notamment sur une machine qui ne devrait normalement rien partager."
                   Confirm = $false
                   Help  = "Windows cree automatiquement plusieurs partages administratifs caches des le demarrage (marques Administratif dans la colonne Type) : C`$ (racine de chaque disque), ADMIN`$ (dossier Windows), IPC`$ (communication inter-processus). Ces partages sont normaux sur toute installation Windows standard, accessibles uniquement par un compte administrateur du domaine/de la machine, et ne constituent pas une anomalie a corriger - les desactiver casse des fonctionnalites d'administration a distance (gestion via MMC, deploiement logiciel, etc.).`n`nCe qui merite attention, ce sont les partages marques Partage utilisateur : tout dossier partage volontairement (ou par une application, un jeu, un logiciel de sauvegarde reseau...) apparait ici avec son chemin local exact. Sur une machine qui ne devrait normalement rien partager sur le reseau, la presence d'un partage utilisateur inattendu merite d'etre investiguee - soit un partage cree consciemment et oublie, soit installe par un logiciel tiers sans que ce soit evident au premier abord." }
                @{ Label = "LSA Protection (RunAsPPL)"
                   Cmd   = 'powershell -NoExit -Command try { $lsa = Get-ItemProperty -Path ''HKLM:\SYSTEM\CurrentControlSet\Control\Lsa'' -ErrorAction Stop; $val = $lsa.RunAsPPL; $etat = if ($null -eq $val -or $val -eq 0) { ''INACTIF - LSASS non protege contre l extraction d identifiants (deconseille)'' } elseif ($val -eq 1) { ''Actif'' } elseif ($val -eq 2) { ''Actif avec verrouillage UEFI (protection renforcee, non desactivable a distance)'' } else { ''Valeur non standard ('' + $val + '')'' }; Write-Host (''RunAsPPL (protection LSASS) : '' + $etat) -ForegroundColor Cyan } catch { Write-Host ''Impossible de lire la cle de registre LSA.'' -ForegroundColor Red }'
                   Desc  = "Verifie si la protection LSA (RunAsPPL) est active, qui transforme le processus LSASS en processus protege (PPL) empechant meme un compte administrateur d'y injecter du code ou d'en extraire le contenu memoire directement. Complement direct de la regle ASR Bloquer vol identifiants depuis LSASS deja presente : l'ASR bloque un comportement d'attaque typique, RunAsPPL protege le processus lui-meme au niveau du noyau, une couche independante et plus fondamentale."
                   Confirm = $false
                   Help  = "LSASS (Local Security Authority Subsystem Service) est le processus qui gere en memoire les identifiants de session active (hash de mot de passe, tickets Kerberos...) - une cible privilegiee classique pour des outils d'extraction d'identifiants (Mimikatz et equivalents), meme avec des privileges administrateur locaux normalement suffisants pour lire la memoire de n'importe quel processus.`n`nRunAsPPL transforme LSASS en processus protege (Protected Process Light) : seuls d'autres processus proteges et signes par un editeur de confiance specifique peuvent alors interagir avec sa memoire, ce qui bloque structurellement la plupart des outils d'extraction meme executes avec des privileges administrateur complets.`n`nTrois etats possibles :`n- 0 ou absent : protection inactive (comportement par defaut historique de Windows, encore le cas sur de nombreuses installations).`n- 1 : protection active, mais desactivable via le registre par un administrateur (y compris par un malware disposant de privileges suffisants).`n- 2 : protection active avec verrouillage UEFI - la valeur est alors egalement stockee dans le firmware et ne peut plus etre desactivee simplement en modifiant le registre, meme avec des privileges administrateur complets ; necessite un acces physique et un outil dedie pour la desactiver.`n`nActiver cette protection peut occasionnellement empecher le bon fonctionnement de certains pilotes ou logiciels de securite tiers plus anciens qui s'attendent a pouvoir interagir directement avec LSASS - a tester avant un deploiement large si des logiciels de securite tiers sont utilises en parallele de Defender." }
                @{ Label = "Credential Guard actif ?"
                   Cmd   = 'powershell -NoExit -Command try { $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace ''root\Microsoft\Windows\DeviceGuard'' -ErrorAction Stop; if ($dg.SecurityServicesRunning -contains 1) { Write-Host ''Credential Guard : ACTIF'' -ForegroundColor Green } else { Write-Host ''Credential Guard : INACTIF'' -ForegroundColor Yellow; Write-Host ''Etat normal sur une machine personnelle non rattachee a un domaine - voir le bouton ? pour le detail.'' -ForegroundColor Yellow } } catch { Write-Host ''Impossible d interroger Win32_DeviceGuard (namespace WMI absent, edition Windows Home, ou fonctionnalite non prise en charge sur ce materiel).'' -ForegroundColor Red }'
                   Desc  = "Verifie si Credential Guard est actif. ATTENTION - fonctionnalite orientee entreprise/domaine : protege les identifiants de domaine (secrets NTLM/Kerberos mis en cache) contre le vol par des outils type Mimikatz, sur une machine jointe a un Active Directory local ou a Entra ID. Sur une machine personnelle avec uniquement des comptes locaux (non rattachee a un domaine), l'etat INACTIF est le fonctionnement normal et attendu, pas une anomalie a corriger - il n'y a tout simplement pas d'identifiants de domaine a proteger dans ce contexte."
                   Confirm = $false
                   Help  = "Credential Guard isole dans un conteneur virtualise (via VBS, la meme fondation que HVCI deja present dans la categorie Performance) les identifiants de domaine mis en cache localement - hash NTLM, tickets Kerberos - pour empecher un attaquant ayant deja compromis la machine, meme avec des privileges administrateur complets, de les extraire et de rebondir vers d'autres machines du meme domaine (attaques de type pass-the-hash ou pass-the-ticket).`n`nC'est une protection specifiquement pensee pour les environnements d'entreprise, ou les postes sont joints a un Active Directory local ou a Entra ID (ex-Azure AD) et ou Credential Guard est generalement deploye et gere de maniere centralisee via GPO ou Intune, plutot qu'active manuellement poste par poste.`n`nSur une machine personnelle utilisant uniquement des comptes locaux ou un compte Microsoft, sans jonction a un domaine d'entreprise, il n'existe simplement pas d'identifiants de domaine en cache a proteger - Credential Guard n'a alors rien de concret a securiser. Un etat INACTIF dans ce contexte precis est donc le comportement par defaut normal d'une machine grand public, pas une faiblesse a corriger - contrairement par exemple a la protection LSA (RunAsPPL) juste au-dessus dans ce meme catalogue, qui elle reste pertinente sur n'importe quelle machine independamment de toute notion de domaine.`n`nSi cette commande echoue avec un message d'erreur plutot que d'afficher un statut ACTIF/INACTIF, la cause la plus frequente est l'edition de Windows installee : la classe WMI Win32_DeviceGuard et Credential Guard lui-meme ne sont disponibles que sur les editions Pro, Enterprise et Education de Windows - absents par construction sur Windows Home, meme si le materiel serait techniquement compatible (VBS actif, TPM present, etc.)." }
                @{ Label = "AutoPlay / AutoRun - etat actuel"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Affiche l'etat actuel du parametre de registre NoDriveTypeAutoRun, qui controle l'ouverture/execution automatique d'un support amovible (cle USB, CD/DVD) des son insertion - a la fois AutoRun (execution silencieuse d'un programme, deja bloquee par defaut depuis Windows 7) et AutoPlay (ouverture automatique du contenu ou boite de dialogue, active par defaut sur Windows 10/11 - voir Help pour la distinction). Absent ou a 0 = comportement par defaut de Windows (AutoPlay actif) ; 255 (0xFF) = tout comportement automatique explicitement desactive sur tous les types de lecteurs, y compris l'ouverture automatique du contenu."
                   Confirm = $false
                   Help  = "Deux mecanismes distincts, souvent confondus sous le meme terme generique 'autorun' :`n`n- AutoRun : execution automatique et silencieuse d'un programme reference dans un fichier autorun.inf a la racine d'un support, sans aucune action de l'utilisateur. Vecteur de propagation de malware majeur dans les annees 2000-2010 (le ver Conficker en est l'exemple le plus connu). Depuis Windows 7 (suite a une mise a jour de securite retroportee jusqu'a Vista SP1), cette execution automatique est desactivee par defaut sur les lecteurs amovibles (cles USB) - une protection native du systeme, independante de la cle de registre NoDriveTypeAutoRun.`n`n- AutoPlay : comportement distinct qui reste actif par defaut sur Windows 10/11, independamment de la protection AutoRun ci-dessus. A l'insertion d'un support, Windows propose une boite de dialogue de choix d'action, ou ouvre directement le contenu dans l'Explorateur de fichiers si un comportement par defaut a ete configure (via Parametres > Peripheriques > Lecture automatique, ou par cette meme cle NoDriveTypeAutoRun). C'est ce qui explique une ouverture automatique du contenu d'une cle USB a l'insertion sur une machine Windows 10/11 par ailleurs a jour : aucune contradiction avec la protection AutoRun native, qui elle bloque uniquement l'execution silencieuse d'un programme, pas l'ouverture d'une fenetre.`n`nCe que verifie precisement cette commande : la valeur NoDriveTypeAutoRun, un mecanisme plus ancien historiquement pilote par strategie de groupe (GPO), qui permet de durcir ce comportement de maniere explicite en desactivant AutoPlay lui-meme (pas seulement AutoRun) pour un ou plusieurs types de lecteurs. Une valeur de 255 (0xFF) coupe les notifications/ouvertures automatiques AutoPlay sur tous les types de lecteurs, ce qui se traduit concretement par l'absence totale d'ouverture automatique a l'insertion d'un support, contrairement au comportement par defaut de Windows decrit ci-dessus. Une valeur absente signifie qu'aucun durcissement explicite de ce type n'a ete configure - AutoPlay suit alors son comportement par defaut (actif), meme si AutoRun (l'execution) reste protege nativement." }
                @{ Label = "Taches planifiees a auteur non-Microsoft"
                   Cmd   = 'powershell -NoExit -Command Get-ScheduledTask -ErrorAction SilentlyContinue ^| Where-Object { $_.Author -notmatch ''(?i)^Microsoft'' } ^| Select-Object TaskName,TaskPath,Author,State ^| Sort-Object TaskPath,TaskName ^| Format-Table -AutoSize'
                   Desc  = "Liste les taches planifiees dont l'auteur declare ne commence pas par Microsoft (y compris les taches sans auteur renseigne), pour reperer rapidement celles ajoutees par un logiciel tiers ou, dans le pire des cas, un mecanisme de persistance malveillant. Complementaire a 'Taches planifiees actives (hors demarrage)' deja present dans ce catalogue : celle-ci filtre specifiquement sur la provenance plutot que sur l'etat actif/inactif."
                   Confirm = $false
                   Help  = "Une tache planifiee est l'un des mecanismes de persistance les plus courants, aussi bien pour des logiciels legitimes (mise a jour automatique, service de synchronisation, utilitaire constructeur) que pour un malware cherchant a se relancer automatiquement apres un redemarrage sans passer par les emplacements de demarrage plus surveilles (dossier Demarrage, cle Run du registre).`n`nLe champ Author est renseigne par le createur de la tache au moment de sa creation et n'est pas verifie ni signe par Windows - un logiciel malveillant peut theoriquement y inscrire n'importe quelle valeur, y compris une chaine ressemblant a 'Microsoft'. Cette commande est donc un filtre de tri rapide et un point de depart pour l'investigation, pas une preuve definitive de legitimite ou de malveillance a elle seule.`n`nUne tache sans auteur renseigne (champ vide) n'est pas necessairement suspecte : de nombreux installateurs tiers legitimes, notamment plus anciens ou crees via schtasks.exe en ligne de commande sans l'option correspondante, ne remplissent simplement pas ce champ. A l'inverse, la presence d'un nom d'editeur connu et coherent avec un logiciel effectivement installe sur la machine (visible par exemple dans la liste des programmes installes) est un bon signe de legitimite. Ce qui merite le plus d'attention : un nom d'auteur absent, generique, ou incoherent, associe a une tache dont le chemin d'action (visible dans le Planificateur de taches, onglet Actions) pointe vers un executable dans un emplacement inhabituel (dossier temporaire, AppData avec un nom aleatoire, etc.)." }
            )
        }
        @{
            Name = "Confidentialite / Telemetrie"
            Commands = @(
                @{ Label = "Niveau de telemetrie Windows"
                   Cmd   = 'powershell -NoExit -Command try { $val = Get-ItemProperty -Path ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection'' -Name AllowTelemetry -ErrorAction Stop; $niveau = switch ($val.AllowTelemetry) { 0 { ''Securite (0) - Enterprise/Education uniquement, minimum absolu'' } 1 { ''Basique (1) - donnees de diagnostic essentielles uniquement'' } 2 { ''Ameliore (2) - retire depuis Windows 10 1803+, fusionne avec 1 ou 3 selon build'' } 3 { ''Complet (3) - maximum de donnees collectees'' } default { ''Valeur non standard ('' + $val.AllowTelemetry + '')'' } }; Write-Host (''Niveau de telemetrie configure explicitement : '' + $niveau) -ForegroundColor Cyan } catch { Write-Host ''Aucune valeur AllowTelemetry definie explicitement - le niveau par defaut de l edition Windows installee s applique (voir le bouton ? pour le detail).'' -ForegroundColor Yellow }'
                   Desc  = "Verifie le niveau de telemetrie Windows configure explicitement (AllowTelemetry), la cle maitresse qui determine la quantite de donnees de diagnostic collectees et envoyees a Microsoft. Distinct de tout blocage reseau/DNS (comme NextDNS ou un fichier hosts) : meme avec le trafic bloque au niveau reseau, Windows continue de generer et tenter d'envoyer ces donnees tant que ce niveau n'est pas abaisse au niveau applicatif."
                   Confirm = $false
                   Help  = "Windows definit quatre niveaux de telemetrie possibles (0 a 3), du minimum absolu au maximum de collecte. Le niveau 2 (Ameliore) a ete retire dans les versions recentes de Windows 10/11 et fusionne avec les niveaux voisins selon la build exacte.`n`nPoint important specifique aux editions grand public : sur Windows Home et Pro (hors gestion par GPO/MDM d'entreprise), le niveau minimum accessible via l'interface est generalement 1 (Basique) - le niveau 0 (Securite) n'est disponible que sur les editions Enterprise, Education, et Windows Server, ou via une gestion centralisee. Il est donc normal, sur une machine grand public, de ne jamais pouvoir descendre en dessous du niveau 1 par les moyens standards.`n`nCette commande lit uniquement la valeur si elle a ete definie EXPLICITEMENT (par GPO, registre modifie manuellement, ou un outil de durcissement tiers) sous la cle de policy. En l'absence de cette cle, Windows applique son comportement par defaut selon l'edition installee - ce qui n'est pas forcement le niveau 1 minimal, simplement le reglage standard non force.`n`nCette commande est en lecture seule. La modification se fait via Parametres > Confidentialite et securite > Diagnostics et commentaires, ou en definissant directement AllowTelemetry sous cette cle de registre (necessite des droits administrateur).`n`nLEGENDE DES VALEURS : contrairement a la plupart des autres commandes d'etat de cette categorie qui affichent un binaire simple (0 ou 1), il s'agit ici d'une echelle a 4 niveaux (0 a 3, detail ci-dessus) - plus le chiffre est eleve, plus la collecte de donnees est importante." }
                @{ Label = "Applications avec acces camera/micro/GPS"
                   Cmd   = 'powershell -NoExit -Command try { $capacites = @{ ''webcam''=''Camera''; ''microphone''=''Microphone''; ''location''=''Localisation'' }; $resultats = foreach ($cle in $capacites.Keys) { $chemin = ''HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\'' + $cle; if (Test-Path $chemin) { Get-ChildItem $chemin -ErrorAction SilentlyContinue ^| ForEach-Object { $v = (Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue).Value; if ($v -eq ''Allow'') { $nom = if ($_.PSChildName -eq ''NonPackaged'') { ''Applications de bureau (non-Store, autorisation globale)'' } else { $_.PSChildName }; [PSCustomObject]@{ Capacite = $capacites[$cle]; Application = $nom } } } } }; if ($resultats) { $resultats ^| Sort-Object Capacite,Application ^| Format-Table -AutoSize -Wrap } else { Write-Host ''Aucune application avec un acces explicitement autorise trouve.'' -ForegroundColor Green } } catch { Write-Host ''Impossible de lire le ConsentStore.'' -ForegroundColor Red }'
                   Desc  = "Liste les applications ayant explicitement recu la permission d'acceder a la camera, au microphone ou a la localisation (uniquement les acces actuellement autorises). Angle concret et actionnable : plutot que de savoir seulement si ces capacites sont globalement activees, voir precisement QUELLES applications en beneficient permet de reperer un acces oublie ou inattendu."
                   Confirm = $false
                   Help  = "Windows enregistre le consentement donne a chaque application pour ces trois capacites sensibles dans le registre (CapabilityAccessManager\ConsentStore), sous HKCU (donc propre a la session utilisateur active, pas a la machine dans son ensemble - un autre compte utilisateur sur la meme machine aurait ses propres autorisations independantes).`n`nDeux types d'entrees apparaissent : les applications du Microsoft Store/UWP, identifiees individuellement par leur nom de famille de paquet (ex. Microsoft.WindowsCamera_8wekyb3d8bbwe), et une entree unique affichee comme 'Applications de bureau (non-Store, autorisation globale)' qui represente l'autorisation COLLECTIVE donnee a toutes les applications de bureau classiques (Win32) a la fois - Windows ne suit pas ce consentement individuellement par application de bureau, contrairement aux apps Store qui ont chacune leur propre entree distincte.`n`nSeuls les acces actuellement AUTORISES sont affiches ; les acces explicitement refuses ou jamais demandes n'apparaissent pas, pour ne montrer que ce qui represente une exposition reelle. A croiser avec Parametres > Confidentialite et securite > Autorisations des applications pour revoquer un acces juge inutile - cette commande est en lecture seule et ne modifie rien." }
                @{ Label = "ID de publicite (Advertising ID)"
                   Cmd   = 'powershell -NoExit -Command try { $val = Get-ItemProperty -Path ''HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo'' -Name Enabled -ErrorAction Stop; $etat = if ($val.Enabled -eq 1) { ''ACTIF - les apps peuvent utiliser cet identifiant pour personnaliser les publicites'' } else { ''Inactif'' }; Write-Host (''ID de publicite : '' + $etat) -ForegroundColor Cyan } catch { Write-Host ''Cle AdvertisingInfo introuvable - etat par defaut de Windows applique (generalement actif).'' -ForegroundColor Yellow }'
                   Desc  = "Verifie si l'ID de publicite Windows est actif, un identifiant unique par utilisateur que les applications peuvent utiliser pour personnaliser les publicites affichees et suivre l'usage entre applications. Distinct de la telemetrie generale (AllowTelemetry) : c'est specifiquement un identifiant de suivi publicitaire, pas des donnees de diagnostic systeme."
                   Confirm = $false
                   Help  = "L'ID de publicite (Advertising ID) est un identifiant unique genere par utilisateur Windows, comparable dans son principe a l'IDFA d'iOS ou au GAID d'Android : les applications qui l'utilisent peuvent construire un profil publicitaire associe a cet identifiant plutot qu'a l'utilisateur nommement, et le partager entre elles pour du ciblage publicitaire coordonne (une app peut savoir que l'utilisateur d'un meme ID a aussi utilise telle autre app).`n`nDesactiver ce parametre ne bloque pas la publicite elle-meme (les apps peuvent toujours en afficher), mais empeche son ciblage personnalise base sur cet identifiant specifique - une app peut toujours utiliser ses propres mecanismes de suivi independants de celui-ci.`n`nCette commande est en lecture seule. Pour desactiver, le chemin le plus simple reste Parametres > Confidentialite et securite > Autorisations generales > bascule 'Autoriser les applications a afficher des annonces personnalisees' - un reglage en un clic, ne necessitant pas de modification directe du registre.`n`nLEGENDE DE LA VALEUR (Enabled) : 1 = actif, 0 ou absent = inactif - polarite standard (le nom du parametre commence par 'Enable', une valeur de 1 active la fonctionnalite)." }
                @{ Label = "Historique d'activite (Timeline)"
                   Cmd   = 'powershell -NoExit -Command try { $chemin = ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\System''; if (Test-Path $chemin) { $vals = Get-ItemProperty -Path $chemin; $ef = if ($null -ne $vals.EnableActivityFeed) { $vals.EnableActivityFeed } else { ''non defini'' }; $pub = if ($null -ne $vals.PublishUserActivities) { $vals.PublishUserActivities } else { ''non defini'' }; $up = if ($null -ne $vals.UploadUserActivities) { $vals.UploadUserActivities } else { ''non defini'' }; Write-Host (''EnableActivityFeed (afficher le flux) : '' + $ef) -ForegroundColor Cyan; Write-Host (''PublishUserActivities (enregistrer localement) : '' + $pub) -ForegroundColor Cyan; Write-Host (''UploadUserActivities (envoyer au cloud Microsoft) : '' + $up) -ForegroundColor Cyan } else { Write-Host ''Aucune strategie de groupe definie sur l historique d activite - comportement par defaut de Windows applique.'' -ForegroundColor Yellow } } catch { Write-Host ''Impossible de verifier l historique d activite.'' -ForegroundColor Red }'
                   Desc  = "Verifie si la strategie de groupe restreint la fonctionnalite Timeline/historique d'activite : enregistrement local des activites recentes (apps utilisees, documents ouverts) et leur envoi eventuel vers le compte Microsoft pour la synchronisation entre appareils (Continuer sur ce PC). Distinct du niveau de telemetrie general : c'est specifiquement l'historique d'usage applicatif, pas des donnees de diagnostic technique."
                   Confirm = $false
                   Help  = "Trois reglages distincts controlent cette fonctionnalite, generalement geres ensemble via GPO/registre mais techniquement independants :`n`n- EnableActivityFeed : active ou desactive l'affichage du flux d'activite lui-meme (Vue des taches / Timeline dans l'interface).`n`n- PublishUserActivities : controle si Windows enregistre localement les activites recentes (quelle app a ete utilisee, quel document ouvert, a quelle heure) - meme sans compte Microsoft, cet historique local existe par defaut.`n`n- UploadUserActivities : controle specifiquement l'envoi de cet historique vers le cloud Microsoft, pour le rendre disponible sur d'autres appareils lies au meme compte Microsoft. Sans compte Microsoft associe a la session, cette valeur n'a pas d'effet concret puisqu'il n'y a nulle part ou envoyer les donnees.`n`nLEGENDE DES VALEURS (identique pour les 3) : 0 = fonctionnalite correspondante desactivee, 1 = activee - polarite standard (les 3 noms commencent par 'Enable'/'Publish'/'Upload', une valeur de 1 active). L'absence de valeur (cle de policy non presente du tout, affichee 'non defini') signifie qu'aucune restriction n'est imposee et que le comportement par defaut de Windows s'applique, generalement actif si un compte Microsoft est utilise pour la session." }
                @{ Label = "Windows Recall - etat actuel"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie si Windows Recall (capture periodique de l'ecran analysee par IA pour permettre une recherche retroactive dans l'activite) est explicitement bloque par strategie, au niveau utilisateur (HKCU) et machine (HKLM). IMPORTANT : Recall necessite un PC 'Copilot+' avec NPU d'au moins 40 TOPS - absent de la quasi-totalite des machines anterieures a 2024/2025. Sur du materiel non compatible, la fonctionnalite n'existe simplement pas, independamment de ce que montre cette commande."
                   Confirm = $false
                   Help  = "Windows Recall capture une image de l'ecran toutes les quelques secondes, analysee localement par un modele IA embarque, pour permettre une recherche en langage naturel dans 'tout ce qui a ete vu a l'ecran' (documents, pages web, conversations...). Fonctionnalite tres discutee depuis son annonce en 2024 en raison des implications vie privee, meme si le traitement et le stockage sont annonces comme locaux et chiffres (BitLocker/chiffrement de l'appareil).`n`nRecall est reserve aux PC 'Copilot+', une categorie de machines equipees d'un NPU (unite de calcul dediee a l'IA) d'au moins 40 TOPS de puissance - une exigence materielle recente qu'aucune machine anterieure a 2024 ne remplit, quel que soit par ailleurs la puissance du CPU/GPU. Sur une machine non compatible, l'entree 'Recall et instantanes' n'apparait meme pas dans Parametres > Confidentialite et securite, et cette commande ne fait alors que confirmer l'absence de blocage necessaire puisqu'il n'y a rien a bloquer.`n`nCette commande verifie specifiquement la strategie DisableAIDataAnalysis, le mecanisme officiel de blocage documente par Microsoft (distinct de tout autre reglage de confidentialite du catalogue) - sans rapport avec le service DiagTrack ou la telemetrie generale, qui sont des mecanismes totalement independants.`n`nLEGENDE DES VALEURS - attention, polarite INVERSEE par rapport a la plupart des autres commandes d'etat de cette categorie : 1 = Recall BLOQUE (le nom de la strategie commence par 'Disable' - une valeur de 1 active ce blocage, exactement l'inverse d'un parametre 'Enable'). 0 ou 'non defini' = aucun blocage explicite impose - ce qui ne signifie PAS que Recall est actif, seulement qu'aucune restriction n'a ete configuree (et rappel : sans NPU Copilot+, la question est de toute facon sans objet puisque la fonctionnalite n'existe pas sur la machine)." }
                @{ Label = "Bloquer Windows Recall par strategie"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "ATTENTION : bloque Windows Recall par strategie explicite (HKCU + HKLM), empechant son activation meme sur un futur materiel compatible Copilot+. Sans effet visible sur une machine sans NPU compatible (rien a bloquer), mais utile en verrouillage preventif avant un eventuel changement de materiel."
                   Confirm = $true
                   Help  = "Cree/modifie la valeur DisableAIDataAnalysis a la fois sous HKCU (utilisateur courant) et HKLM (toute la machine, necessite les droits admin deja fournis par l'auto-elevation du Toolbox) - le mecanisme officiel documente par Microsoft pour desactiver Recall de facon durable, distinct de la simple bascule dans Parametres qui reste modifiable en un clic par n'importe quel utilisateur de la session.`n`nSur une machine sans NPU compatible Copilot+ (l'immense majorite du parc actuel), cette commande n'a aucun effet visible puisque Recall n'y est pas installe - elle sert alors de verrou preventif, au cas ou la machine serait remplacee ou mise a niveau vers du materiel compatible plus tard, sans avoir a s'en souvenir a ce moment-la.`n`nUn redemarrage est recommande pour une prise en compte complete, meme si la strategie est generalement lue au demarrage des composants concernes plutot qu'en continu." }
                @{ Label = "Recherche Web menu Demarrer (Bing) - etat"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie si la recherche du menu Demarrer envoie le texte tape a Bing/Microsoft (recherche web integree) en plus de la recherche locale (fichiers, applications, parametres). Angle jamais couvert par le reste du catalogue - distinct de l'ID de publicite ou du niveau de telemetrie general."
                   Confirm = $false
                   Help  = "Par defaut, taper dans la recherche du menu Demarrer ne se limite pas a chercher parmi les fichiers et applications locales : le texte tape peut etre transmis a Bing pour enrichir les resultats avec du contenu web, meme pour une recherche qui n'avait au depart rien de web (chercher un simple fichier local declenche quand meme une requete reseau en arriere-plan).`n`nCe comportement est souvent decouvert par hasard (connexion reseau visible dans un pare-feu ou un moniteur de trafic alors qu'aucune recherche web n'etait voulue), plutot que consciemment choisi - peu de gens savent que ce parametre existe independamment de la recherche locale elle-meme.`n`nLEGENDE DE LA VALEUR (BingSearchEnabled) : 0 = desactive (recherche locale uniquement), 1 ou absent = actif - polarite standard." }
                @{ Label = "Desactiver recherche Web menu Demarrer (Bing)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Desactive la recherche web (Bing) dans le menu Demarrer, en conservant la recherche locale (fichiers, applications, parametres) intacte. Peut necessiter une deconnexion/reconnexion de session pour prendre pleinement effet sur l'interface."
                   Confirm = $true
                   Help  = "Modifie uniquement la valeur BingSearchEnabled - aucune autre fonctionnalite de recherche n'est touchee. La recherche locale (fichiers, dossiers, applications installees, parametres systeme) continue de fonctionner normalement apres ce changement, seul le volet 'resultats web' disparait de la recherche du menu Demarrer.`n`nSi le changement ne semble pas visible immediatement, une deconnexion/reconnexion de session (ou un redemarrage de l'explorateur) force generalement la prise en compte, l'interface de recherche pouvant mettre en cache son comportement pendant la session en cours." }
                @{ Label = "Suggestions/apps sponsorisees (Demarrer) - etat"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie l'etat de 4 parametres regroupes sous ContentDeliveryManager qui controlent les suggestions publicitaires et la reinstallation automatique d'applications tierces (bloatware) dans le menu Demarrer. Une valeur a 0 signifie desactive, 1 (ou absent) signifie actif."
                   Confirm = $false
                   Help  = "Detail des 4 parametres verifies :`n`nSystemPaneSuggestionsEnabled`nAffiche des suggestions d'applications ou de contenu dans le menu Demarrer, generalement basees sur l'usage ou des partenariats commerciaux Microsoft.`n`nSilentInstalledAppsEnabled`nAutorise Windows a installer automatiquement certaines applications tierces en arriere-plan, sans demander confirmation prealable - la source la plus directe de 'bloatware qui revient' apres desinstallation.`n`nSubscribedContent-338388Enabled`nIdentifiant technique specifique correspondant aux suggestions affichees directement dans la liste d'applications du menu Demarrer.`n`nOemPreInstalledAppsEnabled`nControle si les applications pre-installees par le fabricant de la machine (OEM) sont autorisees a se reinstaller ou se mettre en avant automatiquement.`n`nCes parametres sont partiellement exposes dans Parametres > Personnalisation > Demarrer (bascule 'Afficher occasionnellement des suggestions'), mais cette bascule unique ne couvre pas forcement tous les sous-parametres list ici individuellement - d'ou l'interet d'une verification directe en registre.`n`nLEGENDE DES VALEURS (identique pour les 4, rappel de la description ci-dessus) : 0 = desactive, 1 ou absent = actif - polarite standard, la meme sur les 4 parametres." }
                @{ Label = "Desactiver suggestions/apps sponsorisees (Demarrer)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "ATTENTION : desactive en un coup les 6 parametres ContentDeliveryManager lies aux suggestions et a la reinstallation automatique d'applications tierces dans le menu Demarrer. Regroupe volontairement l'action plutot que de faire chercher chaque bascule individuellement dans Parametres."
                   Confirm = $true
                   Help  = "Regroupe l'action sur 6 parametres au total (les 4 detailles dans 'Suggestions/apps sponsorisees (Demarrer) - etat', plus PreInstalledAppsEnabled et RotatingLockScreenEnabled qui controlent respectivement la reinstallation d'apps preinstallees au sens large et les suggestions sur l'ecran de verrouillage) - se referer a la commande d'etat juste au-dessus pour le detail de chacun.`n`nAucune perte de fonctionnalite pour l'usage courant de Windows : ces parametres ne controlent que des suggestions/reinstallations commerciales, pas une fonctionnalite technique du systeme. Le menu Demarrer et l'ecran de verrouillage continuent de fonctionner normalement, simplement sans y voir apparaitre de suggestions ni d'applications tierces reinstallees automatiquement." }
                @{ Label = "Contenu personnalise (diagnostic) - etat"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie si Microsoft est autorise a exploiter les donnees de diagnostic collectees pour personnaliser du contenu dans Windows (astuces, suggestions, ecran de verrouillage). Distinct du niveau de telemetrie general (Niveau de telemetrie Windows) : celui-la controle le VOLUME de donnees collectees, celui-ci controle leur UTILISATION a des fins de personnalisation une fois collectees."
                   Confirm = $false
                   Help  = "Meme avec un niveau de telemetrie deja reduit au minimum (voir 'Niveau de telemetrie Windows' dans ce meme catalogue), ce parametre reste independant : il determine si les donnees de diagnostic encore collectees (meme en quantite reduite) peuvent servir a personnaliser l'experience Windows - astuces contextuelles, suggestions dans les Parametres, contenu de l'ecran de verrouillage.`n`nBeaucoup de gens desactivent la telemetrie generale sans savoir que ce reglage distinct existe separement, laissant Microsoft continuer a exploiter ce qui reste collecte a des fins de personnalisation - deux decisions independantes qui devraient etre prises consciemment l'une et l'autre plutot que de presumer que l'une couvre l'autre.`n`nLEGENDE DE LA VALEUR (TailoredExperiencesWithDiagnosticDataEnabled) : 0 = desactive, 1 ou absent = actif - polarite standard." }
                @{ Label = "Desactiver contenu personnalise (diagnostic)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Desactive l'utilisation des donnees de diagnostic a des fins de personnalisation du contenu Windows (astuces, suggestions, ecran de verrouillage). N'affecte pas le volume de collecte lui-meme (voir 'Niveau de telemetrie Windows' pour ce reglage separe)."
                   Confirm = $true
                   Help  = "Modifie uniquement TailoredExperiencesWithDiagnosticDataEnabled - le niveau de telemetrie general (AllowTelemetry) n'est pas touche par cette commande et doit etre gere separement si voulu, via 'Niveau de telemetrie Windows' ailleurs dans ce catalogue.`n`nAucune perte de fonctionnalite technique : Windows continue de fonctionner normalement, simplement sans astuces ni suggestions personnalisees basees sur l'usage observe via les donnees de diagnostic." }
                @{ Label = "Presse-papiers cloud (Cloud Clipboard) - etat"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie si la synchronisation du presse-papiers entre appareils lies au meme compte Microsoft (Cloud Clipboard) est active. Distinct de l'historique local du presse-papiers (Win+V, EnableClipboardHistory, une cle differente non couverte ici) qui reste purement local et n'est pas concerne."
                   Confirm = $false
                   Help  = "Le presse-papiers cloud synchronise le contenu copie (texte, et dans certains cas images/HTML) vers le compte Microsoft associe a la session, le rendant disponible sur d'autres appareils lies au meme compte - pratique, mais avec un risque reel si un mot de passe, une cle, ou une donnee sensible se retrouve copiee sans y penser.`n`nCette commande est en lecture seule volontairement : contrairement a d'autres reglages plus obscurs de ce catalogue, ce parametre est deja expose comme une bascule simple et unique dans Parametres > Systeme > Presse-papiers ('Synchronisation entre appareils'/Cloud Clipboard) - la aussi le chemin le plus direct pour le desactiver, sans avoir besoin de modifier le registre a la main.`n`nA ne pas confondre avec l'historique local du presse-papiers (raccourci Win+V, activable independamment), qui garde simplement en memoire locale les derniers elements copies sur cette machine sans jamais rien envoyer vers le cloud - une fonctionnalite totalement differente et non couverte par cette commande.`n`nLEGENDE DE LA VALEUR (EnableCloudClipboard) : 1 = actif, 0 ou absent = inactif - polarite standard." }
                @{ Label = "Widgets (Actualites/centres d'interet) - etat"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie si le panneau Widgets (bouton dans la barre des taches, flux d'actualites personnalise base sur l'engagement utilisateur) est bloque au niveau strategie systeme, par opposition a la simple bascule Parametres qui masque uniquement le bouton sans desactiver la fonctionnalite sous-jacente."
                   Confirm = $false
                   Help  = "Le panneau Widgets (Win+W) affiche un flux d'actualites et d'informations personnalise, dont la pertinence repose sur le suivi de l'engagement de l'utilisateur avec le contenu propose - un mecanisme de collecte de donnees comparable dans son principe a n'importe quel flux d'actualites personnalise en ligne, integre directement dans la barre des taches de Windows.`n`nDeux niveaux de desactivation bien distincts :`n- Bascule dans Parametres > Personnalisation > Barre des taches > Widgets : masque uniquement le BOUTON dans la barre des taches. Le panneau reste accessible via le raccourci Win+W, et la fonctionnalite continue de tourner en arriere-plan.`n- Strategie AllowNewsAndInterests (ce que verifie cette commande) : bloque la fonctionnalite dans son ENSEMBLE - bouton grise, raccourci Win+W sans effet, bascule elle-meme grisee dans Parametres pour empecher une reactivation accidentelle.`n`nCette commande verifie specifiquement le second niveau, plus complet et plus difficile a contourner par inadvertance que la simple bascule d'interface.`n`nLEGENDE DES VALEURS : 0 = bloque par strategie, 1 ou absent = non bloque. A l'inverse de 'Windows Recall - etat actuel' plus haut dans ce meme catalogue, ou c'est la valeur 1 qui signifie bloque : le chiffre seul ne suffit jamais a interpreter un etat de confidentialite, il faut toujours verifier le nom du parametre et ce qu'il autorise ('Allow...') ou bloque ('Disable...') explicitement avant de conclure." }
                @{ Label = "Desactiver Widgets (Actualites/centres d'interet)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "ATTENTION : bloque completement les Widgets par strategie systeme (HKLM, toute la machine) - bouton grise dans la barre des taches, raccourci Win+W desactive, bascule Parametres elle-meme grisee. Plus complet que la simple bascule Parametres > Personnalisation > Barre des taches, qui ne masque que le bouton sans bloquer la fonctionnalite."
                   Confirm = $true
                   Help  = "Applique la strategie AllowNewsAndInterests=0 sous HKLM\SOFTWARE\Policies\Microsoft\Dsh, le mecanisme officiel documente par Microsoft (identique a celui utilise par les outils de gestion d'entreprise type Intune) pour desactiver Widgets dans son ensemble plutot que sa seule presence visuelle dans la barre des taches.`n`nUn redemarrage est necessaire pour une prise en compte complete. Pour revenir en arriere : supprimer la valeur AllowNewsAndInterests (ou la remettre a 1) puis redemarrer - la bascule dans Parametres redevient alors modifiable normalement." }
                @{ Label = "Verification services telemetrie"
                   Cmd   = 'powershell -NoExit -Command Get-Service DiagTrack,dmwappushservice,DoSvc,WerSvc,CDPSvc ^| Select-Object Name,Status,StartType ^| Format-Table -AutoSize'
                   Desc  = "Verifie l'etat (Running/Stopped) et le mode de demarrage de cinq services lies a la telemetrie et au tracking (DiagTrack, dmwappushservice, Delivery Optimization, Windows Error Reporting, Connected Devices Platform). Utile pour confirmer qu'un durcissement (registre, GPO) est bien effectif au niveau des services eux-memes. Windows Search (WSearch), qui n'a rien a voir avec la telemetrie, a ete deliberement exclu de cette liste - voir 'Verification service WSearch' dans la categorie Performance."
                   Confirm = $false
                   Help  = "Detail des cinq services verifies :`n`nDiagTrack (Connected User Experiences and Telemetry)`nLe service de telemetrie principal de Windows : collecte des donnees de diagnostic et d'usage et les envoie a Microsoft (rapports de plantage detailles, statistiques d'utilisation des fonctionnalites, etc.). Le desactiver reduit directement la quantite de donnees remontees a Microsoft - aucune perte de fonctionnalite pour un usage courant.`n`ndmwappushservice (WAP Push Message Routing Service)`nHerite d'une ancienne technologie de messagerie mobile (WAP), aujourd'hui associe a certaines notifications de gestion d'appareil. Peu documente publiquement sur son usage exact actuel, mais classe par consensus general comme lie a la telemetrie/au push de notifications plutot qu'a une fonctionnalite utilisateur active. Aucune perte notable a le desactiver sur un usage personnel.`n`nDoSvc (Delivery Optimization)`nPermet a Windows de telecharger ET de partager les mises a jour Windows/apps Store en pair-a-pair - la machine peut servir de source de telechargement a d'autres machines (sur le reseau local, voire sur internet selon la config par defaut), et inversement. Le desactiver force Windows a telecharger uniquement depuis les serveurs Microsoft directs : plus previsible en bande passante, mais parfois legerement plus lent lors de grosses mises a jour. Souvent configure en StartType Manual par defaut (plutot que Disabled) : il ne tourne alors que lors d'un telechargement de mise a jour actif, pas en permanence.`n`nWerSvc (Windows Error Reporting)`nEnvoie a Microsoft les rapports de plantage d'applications et du systeme (crash dumps, informations sur l'exception). Le desactiver stoppe cet envoi automatique - la remontee automatique de crash a Microsoft s'arrete, mais rien qui affecte le fonctionnement normal des applications elles-memes.`n`nCDPSvc (Connected Devices Platform)`nAlimente les fonctionnalites de continuite entre appareils lies a un compte Microsoft : 'Continuer sur ce PC' depuis un telephone, partage a proximite (Nearby Sharing), synchronisation d'activites. Si la session Windows utilise un compte LOCAL plutot qu'un compte Microsoft, ce service ne sert reellement a rien - a verifier au cas par cas selon le type de compte utilise sur la machine." }
                @{ Label = "Desactiver services telemetrie"
                   Cmd   = 'powershell -NoExit -Command $services = @(''DiagTrack'',''dmwappushservice'',''DoSvc'',''WerSvc'',''CDPSvc''); foreach ($s in $services) { try { Stop-Service -Name $s -Force -ErrorAction Stop; Set-Service -Name $s -StartupType Disabled -ErrorAction Stop; Write-Host ($s + '' : desactive'') -ForegroundColor Green } catch { Write-Host ($s + '' : echec - '' + $_.Exception.Message) -ForegroundColor Red } }'
                   Desc  = "ATTENTION : arrete et desactive completement les 5 services de telemetrie listes par 'Verification services telemetrie'. Reduit l'envoi de donnees a Microsoft sans perte de fonctionnalite pour un usage courant. Windows Search (WSearch) n'est PAS inclus ici (compromis performance sans rapport avec la vie privee) - voir 'Desactiver WSearch (indexation)' dans la categorie Performance si les deux sont voulus."
                   Confirm = $true
                   Help  = "Regroupe l'action sur les 5 services detailles individuellement dans le bouton ? de 'Verification services telemetrie' juste au-dessus - se referer a cette derniere pour comprendre precisement ce que fait chaque service avant de tous les desactiver d'un coup.`n`nCes 5 services etaient auparavant regroupes avec Windows Search (WSearch) dans une seule commande commune ; la separation en deux categories distinctes (Confidentialite / Telemetrie ici, Performance pour WSearch) reflete le fait que ce sont deux decisions de nature differente : reduire l'envoi de donnees a Microsoft n'a pas de contrepartie fonctionnelle, alors que desactiver l'indexation ralentit reellement la recherche de fichiers au quotidien - deux arbitrages independants, qui ne devraient pas etre presentes comme un seul choix groupe." }
                @{ Label = "Copilot Windows - etat"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie si l'integration Copilot (assistant IA integre a Windows, distinct de Recall et de tout NPU) est explicitement bloquee par strategie, au niveau utilisateur (HKCU) et machine (HKLM)."
                   Confirm = $false
                   Help  = "Copilot est l'assistant conversationnel integre a Windows (barre laterale ou icone dans la barre des taches selon la version) : contrairement a Recall, il ne necessite aucun materiel particulier (pas de NPU requis) et est deploye largement depuis 2023-2024 sur Windows 11. Son usage envoie les requetes formulees vers les services cloud de Microsoft pour generer une reponse.`n`nCette commande verifie specifiquement la strategie TurnOffWindowsCopilot, le mecanisme officiel documente par Microsoft (identique a celui utilise par les outils de gestion d'entreprise type Intune/GPO) pour desactiver Copilot au niveau du systeme plutot que de simplement masquer son icone.`n`nLEGENDE DES VALEURS : 1 = Copilot desactive par strategie (le nom commence par 'TurnOff' - une valeur de 1 active ce blocage). 0 ou 'non defini' = aucun blocage explicite impose - selon la version et la region, Copilot peut alors etre present et actif par defaut.`n`nSelon les builds Windows et les mises a jour de fonctionnalites, l'implementation de Copilot (nom, emplacement dans l'interface, mode de distribution) a pu evoluer depuis l'introduction initiale de cette strategie - a verifier au cas par cas si le comportement observe ne correspond pas a ce que cette commande indique." }
                @{ Label = "Desactiver Copilot Windows"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Bloque Copilot par strategie explicite (HKCU + HKLM), le mecanisme officiel documente par Microsoft. Une deconnexion/reconnexion de session ou un redemarrage peut etre necessaire pour une prise en compte complete de l'interface."
                   Confirm = $true
                   Help  = "Cree/modifie la valeur TurnOffWindowsCopilot a la fois sous HKCU (utilisateur courant) et HKLM (toute la machine, necessite les droits admin deja fournis par l'auto-elevation du Toolbox) - identique au mecanisme de blocage officiel utilise par les outils de gestion d'entreprise (Intune/GPO).`n`nSelon la version de Windows et la methode de distribution de Copilot sur la machine (integre au systeme ou installe separement depuis le Microsoft Store), cette strategie peut ne pas couvrir tous les points d'entree possibles - une verification via 'Copilot Windows - etat' apres redemarrage reste recommandee pour confirmer l'effet.`n`nPour revenir en arriere : supprimer la valeur TurnOffWindowsCopilot (ou la remettre a 0) dans les deux cles, puis redemarrer la session." }
                @{ Label = "Telemetrie residuelle Edge - etat"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie l'etat de deux strategies Edge liees a l'envoi de statistiques d'usage/diagnostic a Microsoft. Concerne toute machine ou Edge reste installe (composant systeme sur Windows 11), meme si un autre navigateur est utilise au quotidien - Edge peut continuer a tourner en arriere-plan (mises a jour, WebView2, demarrage rapide) independamment du navigateur principal choisi."
                   Confirm = $false
                   Help  = "Detail des deux parametres verifies :`n`nMetricsReportingEnabled`nControle l'envoi de statistiques d'utilisation et de rapports de plantage (UMA - User Metrics Analysis) a Microsoft depuis Edge.`n`nPersonalizationReportingEnabled`nControle si des donnees d'usage d'Edge peuvent etre utilisees a des fins de personnalisation de contenu (suggestions, offres, Microsoft Rewards).`n`nSur Windows 11, Edge reste un composant systeme meme si un autre navigateur est defini par defaut : sa presence residuelle (mises a jour en arriere-plan, WebView2 partage par d'autres applications) peut continuer a remonter des donnees si ces strategies ne sont pas explicitement positionnees, independamment du navigateur reellement utilise au quotidien.`n`nLEGENDE DES VALEURS (identique pour les deux) : 0 = desactive, 1 ou 'non defini' = actif - polarite standard." }
                @{ Label = "Desactiver telemetrie residuelle Edge"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Applique MetricsReportingEnabled=0 et PersonalizationReportingEnabled=0 sous HKLM\SOFTWARE\Policies\Microsoft\Edge - reduit l'envoi de statistiques et de donnees de personnalisation par Edge, sans desinstaller le navigateur ni affecter un autre navigateur installe sur la machine."
                   Confirm = $true
                   Help  = "Cree la cle de strategie Edge si absente et applique les deux valeurs detaillees dans 'Telemetrie residuelle Edge - etat' juste au-dessus - se referer a cette derniere pour le detail de chaque parametre.`n`nN'affecte que le composant Edge lui-meme (statistiques d'usage, rapports de plantage, personnalisation) : n'a aucun impact sur un autre navigateur installe sur la machine (Chrome, Firefox, Brave, LibreWolf ou autre) ni sur les fonctionnalites de navigation d'Edge au quotidien s'il venait a etre utilise malgre tout.`n`nPour revenir en arriere : supprimer les deux valeurs (ou les remettre a 1) sous la cle de strategie Edge." }
                @{ Label = "OneDrive - etat synchronisation/demarrage"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Verifie en un coup d'oeil si le processus OneDrive tourne actuellement, s'il est configure pour demarrer automatiquement avec la session, et si la synchronisation est bloquee par strategie. Utile pour confirmer l'etat reel sur une machine donnee avant d'agir."
                   Confirm = $false
                   Help  = "Trois verifications independantes :`n`nProcessus OneDrive`nIndique si OneDrive.exe tourne actuellement en memoire, quel que soit son mode de demarrage (manuel ou automatique).`n`nDemarrage automatique`nVerifie la presence d'une entree dans la cle Run de l'utilisateur courant (HKCU), le mecanisme standard par lequel OneDrive se relance a chaque ouverture de session.`n`nStrategie de synchronisation (DisableFileSyncNGSC)`nVerifie si la strategie officielle de blocage de la synchronisation OneDrive (documentee par Microsoft, identique a celle utilisee en environnement d'entreprise) est appliquee au niveau machine (HKLM).`n`nCes trois etats sont independants : un processus OneDrive peut tourner meme avec la synchronisation bloquee par strategie (le client reste present mais inactif), et inversement une entree de demarrage automatique peut exister sans que le processus tourne au moment precis de la verification." }
                @{ Label = "Desactiver synchronisation OneDrive"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "ATTENTION : bloque la synchronisation OneDrive par strategie machine (DisableFileSyncNGSC), retire l'entree de demarrage automatique de l'utilisateur courant, et arrete le processus s'il tourne. Ne desinstalle pas OneDrive - le composant reste present mais inactif."
                   Confirm = $true
                   Help  = "Combine les trois actions necessaires pour un blocage complet et durable, plutot que de se limiter a fermer le processus (qui redemarrerait alors a la prochaine ouverture de session) :`n`n1. Applique DisableFileSyncNGSC=1 sous HKLM\SOFTWARE\Policies\Microsoft\Windows\OneDrive - le mecanisme officiel documente par Microsoft empechant toute synchronisation, y compris pour d'autres utilisateurs de la meme machine.`n`n2. Retire l'entree OneDrive de la cle Run (HKCU) qui provoque le redemarrage automatique du client a chaque ouverture de session.`n`n3. Arrete le processus OneDrive s'il tourne actuellement, pour un effet immediat sans attendre la prochaine session.`n`nLe composant OneDrive lui-meme n'est pas desinstalle par cette commande (aucun impact sur d'eventuels fichiers deja synchronises localement) - il reste present sur le disque mais desactive. Pour revenir en arriere : supprimer la valeur DisableFileSyncNGSC (ou la remettre a 0), ce qui permet a l'utilisateur de relancer OneDrive manuellement si souhaite (le redemarrage automatique ne reviendra pas de lui-meme, la synchronisation devra etre relancee/reconfiguree manuellement)." }
            )
        }
        @{
            Name = "Divers"
            Commands = @(
                @{ Label = "Rapport batterie"
                   Cmd   = 'powercfg /batteryreport /output %USERPROFILE%\Desktop\battery-report.html && start %USERPROFILE%\Desktop\battery-report.html'
                   Desc  = "Genere un rapport HTML detaille sur l'usure de la batterie (capacite actuelle vs capacite d'origine, historique d'utilisation) et l'ouvre automatiquement."
                   Confirm = $false }
                @{ Label = "Rapport diagnostic energie"
                   Cmd   = 'powercfg /energy /output %USERPROFILE%\Desktop\energy-report.html && start %USERPROFILE%\Desktop\energy-report.html'
                   Desc  = "Analyse le systeme pendant 60 secondes et genere un rapport sur les problemes d'alimentation/veille (pilotes qui empechent la mise en veille, erreurs USB, etc.)."
                   Confirm = $false }
                @{ Label = "Charge CPU instantanee"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_Processor ^| Select-Object LoadPercentage'
                   Desc  = "Affiche le pourcentage d'utilisation CPU au moment de l'execution. Un instantane simple, pas un suivi en continu."
                   Confirm = $false }
                @{ Label = "Espace disque (Get-Volume)"
                   Cmd   = 'powershell -NoExit -Command Get-Volume'
                   Desc  = "Liste toutes les partitions avec leur espace libre/total dans un format lisible, plus rapide a lire qu'un explorateur de fichiers."
                   Confirm = $false }
                @{ Label = "Etats d'alimentation disponibles"
                   Cmd   = 'powercfg /a'
                   Desc  = "Indique quels etats de veille/hibernation sont disponibles sur la machine, et pourquoi certains sont indisponibles si c'est le cas (utile pour diagnostiquer S3/Modern Standby)."
                   Confirm = $false }
                @{ Label = "Redemarrer le PC"
                   Cmd   = 'shutdown /r /t 0'
                   Desc  = "ATTENTION : redemarre la machine IMMEDIATEMENT, sans delai. Ferme toutes les applications ouvertes sans confirmation prealable de leur part."
                   Confirm = $true
                   Help  = "Difference importante avec un redemarrage classique depuis le menu Demarrer : celui-ci utilise /t 0 (delai de 0 seconde), donc Windows ne laisse PAS le temps aux applications ouvertes de proposer d'enregistrer leur travail en cours - contrairement au redemarrage normal qui affiche generalement une invite 'voulez-vous enregistrer ?' pour chaque application concernee avant de fermer.`n`nCe que ca implique concretement : tout document non enregistre au moment du clic (fichier Office, code en cours d'edition, formulaire web rempli...) est perdu, sans avertissement. A utiliser seulement quand tu es certain d'avoir sauvegarde ton travail en cours, ou pour un redemarrage volontairement rapide sans etat des lieux prealable." }
                @{ Label = "Eteindre le PC"
                   Cmd   = 'shutdown /s /t 0'
                   Desc  = "ATTENTION : eteint la machine IMMEDIATEMENT, sans delai. Ferme toutes les applications ouvertes sans confirmation prealable de leur part."
                   Confirm = $true
                   Help  = "Meme logique que 'Redemarrer le PC' mais pour un arret complet : /t 0 signifie aucun delai, donc aucune invite d'enregistrement pour les applications ouvertes avant la fermeture. Tout document non sauvegarde au moment du clic est perdu.`n`nDifference avec la mise en veille : ceci est un arret complet (l'alimentation coupee), pas une mise en veille - au prochain demarrage, Windows redemarre entierement plutot que de reprendre instantanement la ou tu en etais. A utiliser en connaissance de cause si tu as du travail en cours non sauvegarde." }
                @{ Label = "Rapport DirectX (dxdiag)"
                   Cmd   = 'dxdiag /t %TEMP%\dxdiag.txt && notepad %TEMP%\dxdiag.txt'
                   Desc  = "Genere le rapport de diagnostic DirectX (GPU, pilotes, DirectX supporte) et l'ouvre dans le Bloc-notes. Utile pour du depannage gaming."
                   Confirm = $false }
                @{ Label = "Etat activation Windows"
                   Cmd   = 'slmgr /xpr'
                   Desc  = "Affiche l'etat d'activation de Windows (licence active ou non) dans une fenetre popup (comportement natif de slmgr, pas une erreur si la console reste vide en dessous)."
                   Confirm = $false }
                @{ Label = "Vider la corbeille"
                   Cmd   = 'powershell -NoExit -Command Clear-RecycleBin -Confirm:$false; Write-Host ''Corbeille videe.'' -ForegroundColor Green'
                   Desc  = "ATTENTION : supprime definitivement tout le contenu de la Corbeille, sans possibilite de recuperation. Verifie son contenu avant de lancer si un doute existe."
                   Confirm = $true
                   Help  = "Clear-RecycleBin vide la Corbeille de TOUS les disques de la machine en une seule fois (pas seulement C:), pas de selection possible fichier par fichier depuis cette commande. Les fichiers ne sont pas deplaces ailleurs ni archives - ils sont effaces au sens ou l'espace disque qu'ils occupaient est marque comme libre et reutilisable, sans passer par un second niveau de recuperation.`n`nCe que ca implique concretement : contrairement a un simple glisser-deposer vers la Corbeille (recuperable), cette action est reellement irreversible dans le fonctionnement normal de Windows - seul un outil specialise de recuperation de donnees (qui recherche les traces sur le disque avant qu'elles soient reecrites par de nouveaux fichiers) pourrait eventuellement recuperer quelque chose, sans garantie. Si un fichier recemment supprime pourrait encore avoir de la valeur, verifie le contenu de la Corbeille avant de lancer cette commande plutot qu'apres." }
                @{ Label = "Informations systeme generales"
                   Cmd   = 'powershell -NoExit -Command $os = Get-CimInstance Win32_OperatingSystem; $cs = Get-CimInstance Win32_ComputerSystem; $reg = Get-ItemProperty ''HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion''; [PSCustomObject]@{OS=$os.Caption;Version=$reg.DisplayVersion;Build=($os.BuildNumber.ToString() + ''.'' + $reg.UBR.ToString());Fabricant=$cs.Manufacturer;Modele=$cs.Model;DateInstallation=$os.InstallDate} ^| Format-List'
                   Desc  = "Carte d'identite rapide de la machine (edition Windows, version, build, fabricant, modele, date d'installation). Utilise Win32_OperatingSystem.Caption + le registre DisplayVersion/UBR plutot que WindowsProductName (bug Microsoft connu et jamais corrige : la cle de registre ProductName reste figee sur 'Windows 10 [Edition]' meme sur une installation Windows 11 a jour - Get-ComputerInfo herite de ce defaut)."
                   Confirm = $false }
                @{ Label = "Ouvrir Rapports_Maintenance"
                   Cmd   = 'explorer %USERPROFILE%\Desktop\Rapports_Maintenance'
                   Desc  = "Ouvre directement le dossier ou atterrissent tous les rapports HTML/JSON generes par la suite de scripts de maintenance."
                   Confirm = $false }
                @{ Label = "Version PowerShell active"
                   Cmd   = 'powershell -NoExit -Command $PSVersionTable; (Get-Command powershell.exe).Source'
                   Desc  = "Affiche la version exacte de PowerShell resolue par 'powershell.exe' sur cette machine, plus le chemin complet de l'executable utilise. Utile pour verifier rapidement si powershell.exe pointe vers PowerShell 7 ou Windows PowerShell 5.1 natif (les deux peuvent coexister selon le PATH)."
                   Confirm = $false }
                @{ Label = "Variables d'environnement"
                   Cmd   = 'powershell -NoExit -Command Get-ChildItem Env: ^| Sort-Object Name ^| Format-Table -AutoSize'
                   Desc  = "Liste toutes les variables d'environnement actives (PATH, TEMP, USERPROFILE, etc.), triees par nom. Diagnostic basique mais pratique pour verifier rapidement une valeur de PATH ou une variable custom sans ouvrir les proprietes systeme."
                   Confirm = $false }
                @{ Label = "Historique arrets/redemarrages inattendus"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''System''; Id=41,6008} -MaxEvents 10 -ErrorAction Stop ^| Select-Object TimeCreated,Id,@{N=''Type'';E={if ($_.Id -eq 41) { ''Kernel-Power (coupure brutale : coupure secteur, plantage materiel, arret force)'' } else { ''EventLog 6008 (Windows a detecte un arret non planifie au demarrage suivant)'' }}} ^| Format-Table -AutoSize } catch { Write-Host ''Aucun arret/redemarrage inattendu trouve dans le journal System (bon signe).'' -ForegroundColor Green }'
                   Desc  = "Liste les 10 derniers arrets/redemarrages inattendus consignes dans le journal System (evenement 41 Kernel-Power = coupure brutale sans arret propre de Windows, evenement 6008 = Windows a lui-meme detecte au demarrage suivant que l'arret precedent n'etait pas planifie). Distinct de 'Erreurs systeme recentes' (Performance) qui couvre toutes les erreurs generiques : celle-ci cible specifiquement les coupures/plantages, un signal fort de probleme materiel, d'alimentation ou de pilote bas niveau. Message clair si aucun evenement de ce type n'est trouve, plutot qu'une erreur bloquante."
                   Confirm = $false
                   Help  = "Les deux evenements ont une origine differente mais pointent vers le meme symptome : un arret qui n'est PAS passe par la sequence normale de fermeture de Windows.`n`nEvenement 41 (Kernel-Power) : consigne par le noyau au demarrage suivant, quand Windows constate que la session precedente n'a jamais correctement signale son arret avant de disparaitre - typiquement une coupure de courant, un appui long force sur le bouton d'alimentation, un plantage total (BSOD severe sans meme le temps d'ecrire le crash dump), ou un probleme materiel comme une alimentation defaillante ou une surchauffe declenchant une protection materielle.`n`nEvenement 6008 (EventLog) : plus ancien historiquement, consigne un constat similaire ('le systeme a redemarre sans s'arreter proprement au prealable') mais provenant du service EventLog lui-meme plutot que du noyau - les deux apparaissent generalement ensemble pour le meme incident, pas l'un a la place de l'autre.`n`nUn evenement isole n'est pas forcement inquietant (une vraie coupure de courant, par exemple). Ce qui merite attention, c'est la RECURRENCE : plusieurs occurrences rapprochees dans le temps sont un signal fort a investiguer du cote alimentation (PSU vieillissant ou sous-dimensionne), surchauffe (a verifier via un outil de monitoring materiel, temperatures CPU/GPU), ou pilote bas niveau instable (GPU, chipset) plutot qu'un hasard. Sans rapport avec un arret volontaire via 'Redemarrer le PC'/'Eteindre le PC' de ce meme catalogue - ceux-la passent par la sequence normale et ne generent ni le 41 ni le 6008." }
                @{ Label = "Synchronisation de l'heure"
                   Cmd   = 'w32tm /query /status'
                   Desc  = "Affiche l'etat de synchronisation de l'horloge systeme : source de temps actuelle (serveur NTP, source materielle...), dernier decalage mesure et frequence de synchronisation. Un decalage d'horloge important peut causer des echecs discrets d'authentification (Kerberos), de connexions TLS, ou de taches planifiees, sans message d'erreur explicite pointant vers l'heure elle-meme."
                   Confirm = $false
                   Help  = "La commande interroge le service Windows Time (W32Time), qui synchronise par defaut l'horloge systeme contre un serveur NTP (time.windows.com par defaut, ou un autre serveur si configure via GPO/registre) a une frequence volontairement faible (de l'ordre d'une fois par semaine) - l'horloge materielle (RTC) derive tres peu entre deux synchronisations sur du materiel moderne, une frequence plus elevee n'apporte pas de benefice significatif.`n`nSi la commande renvoie une erreur du type 'le service n a pas ete demarre' plutot qu'un rapport de statut, c'est que le service Windows Time est actuellement arrete. Sur un usage desktop courant, ce service est souvent configure en demarrage declenche a la demande plutot qu'en permanence en arriere-plan, ce qui est normal et pas necessairement une anomalie a corriger.`n`nUn ecart (offset) de quelques centaines de millisecondes est normal et sans consequence. Un ecart de plusieurs secondes ou plus, en revanche, peut effectivement declencher des echecs d'authentification Kerberos (la tolerance par defaut de Windows est de 5 minutes, mais certains services sont plus stricts) ou des erreurs de validation de certificats TLS si la difference est suffisamment importante." }
                @{ Label = "Imprimantes installees"
                   Cmd   = 'powershell -NoExit -Command try { Get-Printer -ErrorAction Stop ^| Select-Object Name,DriverName,PortName,Shared ^| Format-Table -AutoSize } catch { Write-Host ''Aucune imprimante trouvee ou module PrintManagement indisponible.'' -ForegroundColor Yellow }'
                   Desc  = "Liste les imprimantes installees (physiques, virtuelles comme Microsoft Print to PDF, et reseau), avec leur pilote, leur port et si elles sont partagees sur le reseau. Inventaire simple, absent du catalogue jusqu'ici."
                   Confirm = $false
                   Help  = "Inclut aussi bien les imprimantes physiques connectees (USB, reseau) que les imprimantes virtuelles fournies nativement par Windows (Microsoft Print to PDF, Microsoft XPS Document Writer) - ces dernieres sont normales et presentes par defaut sur une installation Windows standard, pas une anomalie.`n`nLa colonne Shared indique si l'imprimante est partagee sur le reseau local, rendant son usage possible depuis d'autres machines - une information utile en audit de surface d'exposition reseau, dans le meme esprit que Partages reseau actifs juste au-dessus dans la categorie Securite rapide (un pilote d'imprimante partage mal configure ou obsolete peut etre un vecteur d'attaque, comme l'a illustre la vulnerabilite PrintNightmare)." }
            )
        }
    )
}
