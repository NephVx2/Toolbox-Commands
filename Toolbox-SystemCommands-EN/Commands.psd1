# ==============================================================================
# Commands.psd1 - Command catalog for Toolbox-SystemCommands.ps1
# ==============================================================================
# PowerShell data file (loaded via Import-PowerShellDataFile, in "restricted
# language" mode: no variables, no code execution is possible here, only
# literals (strings, numbers, $true/$false, arrays @(), hash tables @{})).
#
# IMPORTANT - "Cmd" field:
# Always use SINGLE QUOTES ('...') for the Cmd field, never double quotes
# ("..."). Single quotes are NEVER interpolated by PowerShell: a $_, $err, or
# any other variable stays strictly literal in them and is passed through
# as-is to the child command. This is what fixed several historical bugs
# (v1.4.3: unescaped $_ in "Top RAM processes"; similar risks around v1.4.4).
# Never go back to double quotes for Cmd, even for a one-off need.
# If the text itself contains a single quote (e.g. Where-Object Status -eq
# 'Error'), double it: '' (two consecutive single quotes).
#
# Each command: Label (button text), Cmd (command run),
# Desc (explanation shown), Confirm (asks for a Yes/No confirmation
# before launching, $true/$false).
# ==============================================================================
@{
    Categories = @(
        @{
            Name = "System integrity"
            Commands = @(
                @{ Label = "SFC /scannow"
                   Cmd   = 'sfc /scannow'
                   Desc  = "Checks the integrity of all protected system files and automatically replaces corrupted versions with a clean copy (local cache). Duration: 10-20 min."
                   Confirm = $false }
                @{ Label = "SFC /verifyonly"
                   Cmd   = 'sfc /verifyonly'
                   Desc  = "Same check as /scannow but without fixing anything: faster, useful just to diagnose before acting."
                   Confirm = $false }
                @{ Label = "DISM CheckHealth"
                   Cmd   = 'DISM /Online /Cleanup-Image /CheckHealth'
                   Desc  = "Quick check (a few seconds) that indicates whether the Windows image (the component store) is flagged as corrupted, without a deep scan."
                   Confirm = $false }
                @{ Label = "DISM ScanHealth"
                   Cmd   = 'DISM /Online /Cleanup-Image /ScanHealth'
                   Desc  = "Deep scan of the Windows component store (WinSxS) to detect corruption. Longer than CheckHealth (5-10 min), but more reliable."
                   Confirm = $false }
                @{ Label = "DISM RestoreHealth"
                   Cmd   = 'DISM /Online /Cleanup-Image /RestoreHealth'
                   Desc  = "Repairs the component store by downloading clean files via Windows Update. Run this if ScanHealth reports corruption. Requires an internet connection."
                   Confirm = $false }
                @{ Label = "DISM StartComponentCleanup"
                   Cmd   = 'DISM /Online /Cleanup-Image /StartComponentCleanup'
                   Desc  = "Purges old component versions (superseded updates, etc.) from WinSxS to free up disk space. Safe, does not touch active components."
                   Confirm = $false }
                @{ Label = "Repair-WindowsImage RestoreHealth (PS)"
                   Cmd   = 'powershell -NoExit -Command Repair-WindowsImage -Online -RestoreHealth'
                   Desc  = "Native PowerShell equivalent of DISM RestoreHealth. Same result, just a different command if you'd rather stay in a PowerShell context."
                   Confirm = $false }
                @{ Label = "Full Integrity Pack (CHKDSK+DISM+SFC)"
                   Cmd   = 'powershell -NoExit -Command Write-Host; Write-Host; Write-Host ''=== CHKDSK C: /scan ==='' -ForegroundColor Cyan; chkdsk C: /scan; Write-Host; Write-Host; Write-Host ''=== DISM CheckHealth ==='' -ForegroundColor Cyan; DISM /Online /Cleanup-Image /CheckHealth; Write-Host; Write-Host; Write-Host ''=== DISM ScanHealth ==='' -ForegroundColor Cyan; DISM /Online /Cleanup-Image /ScanHealth; Write-Host; Write-Host; Write-Host ''=== SFC /verifyonly ==='' -ForegroundColor Cyan; sfc /verifyonly; Write-Host; Write-Host; Write-Host ''If CHKDSK, DISM, or SFC reported an anomaly above: run DISM RestoreHealth (separate command in the catalog) if the component store is corrupted, then SFC /scannow to repair system files.'' -ForegroundColor Yellow'
                   Desc  = "Chains 4 purely diagnostic checks, with no automatic repair: CHKDSK C: /scan, DISM CheckHealth, DISM ScanHealth, then SFC /verifyonly (checks system file integrity WITHOUT modifying them, unlike /scannow). If an anomaly is reported by any of the 4 steps, a final yellow message reminds you what to do next (DISM RestoreHealth then SFC /scannow, to be run manually via the catalog's separate commands). Each step is announced by a native cyan header (-ForegroundColor Cyan), preceded by 2 blank lines. Duration: 10-20 min depending on the machine."
                   Confirm = $false
                   Help  = "This pack is deliberately 100% diagnostic - none of the 4 steps modifies anything on the system, including SFC, which runs here in /verifyonly (verification) rather than /scannow (repair).`n`nWhy /verifyonly instead of /scannow: SFC /scannow draws on the Windows component store (WinSxS) to replace corrupted system files - if that store is itself corrupted (which DISM ScanHealth can detect just before), an automatic repair would risk pulling from an unreliable source, with no visible error. By staying in /verifyonly, this risk structurally no longer exists: nothing is ever automatically repaired by this pack, only diagnosed. The actual repair (DISM RestoreHealth then SFC /scannow) remains a human decision, made by reading the results shown above and running the corresponding commands separately.`n`nCHKDSK, DISM, and SFC are all three native Windows tools here (chkdsk.exe, dism.exe, sfc.exe) invoked directly - PowerShell only serves as a lightweight wrapper for display (native cyan console headers, -ForegroundColor Cyan, and 2 blank separator lines between each step for readability in the long CHKDSK/DISM/SFC scrolling output). Native cyan is enough here: the rendering depends on the Windows Terminal theme in use, and does not need a dedicated ANSI code on machines where that theme already offers good contrast." }
                @{ Label = "Existing restore points"
                   Cmd   = 'powershell -NoExit -Command try { Get-ComputerRestorePoint ^| Select-Object SequenceNumber,Description,CreationTime,RestorePointType ^| Format-Table -AutoSize } catch { Write-Host ''No restore point found (System Protection is probably disabled on C:).'' -ForegroundColor Yellow }'
                   Desc  = "Lists the available system restore points. Useful to check before running a risky operation (CHKDSK /f, DISM RestoreHealth, Reset Winsock/TCP-IP...) to know whether a rollback is possible. Shows a clear message if System Protection is disabled on C:, instead of a blocking error."
                   Confirm = $false }
                @{ Label = "Create a restore point"
                   Cmd   = 'powershell -NoExit -Command try { Checkpoint-Computer -Description ''Toolbox_manual'' -RestorePointType ''MODIFY_SETTINGS''; Write-Host ''Restore point requested.'' -ForegroundColor Green } catch { Write-Host ''Failed: System Protection (System Restore) is probably disabled on C:.'' -ForegroundColor Red }'
                   Desc  = "Creates a restore point before a risky operation. Non-destructive, no confirmation needed. Note: Windows natively limits creation to one point every 24h (SystemRestorePointCreationFrequency) - a repeated call within that window is silently ignored by Windows itself, not a bug in this command."
                   Confirm = $false }
                @{ Label = "TrustedInstaller service state"
                   Cmd   = 'powershell -NoExit -Command $svc = Get-Service TrustedInstaller; Write-Host (''Current status: '' + $svc.Status + '' - Startup type: '' + $svc.StartType) -ForegroundColor Cyan; if ($svc.StartType -eq ''Manual'' -and $svc.Status -eq ''Stopped'') { Write-Host ''Normal state: this service only starts on demand (SFC, DISM, Windows Update) then stops automatically once the task is finished - staying on Stopped outside of these operations is expected behavior, not an anomaly.'' -ForegroundColor Green } elseif ($svc.StartType -eq ''Disabled'') { Write-Host ''ANOMALY: this service is disabled - SFC, DISM, and Windows Update will fail as long as this service stays disabled.'' -ForegroundColor Red } else { Write-Host ''State to check case by case (see the ? button for details on possible states).'' -ForegroundColor Yellow }'
                   Desc  = "Checks the state of the TrustedInstaller service (Windows Modules Installer), which SFC, DISM, and Windows Update depend on to modify protected system files. Clearly flags whether the observed state (Stopped/Manual) is normal or an anomaly (disabled service), instead of leaving you to guess - a good first check when the Integrity Pack or an update fails unexpectedly."
                   Confirm = $false
                   Help  = "The TrustedInstaller service (displayed name 'Windows Modules Installer') is responsible for installing, modifying, and removing protected Windows components, as well as applying system updates - it actually holds write access to the most sensitive system files, beyond even a classic local Administrator account.`n`nIts normal startup type is 'Manual' (on demand), not 'Automatic': it does not run permanently, only for the duration of an SFC, DISM, or Windows Update operation, then stops on its own once the task is finished. A 'Stopped' status at rest is therefore perfectly normal and does not mean there's a problem - it is, on the contrary, the expected state most of the time.`n`nWhat IS abnormal: a startup type set to 'Disabled'. In that case, SFC /scannow, DISM RestoreHealth, and Windows update installation will systematically fail with unclear errors, with no obvious link to this service on the surface. If an Integrity Pack or an update fails unexpectedly, checking this state first is a useful reflex before digging further." }
                @{ Label = "Filtered CBS.log (SFC repairs)"
                   Cmd   = 'powershell -NoExit -Command $chemin = Join-Path $env:windir ''Logs\CBS\CBS.log''; if (Test-Path $chemin) { $lignes = Select-String -Path $chemin -Pattern ''\[SR\]'' -ErrorAction SilentlyContinue; if ($lignes) { $lignes ^| Select-Object -Last 30 ^| ForEach-Object { Write-Host $_.Line } } else { Write-Host ''No [SR] line found in CBS.log (no recent SFC repair recorded).'' -ForegroundColor Green } } else { Write-Host ''CBS.log file not found.'' -ForegroundColor Yellow }'
                   Desc  = "Filters the CBS.log (Component-Based Servicing) log for lines marked [SR] (Servicing Repair), which detail precisely which files SFC repaired or tried to repair during its last run - finer-grained information than the simple overall result shown by 'SFC /scannow'. Shows the last 30 matching lines."
                   Confirm = $false
                   Help  = "CBS.log is the complete log of all Windows component maintenance operations (SFC, DISM, update installation...) - a file that keeps growing and can quickly reach several dozen MB, mixing in thousands of lines unrelated to SFC. The [SR] (Servicing Repair) marker specifically isolates the lines written by the repair subsystem used by SFC, letting you see precisely which file was identified as corrupted and whether its replacement succeeded or failed - information that 'SFC /scannow' only summarizes as an overall count (X corrupted files found/repaired).`n`nRun this right after an 'SFC /scannow' or 'SFC /verifyonly' for the full detail, instead of manually opening the file (often large) in a text editor. If no [SR] line is found, it's either that no SFC has ever been run on this machine, or that no corruption was ever detected during previous runs." }
            )
        }
        @{
            Name = "Disk"
            Commands = @(
                @{ Label = "CHKDSK C: (read-only)"
                   Cmd   = 'chkdsk C:'
                   Desc  = "Scans the C: drive's file system WITHOUT fixing anything and without dismounting the volume. Safe, runs immediately."
                   Confirm = $false
                   Help  = "Uses the historical CHKDSK engine (present since the earliest days of Windows NT): checks the file system's basic structure - file records (MFT), folder indexes, security descriptors - in three classic stages. Without /f or /scan, no correction is ever written, even if an error is detected: it's a pure diagnostic.`n`nDifference from 'CHKDSK C: /scan' just below: this version does NOT use the newer 'online' verification engine (introduced with Windows 8), and does not integrate with the modern NTFS self-healing system. It's the simpler and faster of the two modes, but also the less thorough - think of it as a surface check, where /scan goes further with better tools." }
                @{ Label = "CHKDSK C: /scan"
                   Cmd   = 'chkdsk C: /scan'
                   Desc  = "Online scan of the volume (the disk stays usable during the scan) that reports errors found, without fixing them or requiring a restart."
                   Confirm = $false
                   Help  = "Uses the 'online' verification engine introduced with Windows 8/Server 2012 - the same engine Windows automatically uses in the background to periodically monitor NTFS volume health. More thorough and more modern than classic CHKDSK, it integrates with the NTFS self-healing system.`n`nDifference from 'CHKDSK C: (read-only)' just above: /scan is the recommended mode today for a serious diagnostic without fixing - more thorough than basic CHKDSK, without the drawbacks of /f /r (no dismounting, no restart needed).`n`nWhat /scan does extra: if corruptions are detected, they are logged to an internal list to be fixed later, rather than lost or immediately requiring a full CHKDSK. The logical next step if a problem is detected would be 'chkdsk C: /spotfix' (not present in this catalog) - a targeted, quick fix of these specific items, which only requires a very brief volume dismount rather than the full, much longer scan+repair of 'CHKDSK C: /f /r (on reboot)' already present in the catalog." }
                @{ Label = "CHKDSK C: /f /r (on reboot)"
                   Cmd   = 'chkdsk C: /f /r'
                   Desc  = "WARNING: schedules a full check AND repair of the disk (including bad sectors) on the NEXT RESTART. The PC will restart in text mode and the operation can take 30 min to several hours depending on disk size."
                   Confirm = $true
                   Help  = "What this command exactly does: /f checks and fixes file system errors (corrupted entries, inconsistent file indexes); /r does everything /f does PLUS a physical scan of every disk sector to locate bad sectors and migrate the affected data. Since drive C: is currently in use by Windows itself, the operation cannot run live: it is scheduled via the registry (BootExecute) and triggers on the next restart, even before Windows loads.`n`nWhat this means in practice: the PC restarts in black-and-white text mode (no graphical interface), the screen shows a percentage progress per stage (4 to 5 stages depending on the file system), and the machine is UNUSABLE for the entire duration - no other use is possible in parallel. Duration varies widely: a few minutes on a small healthy SSD, several hours on a large disk with many sectors to check or errors to fix.`n`nIf you change your mind: right at the start of the restart, Windows shows a countdown of a few seconds with the option to press a key to cancel the scheduled operation - catch this specific window; once the scan has actually started, it's better to let it finish rather than forcing a shutdown (risk of worsening a corruption mid-repair)." }
                @{ Label = "fsutil dirty query C:"
                   Cmd   = 'fsutil dirty query C:'
                   Desc  = "Shows whether the C: volume is marked 'dirty', meaning a CHKDSK is already scheduled for the next startup. Handy to check before re-running /f /r."
                   Confirm = $false }
                @{ Label = "Optimize-Volume ReTrim (SSD)"
                   Cmd   = 'powershell -NoExit -Command Optimize-Volume -DriveLetter C -ReTrim -Verbose'
                   Desc  = "Sends the TRIM command to the SSD to inform it of free blocks to erase internally (maintains long-term performance). Suited to an SSD, not an HDD."
                   Confirm = $false }
                @{ Label = "Optimize-Volume Defrag (HDD)"
                   Cmd   = 'powershell -NoExit -Command try { $lettre = (Read-Host -Prompt ''Drive letter to defragment (e.g. D, without the colon)'').Trim().TrimEnd('':''); $mediaType = (Get-Partition -DriveLetter $lettre -ErrorAction Stop ^| Get-Disk ^| Get-PhysicalDisk).MediaType; if ($mediaType -eq ''HDD'') { Write-Host ($lettre + '' : detected as HDD, starting defragmentation...'') -ForegroundColor Green; Optimize-Volume -DriveLetter $lettre -Defrag -Verbose } else { Write-Host ($lettre + '' : detected as '' + $mediaType + '' - defragmentation refused for safety. Only a confirmed HDD is accepted; use the ReTrim command instead if this is an SSD.'') -ForegroundColor Red } } catch { Write-Host (''Error: '' + $_.Exception.Message) -ForegroundColor Red }'
                   Desc  = "Asks for the drive letter to defragment, automatically checks its real media type (SSD/HDD/Unspecified) via Get-PhysicalDisk, and refuses to run defragmentation if it's not a confirmed HDD - protection against accidentally defragmenting an SSD, which provides no benefit and needlessly wears its write cycles. Duration varies with disk size and fragmentation level (from a few minutes to over an hour)."
                   Confirm = $false
                   Help  = "Media type detection goes through the Get-Partition -> Get-Disk -> Get-PhysicalDisk chain (standard association from Windows' Storage module), which reads the MediaType property of the actual physical disk behind the chosen drive letter.`n`nThree possible outcomes:`n- HDD: defragmentation runs normally.`n- SSD: refused, with a suggestion to use 'Optimize-Volume ReTrim (SSD)' instead.`n- Unspecified: also refused out of caution - this status sometimes appears on certain external/USB disks or configurations where Windows cannot determine the type with certainty; better to check manually (Disk Management, manufacturer specs) before forcing defragmentation in that case.`n`nIf the entered drive letter doesn't exist, a clear error message is shown instead of a crash." }
                @{ Label = "SMART status of disks"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_DiskDrive ^| Select-Object Model,Status,Size ^| Format-Table -AutoSize'
                   Desc  = "Shows each physical disk's model, size, and SMART status ('OK' if healthy). A simple first alert for a drive nearing end of life. (Replaces wmic, removed by default since Windows 11 24H2)."
                   Confirm = $false }
                @{ Label = "Detailed disk status"
                   Cmd   = 'powershell -NoExit -Command Get-PhysicalDisk ^| Select-Object FriendlyName,MediaType,Size,HealthStatus,OperationalStatus ^| Format-Table -AutoSize'
                   Desc  = "Fuller view than the simple SMART status: media type (SSD/HDD auto-detected), size, and above all HealthStatus + OperationalStatus, which distinguish a degraded-but-functional disk from an outright failed one."
                   Confirm = $false }
                @{ Label = "Real-time disk latency"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_PerfFormattedData_PerfDisk_PhysicalDisk ^| Where-Object { $_.Name -eq ''_Total'' } ^| Select-Object Name,AvgDisksecPerTransfer,AvgDiskQueueLength,PercentDiskTime ^| Format-List'
                   Desc  = "Instant measurement of disk performance under current load (not SMART health - see 'Detailed disk status' for that): AvgDisksecPerTransfer = average latency per operation (a healthy SSD is generally well under 0.005s), AvgDiskQueueLength = operations waiting (close to 0-1 = healthy), PercentDiskTime = % of time the disk is busy. Uses a WMI class (fixed English property names) instead of Get-Counter, whose counter paths are localized and would have failed on a French-language Windows machine."
                   Confirm = $false }
                @{ Label = "Check active TRIM support"
                   Cmd   = 'powershell -NoExit -Command $sortie = fsutil behavior query DisableDeleteNotify; foreach ($ligne in $sortie) { if ($ligne -match ''(\S+) DisableDeleteNotify = (\d)'') { $fs = $matches[1]; $val = $matches[2]; $etat = if ($val -eq ''0'') { ''TRIM active (Windows notifies the SSD of blocks to erase)'' } else { ''TRIM DISABLED (not recommended on an SSD)'' }; Write-Host ($fs + '' : '' + $etat) } }'
                   Desc  = "Checks whether TRIM support is active at the system level (NTFS and ReFS separately): does Windows continuously notify the SSD of deleted data blocks to erase internally, an ongoing background behavior rather than a one-off pass like 'Optimize-Volume ReTrim (SSD)' just above. Translates the 0/1 values returned by fsutil, whose meaning is counter-intuitive (0 = active, 1 = disabled)."
                   Confirm = $false
                   Help  = "The fsutil parameter's name (DisableDeleteNotify) is misleading if you don't read the value carefully: a value of 0 means the disabling is NOT applied, so deletion notifications (TRIM) ARE sent normally to the SSD - and conversely, 1 means TRIM is actually disabled. This command directly translates the two into 'active'/'DISABLED' to avoid any confusion when reading.`n`nDifference from 'Optimize-Volume ReTrim (SSD)' just above in the catalog: ReTrim triggers a manual, one-off TRIM pass on a specific drive, the moment you run it. This command instead checks the ongoing system behavior: does Windows send these notifications continuously, as the machine is used normally (every file deletion), with no manual action. The two are complementary, not redundant: an active system TRIM makes manual ReTrim less necessary day-to-day, but a one-off ReTrim is still useful after an unusual operation (large deletion, disk image restore) even if system TRIM is active.`n`nOn a standard SSD, whether SATA or NVMe, TRIM should normally be active by default with no action needed - a DISABLED value here would be the sign of a prior manual change (or third-party software having disabled it), not standard Windows behavior needing a different fix." }
                @{ Label = "Disk error history (IDs 7/11/51)"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''System''; ProviderName=''disk''; Id=7,11,51} -MaxEvents 10 -ErrorAction Stop ^| Select-Object TimeCreated,@{N=''Type'';E={switch($_.Id){7{''ID 7 - Bad sector detected''} 11{''ID 11 - Error reported by the disk controller''} 51{''ID 51 - Read or write error (page file or regular file)''} default{''ID '' + $_.Id}}}},Message ^| Format-List } catch { Write-Host ''No disk error (IDs 7/11/51) found in the System log (good sign).'' -ForegroundColor Green }'
                   Desc  = "Lists the last 10 low-level disk errors (IDs 7, 11, 51, source 'disk') logged in the System log: bad sectors, controller-reported errors, read/write failures. An early signal distinct from the overall SMART status ('SMART status of disks'): SMART can still show OK while these individual events are already piling up in the background. Shows a clear message if no error is found, instead of a blocking error."
                   Confirm = $false
                   Help  = "These three IDs are among the oldest and most reliable disk errors in Windows, present since the very first NT event logs, long before SMART was natively exposed by modern tools:`n`n- ID 7: the disk driver detected a bad sector during a read or write operation. An isolated event can happen even on a healthy disk (sector automatically reallocated by the disk itself, a transparent mechanism); repeated, closely-spaced occurrences indicate real physical degradation.`n`n- ID 11: the disk driver reported an error from the controller (generic I/O error) - a failing cable/connection, unstable power, or a SATA/NVMe controller issue depending on the case, not necessarily the disk itself at fault.`n`n- ID 51: a read or write error on a paging operation (swap file) or a regular file - can occur on a drive nearing end of life, but also occasionally during an abrupt shutdown mid-write, without systematically being a sign of a failing disk.`n`nNone of these events taken in isolation is automatically alarming - it's the FREQUENCY and RECURRENCE over several days or weeks that make up the real signal to watch, exactly like for 'Unexpected shutdown/restart history' in the Miscellaneous category. If in doubt, cross-reference with 'SMART status of disks' and 'Detailed disk status' (HealthStatus/OperationalStatus) for a fuller picture." }
            )
        }
        @{
            Name = "Network"
            Commands = @(
                @{ Label = "Flush DNS"
                   Cmd   = 'ipconfig /flushdns'
                   Desc  = "Clears the local DNS cache. Useful after changing DNS server (e.g. NextDNS) or in case of incorrect/stale name resolution."
                   Confirm = $false }
                @{ Label = "Show full IP config"
                   Cmd   = 'ipconfig /all'
                   Desc  = "Shows detailed network configuration for every interface: IP addresses, gateway, DNS servers, MAC addresses, DHCP lease."
                   Confirm = $false }
                @{ Label = "Reset Winsock"
                   Cmd   = 'netsh winsock reset'
                   Desc  = "WARNING: resets the Winsock stack (network protocol catalog). Use in case of persistent connectivity issues. REQUIRES A RESTART to take effect."
                   Confirm = $true
                   Help  = "The Winsock catalog is the ordered list of 'service providers' (LSP - Layered Service Providers) Windows uses for every network connection: it's the layer just above the network card itself, before applications see the data. Some software (VPNs, some antivirus with a 'network shield', parental control software) inserts itself into this chain - and a badly uninstalled or corrupted LSP can break ALL internet connectivity, even if the network card itself works perfectly.`n`nWhat the command does: rebuilds this catalog to its Windows default state, removing every third-party LSP that had inserted itself into it.`n`nWhat this means in practice: if you use a VPN, an antivirus with active network filtering, or any software that hooks into the network stack, you'll probably need to reinstall or re-enable it afterward - its own LSP will have been wiped along with the rest. Does NOT fix a hardware problem (faulty network card, cable, driver) or a router/modem problem - only issues located in this specific Windows software layer." }
                @{ Label = "Reset TCP/IP stack"
                   Cmd   = 'netsh int ip reset'
                   Desc  = "WARNING: completely resets the TCP/IP configuration to its default state (equivalent to reinstalling the network stack). Use as a last resort. REQUIRES A RESTART."
                   Confirm = $true
                   Help  = "Different from 'Reset Winsock' (which targets the LSP catalog): this one resets the TCP/IP protocol itself - the mechanism that breaks up and routes data on the network. It's a deeper, broader layer than Winsock.`n`nWhat this means in practice: any custom network configuration on your interfaces (static IP address, manual DNS servers, custom gateway, advanced settings like TCP window size) is wiped and reverts to automatic configuration (DHCP). If you had set a fixed IP or custom DNS (a manually configured third-party DNS provider, for instance), you'll need to reconfigure them afterward. No effect on hardware (network card, driver) - only the protocol's software configuration.`n`nOnly use this if 'Reset Winsock' wasn't enough to fix the problem - it's a more drastic tool, not the first thing to try." }
                @{ Label = "Renew IP lease"
                   Cmd   = 'ipconfig /release && ipconfig /renew'
                   Desc  = "Releases then re-requests an IP address from the DHCP server. Useful if the current IP seems to be in conflict or stale."
                   Confirm = $false }
                @{ Label = "Active connections (netstat)"
                   Cmd   = 'netstat -ano'
                   Desc  = "Lists all active network connections with the associated process PID. Useful for identifying what's currently communicating on the network."
                   Confirm = $false }
                @{ Label = "ARP table"
                   Cmd   = 'arp -a'
                   Desc  = "Shows the IP <-> MAC address mapping table for devices recently contacted on the local network."
                   Confirm = $false }
                @{ Label = "NextDNS test (test.nextdns.io)"
                   Cmd   = 'curl.exe -L https://test.nextdns.io'
                   Desc  = "Official NextDNS test: checks whether the machine's DNS traffic actually goes through NextDNS (including WFP interception by the desktop app), the protocol used (DoH/DoT/DoQ), and the nearest point of presence. 'status: ok' = active, 'status: unconfigured' = not currently in use."
                   Confirm = $false }
                @{ Label = "DNS configured per interface"
                   Cmd   = 'powershell -NoExit -Command Get-DnsClientServerAddress ^| Format-Table -AutoSize'
                   Desc  = "Shows the DNS server(s) declared on each network interface. Useful for generic diagnostics (a machine without NextDNS, another resolver); does not detect transparent interception like the NextDNS Desktop app (see NextDNS test above for that case)."
                   Confirm = $false }
                @{ Label = "Network adapter status"
                   Cmd   = 'powershell -NoExit -Command Get-NetAdapter ^| Format-Table -AutoSize'
                   Desc  = "Lists network interfaces with their status (Up/Down) and link speed."
                   Confirm = $false }
                @{ Label = "Current DNS cache"
                   Cmd   = 'ipconfig /displaydns'
                   Desc  = "Shows the current contents of the local DNS cache, entry by entry, before deciding to clear it with Flush DNS. Useful for pinpointing a stale or incorrect entry."
                   Confirm = $false }
                @{ Label = "Saved Wi-Fi networks"
                   Cmd   = 'netsh wlan show profiles'
                   Desc  = "Lists the Wi-Fi profiles saved on the machine, without showing passwords (the explicit 'key=clear' option is needed for that, absent here for safety). Returns a normal error if the Wi-Fi service (wlansvc) is disabled or no wireless adapter is present."
                   Confirm = $false }
                @{ Label = "Current Wi-Fi speed"
                   Cmd   = 'netsh wlan show interfaces'
                   Desc  = "Shows the status of the active Wi-Fi connection: signal, band (2.4/5 GHz), current link rate. Complementary to 'Saved Wi-Fi networks' (which lists known profiles, not the current connection). Normal error message if no active wireless interface."
                   Confirm = $false }
                @{ Label = "Public IP address"
                   Cmd   = 'curl.exe -s https://api.ipify.org'
                   Desc  = "Shows the machine's current public IP address, via an HTTPS request to the third-party service api.ipify.org (same external-request principle as 'NextDNS test' above). Useful after a network or VPN config change to confirm which IP you're actually exiting through."
                   Confirm = $false }
                @{ Label = "Multi-level connectivity diagnostic"
                   Cmd   = 'powershell -NoExit -Command $gw = (Get-NetRoute -DestinationPrefix ''0.0.0.0/0'' -ErrorAction SilentlyContinue ^| Sort-Object RouteMetric ^| Select-Object -First 1 -ExpandProperty NextHop); if (-not $gw) { $gw = ''not found'' }; $cibles = @(@{Nom=''Local gateway''; Hote=$gw}, @{Nom=''Public DNS (1.1.1.1)''; Hote=''1.1.1.1''}, @{Nom=''External site (microsoft.com)''; Hote=''www.microsoft.com''}); $cibles ^| ForEach-Object { $joignable = if ($_.Hote -eq ''not found'') { $false } else { Test-NetConnection -ComputerName $_.Hote -InformationLevel Quiet -WarningAction SilentlyContinue }; [PSCustomObject]@{Target=$_.Nom; Host=$_.Hote; Reachable=$joignable} } ^| Format-Table -AutoSize'
                   Desc  = "Tests reachability of 3 targets at different levels (local gateway, public DNS 1.1.1.1, external site) to quickly locate the source of a connectivity outage: unreachable gateway = local problem (Wi-Fi/cable/network card), gateway OK but 1.1.1.1 unreachable = problem on the ISP/router side, 1.1.1.1 OK but external site unreachable = a DNS resolution problem specifically rather than a general outage."
                   Confirm = $false
                   Help  = "The logic of this diagnostic is to test the connectivity chain layer by layer rather than limiting things to a single 'it works / it doesn't' test:`n`n1. Local gateway (retrieved automatically via the routing table): if unreachable, the problem lies before even leaving the local network - network card, cable, Wi-Fi, or the router/modem itself turned off or down.`n`n2. 1.1.1.1 (Cloudflare public DNS, tested by direct IP so with no dependency on DNS resolution): if the gateway responds but not this target, the problem is typically on the ISP side or on the link between the modem and the internet, not on the local network.`n`n3. www.microsoft.com (external target tested by name, so dependent on DNS resolution): if 1.1.1.1 responds but not this last target, the problem is probably isolated to DNS resolution (configured DNS server down, overly aggressive DNS filtering, corrupted cache) rather than network connectivity itself - worth cross-referencing with 'Current DNS cache' and 'Flush DNS' in that case.`n`nA 'not found' result for the gateway means no default route was detected on the machine (network card disabled, no interface connected) - this is not an error in the command itself." }
                @{ Label = "TCP connections with process"
                   Cmd   = 'powershell -NoExit -Command Get-NetTCPConnection -State Established,Listen -ErrorAction SilentlyContinue ^| Select-Object LocalAddress,LocalPort,RemoteAddress,RemotePort,State,@{N=''Process'';E={(Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).ProcessName}},OwningProcess ^| Sort-Object State,Process ^| Format-Table -AutoSize'
                   Desc  = "Equivalent of 'Active connections (netstat)' but with the process name already resolved into a dedicated column (Process), rather than a bare PID you have to look up yourself in Task Manager. Limited to established and listening connections (State Established/Listen), to avoid the noise of transient connections (TimeWait, CloseWait) that often clutter netstat's raw output."
                   Confirm = $false
                   Help  = "Get-NetTCPConnection is the native PowerShell replacement for netstat, with a key advantage used here: every connection directly exposes the OwningProcess property (the PID), which can be resolved into a readable process name via Get-Process in the same command - whereas netstat -ano only shows the raw PID, forcing you to look it up separately in Task Manager or via a separate command.`n`nThe filter on State Established (active connection, data currently being exchanged) and Listen (port listening, waiting for an incoming connection) deliberately excludes transient states like TimeWait or CloseWait, which represent connections in the process of closing normally and mostly just add visual noise with little diagnostic value in most common use cases.`n`nUseful for quickly identifying which software opened which port, in case of a port conflict, suspicious network behavior to investigate, or simply to concretely check what's communicating on the network at a given moment." }
                @{ Label = "MTU of network interfaces"
                   Cmd   = 'powershell -NoExit -Command Get-NetIPInterface -ErrorAction SilentlyContinue ^| Where-Object ConnectionState -eq ''Connected'' ^| Select-Object InterfaceAlias,AddressFamily,NlMtu,ConnectionState ^| Sort-Object InterfaceAlias ^| Format-Table -AutoSize'
                   Desc  = "Shows the MTU (Maximum Transmission Unit) size currently configured on each connected network interface, for IPv4 and IPv6 separately. Useful for diagnosing specific symptoms like web pages loading partially, unstable VPN connections, or transfers failing on large packets while small requests go through normally."
                   Confirm = $false
                   Help  = "MTU defines the maximum size (in bytes) a network packet can reach on a given interface before being fragmented into several smaller pieces. The Ethernet standard value is 1500 - a different value is not automatically an anomaly, but can become one depending on context (VPN interfaces, certain virtual adapters, or a past manual configuration).`n`nWhat this means in practice when MTU is poorly matched along the network path (typically more common with a VPN tunnel, which adds its own encapsulation overhead on top of the data): small packets (DNS requests, connection start) go through normally, but large packets (image loading, file transfers, video streams) fail or partially stall - a characteristic symptom that points to this specific setting rather than a general connectivity outage.`n`nWorth cross-referencing with the 'Multi-level connectivity diagnostic' above: if that one shows working connectivity but certain specific uses (often large data volumes) still fail, checking the MTU on the interface involved is a relevant lead to explore before looking further." }
                @{ Label = "Hosts file content"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Shows the full content of the hosts file (C:\Windows\System32\drivers\etc\hosts) with a count of active lines (excluding comments and blank lines) as a summary. Lets you quickly verify on a given machine that no entry has been added, changed, or removed compared to what's expected."
                   Confirm = $false
                   Help  = "The hosts file is a domain-name-to-IP-address mapping table, consulted by Windows before any DNS query - an entry present there (e.g. 'example.domain 0.0.0.0') completely bypasses normal DNS resolution for that domain. This is a commonly used system-level blocking technique (ads, tracking, telemetry): effective because it's independent of the browser or application, but also easily forgotten or out of sync across several machines in the same fleet.`n`nBy default on a clean Windows install, the file only contains comment lines (prefixed with #) and generally no active entry - an unexpectedly high 'active lines' count, or conversely zero (if a block is supposed to be in place), are the two most useful signals to watch for here.`n`nThis command is read-only: no change is made to the file. Any correction (adding/removing entries) still has to be done manually (editing requires administrator rights, the file being write-protected by default)." }
            )
        }
        @{
            Name = "Windows Update"
            Commands = @(
                @{ Label = "Reset WU components"
                   Cmd   = 'net stop wuauserv && net stop bits && ren %windir%\SoftwareDistribution SoftwareDistribution.bak && net start wuauserv && net start bits'
                   Desc  = "WARNING: stops the Windows Update services, renames the update cache folder (it will be regenerated empty) then restarts the services. Fixes most Windows Update blockages but clears the currently downloaded history."
                   Confirm = $true
                   Help  = "The SoftwareDistribution folder is Windows Update's local cache: already downloaded (partially or fully) update files and catalog metadata. It's often the cause of a Windows Update that's stuck or looping on an error: a corrupted file in this cache blocks the rest of the process.`n`nWhat the command does, step by step: stops the two services involved (wuauserv = Windows Update itself, bits = the background transfer service used for downloads), renames the existing folder to .bak (it is NOT deleted, just set aside), then restarts the services - Windows then automatically recreates an empty SoftwareDistribution folder and starts fresh.`n`nWhat this means in practice: any update currently downloading has to start over entirely from scratch (no partial resume). Updates ALREADY installed are not affected. The old .bak folder stays on disk and takes up space - you can delete it manually later once you've confirmed everything works normally again, otherwise it accumulates across repeated uses of this command." }
                @{ Label = "Analyze the component store"
                   Cmd   = 'DISM /Online /Cleanup-Image /AnalyzeComponentStore'
                   Desc  = "Analyzes the WinSxS folder and indicates whether a cleanup (StartComponentCleanup) is recommended, with the estimated space that can be reclaimed."
                   Confirm = $false }
                @{ Label = "Force a Windows Update scan"
                   Cmd   = 'UsoClient StartScan'
                   Desc  = "Triggers an immediate scan for available updates, without touching services or the cache. Lighter than a full reset."
                   Confirm = $false }
                @{ Label = "Reset Microsoft Store"
                   Cmd   = 'wsreset.exe'
                   Desc  = "Clears the Microsoft Store cache (no window appears, the app closes then reopens after a few seconds). Fixes Store app download/update blockages."
                   Confirm = $false }
                @{ Label = "Last installed updates"
                   Cmd   = 'powershell -NoExit -Command Get-HotFix ^| Sort-Object InstalledOn -Descending ^| Select-Object -First 10 ^| Format-Table -AutoSize'
                   Desc  = "Lists the last 10 installed Windows updates with their date. Handy for checking what changed right before a problem appeared."
                   Confirm = $false }
                @{ Label = "Windows Update registry values"
                   Cmd   = 'powershell -NoExit -Command $key = ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate''; if (Test-Path $key) { Get-ItemProperty $key ^| Format-List * } else { Write-Host ''Windows Update policy key absent (no policy applied).'' -ForegroundColor Yellow }'
                   Desc  = "Shows every registry value under the Windows Update policy key, to verify a change (GPO, script, manual setting) is actually active. Clear message if the key doesn't exist on the machine (no policy applied), instead of a blocking error."
                   Confirm = $false }
                @{ Label = "Windows Update error history"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''Microsoft-Windows-WindowsUpdateClient/Operational'';Level=2} -MaxEvents 10 ^| Select-Object TimeCreated,Id,Message ^| Format-List } catch { Write-Host ''No Windows Update error found in the log.'' -ForegroundColor Green }'
                   Desc  = "Lists the last 10 errors (Error level only) from the Windows Update log, with their full message. Complementary to 'Last installed updates': that one says what succeeded, this one says what failed and why. Clear message if no error is found, instead of a blocking error on an empty log."
                   Confirm = $false }
                @{ Label = "SoftwareDistribution cache size"
                   Cmd   = 'powershell -NoExit -Command $dossier = Join-Path $env:windir ''SoftwareDistribution''; if (Test-Path $dossier) { $taille = (Get-ChildItem $dossier -Recurse -Force -ErrorAction SilentlyContinue ^| Measure-Object -Property Length -Sum).Sum; $tailleMo = [math]::Round($taille/1MB,1); Write-Host (''Current SoftwareDistribution cache: '' + $tailleMo + '' MB'') -ForegroundColor Cyan } else { Write-Host ''SoftwareDistribution folder not found.'' -ForegroundColor Yellow }; $dossierBak = Join-Path $env:windir ''SoftwareDistribution.bak''; if (Test-Path $dossierBak) { $tailleBak = (Get-ChildItem $dossierBak -Recurse -Force -ErrorAction SilentlyContinue ^| Measure-Object -Property Length -Sum).Sum; $tailleBakMo = [math]::Round($tailleBak/1MB,1); Write-Host (''Old SoftwareDistribution.bak folder found: '' + $tailleBakMo + '' MB - left by a previous WU component reset, safe to delete manually if everything has worked normally since'') -ForegroundColor Yellow }'
                   Desc  = "Calculates the current size of the SoftwareDistribution cache folder (update files already downloaded, partially or fully, plus catalog metadata) and flags along the way if an old .bak folder exists (left by a previous 'Reset WU components'). Useful before running a reset to know how much in-progress download would be lost, and to spot a forgotten .bak folder needlessly taking up disk space."
                   Confirm = $false
                   Help  = "SoftwareDistribution can legitimately weigh several GB, especially right after a major feature update (like 24H2) whose files aren't always cleaned up immediately after installation. A large size is therefore not necessarily a sign of a problem to fix - it's mainly context information before deciding to run 'Reset WU components' (which renames this folder and forces Windows to redownload everything from scratch on the next scan).`n`nThe second block of this command specifically checks for the existence of SoftwareDistribution.bak: this exact name is the one 'Reset WU components' creates by renaming the old folder instead of deleting it. Since this .bak folder is never automatically cleaned up afterward (a reminder already present in 'Reset WU components' Help), it can silently accumulate across repeated uses of that reset if you don't delete it manually from time to time once you've confirmed everything works normally." }
                @{ Label = "Restart pending required?"
                   Cmd   = 'powershell -NoExit -Command $motifs = @(); if (Test-Path ''HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending'') { $motifs += ''Windows components (CBS) pending finalization'' }; if (Test-Path ''HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired'') { $motifs += ''Windows Update reports a restart is required'' }; $pfro = Get-ItemProperty -Path ''HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager'' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue; if ($pfro -and $pfro.PendingFileRenameOperations) { $motifs += ''Pending file rename operations (PendingFileRenameOperations)'' }; if ($motifs.Count -gt 0) { Write-Host ''Restart required: YES'' -ForegroundColor Red; foreach ($m in $motifs) { Write-Host (''  - '' + $m) -ForegroundColor Yellow } } else { Write-Host ''Restart required: NO (no pending-restart indicator detected)'' -ForegroundColor Green }'
                   Desc  = "Checks at a glance whether the machine is waiting on a restart to finalize changes already applied, by cross-referencing three distinct indicators: Windows components (CBS) pending, Windows Update reporting a restart required, and pending file rename operations (PendingFileRenameOperations, also used by classic installers). A frequent case after an Integrity Pack, SFC/DISM, or an update installation - answers the question directly instead of restarting blindly just to check."
                   Confirm = $false
                   Help  = "Three distinct locations are checked, because none alone is 100% reliable to cover every case:`n`n1. Component Based Servicing\RebootPending (key present or not, its value doesn't matter): signals that the Windows component store (WinSxS) has changes that cannot be finalized without a restart - typically after DISM RestoreHealth or a cumulative update.`n`n2. WindowsUpdate\Auto Update\RebootRequired: indicator set directly by the Windows Update service itself after installing an update that needs a restart to fully activate.`n`n3. PendingFileRenameOperations (Session Manager): list of files an installer couldn't replace directly (file locked while in use) that Windows will rename/replace at the next startup, before anything else loads. Used by many classic installers, not just Windows Update - a value present here can therefore also come from a recent software install, not only a system update.`n`nIf all three indicators are negative, no restart is needed for now - but that doesn't guarantee no process is still running with an old version of a file already replaced on disk (a rarer case, and harder to detect generically)." }
            )
        }
        @{
            Name = "Performance"
            Commands = @(
                @{ Label = "Startup applications"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_StartupCommand ^| Select-Object Name,Command,Location ^| Format-Table -AutoSize'
                   Desc  = "Lists programs configured to launch automatically when Windows starts. Useful for spotting what's slowing down boot."
                   Confirm = $false }
                @{ Label = "Detailed boot time"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''Microsoft-Windows-Diagnostics-Performance/Operational'';Id=100} -MaxEvents 5 ^| Select-Object TimeCreated,Message ^| Format-List } catch { Write-Host ''No boot time event found in the log.'' -ForegroundColor Yellow }'
                   Desc  = "Shows the detailed duration of the last 5 Windows boots via the Diagnostics-Performance log, complementary to 'Startup applications' which instead lists what launches. Clear message if the log has no matching event, instead of a blocking error (same defensive logic as the historical Get-PnpDevice fix)."
                   Confirm = $false }
                @{ Label = "Overall PC score (WinSAT)"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_WinSAT ^| Select-Object CPUScore,D3DScore,DiskScore,GraphicsScore,MemoryScore,WinSPRLevel,@{N=''State'';E={switch($_.WinSATAssessmentState){0{''Unknown''};1{''Valid''};2{''Invalid (hardware changed)''};3{''Unavailable''};4{''Invalid''};default{''Unknown''}}}} ^| Format-List'
                   Desc  = "WinSAT scores per component (CPU, D3D=3D/gaming, Disk, Graphics=2D desktop rendering, Memory) plus the overall WinSPRLevel score (= the lowest sub-score, the real bottleneck). 'State' field translated in plain terms: 'Valid' means an up-to-date assessment consistent with the current hardware. On a hybrid Intel/NVIDIA setup, a gap between D3DScore and GraphicsScore is normal (two different graphics chips involved). Rarely updates automatically (since Windows 8.1) - rerun 'winsat formal' manually after a major hardware change if the score seems inconsistent or State is not 'Valid'."
                   Confirm = $false }
                @{ Label = "Recent system errors"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''System'';Level=1,2} -MaxEvents 10 ^| Select-Object TimeCreated,Id,LevelDisplayName,ProviderName,Message ^| Format-List } catch { Write-Host ''No recent error/critical event found in the System log.'' -ForegroundColor Green }'
                   Desc  = "Lists the last 10 Critical or Error level events from the System log. A light, quick complement, not a replacement for a dedicated analysis tool (MITRE tagging, spike detection, filtering of known noisy sources) if such a script exists elsewhere. Clear message if no matching event is found."
                   Confirm = $false }
                @{ Label = "Startup applications (scheduled tasks)"
                   Cmd   = 'powershell -NoExit -Command Get-ScheduledTask ^| Where-Object { $_.State -eq ''Ready'' -and $_.Triggers.CimClass.CimClassName -contains ''MSFT_TaskLogonTrigger'' } ^| Select-Object TaskName,TaskPath ^| Format-Table -AutoSize'
                   Desc  = "Lists scheduled tasks configured to launch on logon. Complementary to 'Startup applications' (which only covers the Startup folder and registry Run keys): a lot of software (updaters, various agents) uses a scheduled task instead, a common blind spot if you only look at one or the other."
                   Confirm = $false }
                @{ Label = "Active scheduled tasks (excluding logon)"
                   Cmd   = 'powershell -NoExit -Command try { $taches = Get-ScheduledTask -ErrorAction Stop ^| Where-Object { $_.State -eq ''Ready'' -and $_.TaskPath -notlike ''\Microsoft\Windows\*'' -and $_.Triggers.CimClass.CimClassName -notcontains ''MSFT_TaskLogonTrigger'' }; if ($taches) { $taches ^| Select-Object TaskName,TaskPath,@{N=''NextRunTime'';E={(Get-ScheduledTaskInfo -TaskName $_.TaskName -TaskPath $_.TaskPath -ErrorAction SilentlyContinue).NextRunTime}} ^| Sort-Object TaskPath ^| Format-Table -AutoSize -Wrap } else { Write-Host ''No active scheduled task outside logon triggers and outside internal Microsoft tasks.'' -ForegroundColor Green } } catch { Write-Host ''Unable to retrieve the scheduled task list.'' -ForegroundColor Red }'
                   Desc  = "Lists currently active scheduled tasks (Ready state) that do NOT trigger on logon (already covered by 'Startup applications (scheduled tasks)' just above) and that aren't part of Microsoft's internal tasks (Microsoft\Windows folder, several hundred by default on any standard Windows install, excluded to avoid noise). Only third-party tasks on a time-based, daily, or event trigger remain - typically installed by software (auto-updaters, sync agents, third-party telemetry) and potentially forgotten over time."
                   Confirm = $false
                   Help  = "A standard Windows install contains several hundred internal scheduled tasks under Microsoft\Windows (maintenance, diagnostics, system telemetry...) which are normal and should not be modified - they are excluded by default from this command to show only what has been added by third-party software or the user.`n`nThis command also excludes tasks triggered on logon (already covered by 'Startup applications (scheduled tasks)'), to focus specifically on tasks that run independently of an open session: on a fixed schedule (daily, weekly...), at the system's own startup (not user logon), on a specific system event, or as a periodic background task. These are often the least visible day-to-day since they generate neither a taskbar icon nor a window when a session starts.`n`nThe NextRunTime column shows when the task is due to run next - an empty or very distant value can indicate a task disabled at the trigger level (different from the task's overall Ready state) or a misconfigured trigger.`n`nWorth cross-referencing with Task Scheduler (taskschd.msc) to disable or delete a task identified as unneeded - this command is read-only and changes nothing." }
                @{ Label = "Hardware virtualization state (Hypervisor / VBS)"
                   Cmd   = 'powershell -NoExit -Command $hv = if ((Get-CimInstance Win32_ComputerSystem).HypervisorPresent) { ''Yes'' } else { ''No'' }; Write-Host (''Hypervisor present: '' + $hv) -ForegroundColor Green; try { $dg = Get-CimInstance -Namespace ''root\Microsoft\Windows\DeviceGuard'' -ClassName Win32_DeviceGuard -ErrorAction Stop; Write-Host (''VirtualizationBasedSecurityStatus (VBS): '' + $dg.VirtualizationBasedSecurityStatus + '' (0=VBS disabled, 1=configured but not started, 2=active)'') -ForegroundColor Green; Write-Host (''SecurityServicesConfigured: '' + ($dg.SecurityServicesConfigured -join '', '') + '' (0=none, 1=Credential Guard, 2=HVCI/memory integrity, 3=System Guard, 4=SMM Firmware Measurement)'') -ForegroundColor Green; Write-Host (''SecurityServicesRunning: '' + ($dg.SecurityServicesRunning -join '', '') + '' (0=none, 1=Credential Guard, 2=HVCI/memory integrity, 3=System Guard, 4=SMM Firmware Measurement)'') -ForegroundColor Green } catch { Write-Host ''VBS (Device Guard) info not available on this Windows edition/version.'' -ForegroundColor Yellow }'
                   Desc  = "Shows whether a hypervisor (Hyper-V, VBS...) is currently running (Yes/No), the native VirtualizationBasedSecurityStatus (VBS) state with its legend, and the detail of security services configured and active on top of it (Credential Guard, HVCI, System Guard...). Important: VirtualizationBasedSecurityStatus=2 only confirms the base VBS layer is running, not that HVCI (value 2 in SecurityServicesRunning) is part of it - the two are independent, the first is a level (0/1/2), the other two are lists of distinct service identifiers (not a scale). System Guard Secure Launch (value 3) can be absent on hardware with firmware older than 2019 (a typical PCR 7 binding failure), even if VBS and HVCI themselves can run normally. Clear message if the DeviceGuard class doesn't exist on this Windows edition, instead of a blocking error."
                   Confirm = $false
                   Help  = "SecurityServicesConfigured / SecurityServicesRunning are NOT a level scale: each number designates a DIFFERENT service, several can appear at once (e.g. '1, 2' = Credential Guard AND HVCI active together).`n`n1 = Credential Guard`nIsolates the process that manages Windows credentials (cached passwords, Kerberos tickets) in a separate virtualized container. Protects against credential theft (pass-the-hash). Mainly targets machines joined to a corporate domain - not very useful for personal use.`n`n2 = HVCI / Memory Integrity`nChecks that code running in kernel mode is signed and unmodified. Blocks malicious code injection via a compromised driver.`n`n3 = System Guard Secure Launch`nCryptographically verifies, via the TPM and a hardware measurement of boot (DRTM), that the firmware hasn't been tampered with even before VBS starts. Can be absent on hardware with firmware older than 2019 (a typical PCR 7 binding failure), independently of the VBS/HVCI state.`n`n4 = SMM Firmware Measurement`nMonitors SMM (System Management Mode), an ultra-privileged CPU mode used by firmware, historically targeted by very stealthy rootkits. More enterprise/certified-hardware oriented." }
                @{ Label = "Disable Memory Integrity (HVCI)"
                   Cmd   = 'reg add HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity /v Enabled /t REG_DWORD /d 0 /f'
                   Desc  = "WARNING: disables Memory Integrity (HVCI), the protection that isolates the Windows kernel against low-level rootkits/malware. Same toggle as Windows Security > Device security > Core isolation > Memory integrity, via the registry. REQUIRES A RESTART to take effect - nothing changes before the next reboot. Purpose: recover the few percent of lost FPS (roughly 8% average measured on recent hardware, varies by game) on a single-player game with no anti-cheat that requires HVCI active. Can be re-enabled with 'Re-enable Memory Integrity (HVCI)' just below. Does not affect VBS as a whole: Credential Guard and other services stay unchanged."
                   Confirm = $true
                   Help  = "Precise mechanism: HVCI relies on the hypervisor to prevent the same memory page from being both writable AND executable at the same time - a technique that blocks a wide class of exploits trying to inject malicious code directly into the Windows kernel via a vulnerable or compromised driver.`n`nWhat disabling it means in practice: the kernel goes back to being protected only by older mechanisms (classic driver signing, without the hypervisor-enforced check). The real risk stays measured: it doesn't make the machine vulnerable by itself, it removes one layer of defense-in-depth specifically effective against kernel-level attacks - which stay rare in personal use compared to phishing or classic malware already blocked by Defender.`n`nThe registry key only takes effect on the next restart - running this command alone, without restarting, changes nothing immediately. The catalog has 'Re-enable Memory Integrity (HVCI)' just below to revert, with the same need to restart." }
                @{ Label = "Re-enable Memory Integrity (HVCI)"
                   Cmd   = 'reg add HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity /v Enabled /t REG_DWORD /d 1 /f'
                   Desc  = "Re-enables Memory Integrity (HVCI) after a gaming performance test, restoring protection against low-level rootkits/malware. REQUIRES A RESTART to take effect. Run this once the FPS test is done, so as not to leave the machine without this protection longer than necessary."
                   Confirm = $true
                   Help  = "Sets the same registry key back to its active value (Enabled=1). As with disabling, nothing changes before the next restart - the protection stays absent until then, even after running this command. No side effect or data loss: it's a fully reversible toggle, not a reinstall or repair." }
                @{ Label = "Disable VBS (Virtualization-Based Security)"
                   Cmd   = 'reg add HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard /v EnableVirtualizationBasedSecurity /t REG_DWORD /d 0 /f'
                   Desc  = "WARNING: disables VBS as a whole (the base hypervisor layer that HVCI and other security services rely on), not just HVCI alone. This amounts to preventing the hypervisor from loading at boot (no extra gain from cutting the hypervisor separately via bcdedit). REQUIRES A RESTART to take effect. Breaks or disables Hyper-V, WSL2, VMware/VirtualBox acceleration, Android emulators, and Docker Desktop if these tools are used on the machine. Potentially bigger gain than HVCI alone (up to 15% measured on some tasks per Tom's Hardware), but a good part of that gap is already captured by disabling HVCI alone - test and compare before concluding there's a real extra gain. Can be re-enabled with 'Re-enable VBS' just below."
                   Confirm = $true
                   Help  = "Precise mechanism: this key cuts the hypervisor layer itself (based on the CPU's VT-x extensions), the foundation both VBS and therefore HVCI rest on. Without this foundation, no security service that depends on it can function, regardless of its own individual setting.`n`nWhat this means in practice, beyond HVCI: unlike disabling HVCI alone (which only touches one specific service), this removes the very ability to use Hyper-V, WSL2, VMware/VirtualBox hardware acceleration, Android emulators (like BlueStacks in hardware mode), or Docker Desktop - these tools need the hypervisor to function and would simply refuse to start while VBS is cut. Check whether any of these are in use on the machine before disabling.`n`nA point of caution found in other users' reports (not guaranteed on every machine): on some configurations, this setting re-enables itself after a restart because of a group policy or a manufacturer lock - more common on a machine joined to a corporate domain. If the setting doesn't 'stick' after a restart, that would be the signal to dig into rather than a sign the command failed." }
                @{ Label = "Re-enable VBS (Virtualization-Based Security)"
                   Cmd   = 'reg add HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard /v EnableVirtualizationBasedSecurity /t REG_DWORD /d 1 /f'
                   Desc  = "Re-enables VBS as a whole after a gaming performance test, restoring the foundation HVCI and other protections rely on. REQUIRES A RESTART to take effect. If HVCI was active before disabling VBS, it becomes active again automatically (its own registry key is not touched by this command)."
                   Confirm = $true
                   Help  = "Sets the EnableVirtualizationBasedSecurity key back to 1, restoring the hypervisor and therefore the ability for VBS/HVCI to function again. As with HVCI alone, no effect before the next restart. Since the HVCI key itself (Scenarios\\HypervisorEnforcedCodeIntegrity) is not touched by this command, its prior state (active or not) comes back automatically once VBS is available again - no need to rerun 'Re-enable Memory Integrity (HVCI)' separately if you hadn't explicitly disabled it on its own." }
                @{ Label = "Top RAM processes"
                   Cmd   = 'powershell -NoExit -Command Get-Process ^| Sort-Object WorkingSet64 -Descending ^| Select-Object -First 15 Name,Id,@{N=''RAM_MB'';E={[math]::Round($_.WorkingSet64/1MB,1)}} ^| Format-Table -AutoSize'
                   Desc  = "Lists the 15 processes consuming the most RAM (Working Set, in MB), sorted descending. Quick diagnostic for slowdowns or memory pressure, without going through Task Manager."
                   Confirm = $false
                   Help  = "Working Set (WorkingSet64) measures the physical memory actually occupied by the process right now, not allocated virtual memory (often much larger and not very representative of real usage) nor shared memory counted multiple times across several processes. It's the same metric as Task Manager's default 'Memory' column. A process showing an abnormally high Working Set that keeps growing from one run of this command to the next is a candidate worth watching for a memory leak." }
                @{ Label = "Top CPU processes"
                   Cmd   = 'powershell -NoExit -Command $cores = [Environment]::ProcessorCount; $avant = Get-Process ^| Select-Object Id,ProcessName,CPU; Write-Host ''Measuring (1-second sample)...'' -ForegroundColor Cyan; Start-Sleep -Seconds 1; $apres = Get-Process ^| Select-Object Id,ProcessName,CPU; $resultats = foreach ($p in $apres) { $prec = $avant ^| Where-Object { $_.Id -eq $p.Id }; if ($prec -and $p.CPU -and $prec.CPU) { $delta = $p.CPU - $prec.CPU; $pct = [math]::Round(($delta / $cores) * 100, 1); [PSCustomObject]@{ Name = $p.ProcessName; PID = $p.Id; CPU_Percent = $pct } } }; $resultats ^| Sort-Object CPU_Percent -Descending ^| Select-Object -First 15 ^| Format-Table -AutoSize'
                   Desc  = "Lists the 15 processes consuming the most CPU, as an instant percentage measured over a one-second sample (not the cumulative CPU time since the process started, which would be misleading). Quick diagnostic when fans spin up or the machine chugs, without going through Task Manager."
                   Confirm = $false
                   Help  = "Get-Process's native .CPU property is NOT an instant percentage: it's the cumulative processor time (in seconds) consumed by the process since it started, a value that only ever increases and becomes less and less representative of current activity as the process ages (a process launched 3 days ago can show a huge cumulative CPU value without being active right now).`n`nThis command works around that by taking two measurements one second apart, then computing the delta of CPU time consumed during that interval, divided by the number of logical cores (via [Environment]::ProcessorCount) to bring the result down to a 0-100% scale comparable to Task Manager's - rather than 0-800% on an 8-core machine if they were all maxed out simultaneously on the same process.`n`nA process present only in the second sample (launched during the one-second wait) or gone between the two (closed in the meantime) is silently excluded from the result rather than crashing the command - matching between the two samples is done by process ID (Id), absent in that specific case." }
                @{ Label = "Processes by handles/threads"
                   Cmd   = 'powershell -NoExit -Command Get-Process ^| Sort-Object HandleCount -Descending ^| Select-Object -First 15 Name,Id,HandleCount,@{N=''Threads'';E={$_.Threads.Count}} ^| Format-Table -AutoSize'
                   Desc  = "Lists the 15 processes with the most open system handles (files, registry keys, events...) and active threads, sorted by descending handle count. A diagnostic angle distinct from Top RAM/CPU processes: a handle or thread count that keeps climbing over time is a classic sign of a resource leak, even when immediate memory consumption still looks normal."
                   Confirm = $false
                   Help  = "Every file opened, registry key read, system event created, or synchronization object used by a process consumes a handle - a reference managed by the Windows kernel. A healthy process opens and closes its handles as it runs, keeping a broadly stable count over time. A process whose handle count keeps rising continuously and never drops back down (even after inactivity) typically indicates a resource-leak bug in the application's code - the process never releases what it opens - which eventually degrades overall performance or even causes a crash once a system limit is reached, often well before an RAM issue becomes visible in Top RAM processes.`n`nSame logic for thread count: a high and growing value unrelated to the process's actual workload (at rest, no user activity) is a similar signal.`n`nThis command only gives a snapshot at one point in time - to actually detect a leak, you need to compare the same process's values between two runs spaced several hours or days apart, rather than judging from a single reading." }
                @{ Label = "Check the WSearch service"
                   Cmd   = 'powershell -NoExit -Command Get-Service WSearch ^| Select-Object Name,Status,StartType ^| Format-Table -AutoSize'
                   Desc  = "Checks the state of the Windows Search service (indexing), which enables fast searching in the Start menu and File Explorer. Neither a security nor a privacy concern - a pure performance trade-off, distinct from the telemetry services grouped in the Privacy / Telemetry category."
                   Confirm = $false }
                @{ Label = "Disable WSearch (indexing)"
                   Cmd   = 'powershell -NoExit -Command try { Stop-Service -Name WSearch -Force -ErrorAction Stop; Set-Service -Name WSearch -StartupType Disabled -ErrorAction Stop; Write-Host ''WSearch: disabled'' -ForegroundColor Green } catch { Write-Host (''WSearch: failed - '' + $_.Exception.Message) -ForegroundColor Red }'
                   Desc  = "WARNING: stops and disables the Windows Search indexing service. Frees up a bit of background CPU/disk (continuous indexing runs perpetually to stay current), at the cost of much slower file search in the Start menu and Explorer (raw search instead of a pre-built index). Best reserved for a machine where search responsiveness doesn't matter much, or for a temporary performance-diagnostic test."
                   Confirm = $true
                   Help  = "Windows Search permanently maintains an index of disk content (file names, and for some types, their text content) to make search nearly instant in the Start menu and Explorer - this continuous indexing process consumes some background CPU and disk I/O, particularly noticeable right after adding or modifying a large number of files.`n`nDisabling this service touches no security or privacy aspect: it's a purely performance trade-off, unlike the services grouped in the Privacy / Telemetry category, which reduce data sent to Microsoft with no functional trade-off. Once disabled, search still works but scans files directly on every search (much slower, especially with a large number of files or a mechanical disk).`n`nTo re-enable: Set-Service -Name WSearch -StartupType Automatic then Start-Service -Name WSearch (rebuilding the index then takes time in the background before search becomes fast again)." }
            )
        }
        @{
            Name = "Drivers / Hardware"
            Commands = @(
                @{ Label = "Devices in error"
                   Cmd   = 'powershell -NoExit -Command $err = Get-PnpDevice ^| Where-Object Status -eq ''Error''; if ($err) { $err ^| Format-Table -AutoSize } else { Write-Host ''No device in error detected.'' -ForegroundColor Green }'
                   Desc  = "Lists devices flagged in error in Device Manager (missing or failing driver). Quick diagnostic, without running a full driver audit. Shows a message if none is in error (instead of crashing, a known behavior of -Status Error on an empty result)."
                   Confirm = $false }
                @{ Label = "NVIDIA GPU status (nvidia-smi)"
                   Cmd   = 'powershell -NoExit -Command if (Get-Command nvidia-smi -ErrorAction SilentlyContinue) { nvidia-smi } else { Write-Host ''nvidia-smi not found: no NVIDIA GPU detected or NVIDIA driver not installed on this machine.'' -ForegroundColor Yellow }'
                   Desc  = "Shows NVIDIA GPU status: temperature, utilization, VRAM used, driver version. Only applies to machines with an NVIDIA GPU and its driver installed (nvidia-smi in PATH) - clear message otherwise, instead of a raw command-not-found error."
                   Confirm = $false }
                @{ Label = "Detected GPUs"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_VideoController ^| Select-Object Name,DriverVersion,AdapterRAM ^| Format-Table -AutoSize'
                   Desc  = "Lists every GPU detected by Windows, regardless of manufacturer (Intel, AMD, NVIDIA) - useful in particular on a hybrid setup with several graphics chips (iGPU + dedicated card) to see which ones are exposed. Note: AdapterRAM is a WMI field limited to 32 bits, which can show an incorrect or negative value on a card with 4 GB of VRAM or more (a known limitation, not a bug in this command) - for the real VRAM of an NVIDIA card, rely instead on 'NVIDIA GPU status (nvidia-smi)' above."
                   Confirm = $false }
                @{ Label = "BIOS / motherboard info"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_BIOS ^| Select-Object Manufacturer,SMBIOSBIOSVersion,ReleaseDate ^| Format-List'
                   Desc  = "Shows the manufacturer, version, and release date of the currently installed BIOS/UEFI. Handy for a quick check before comparing with the latest version available on the manufacturer's site."
                   Confirm = $false }
                @{ Label = "Installed RAM (modules)"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_PhysicalMemory ^| Select-Object Manufacturer,@{N=''Capacity(GB)'';E={[math]::Round($_.Capacity/1GB,1)}},Speed,DeviceLocator ^| Format-Table -AutoSize'
                   Desc  = "Lists each installed RAM module with its capacity (converted to GB, not raw bytes), its actual frequency (MHz), and its slot (DeviceLocator). Useful for checking how many slots are occupied and whether the actual frequency matches what's expected (sometimes lower than the max XMP/JEDEC without a profile enabled)."
                   Confirm = $false }
                @{ Label = "Recently installed drivers"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_PnPSignedDriver ^| Where-Object { $_.DriverDate } ^| Sort-Object DriverDate -Descending ^| Select-Object -First 15 DeviceName,DriverVersion,DriverDate ^| Format-Table -AutoSize'
                   Desc  = "Lists the 15 most recently installed drivers, sorted by date. Complementary to 'Devices in error': that one says what's wrong now, this one helps pin down a recent problem to a driver update that just happened."
                   Confirm = $false }
                @{ Label = "Connected USB devices"
                   Cmd   = 'powershell -NoExit -Command Get-PnpDevice -PresentOnly ^| Where-Object { $_.InstanceId -like ''USB\*'' } ^| Select-Object FriendlyName,Status,Class ^| Sort-Object Class ^| Format-Table -AutoSize'
                   Desc  = "Lists everything currently connected on the USB bus (filtered on InstanceId, not just the 'USB' class), so it includes hubs as well as mice, keyboards, or external drives plugged in via USB - unlike a Class filter, which would miss most real USB devices."
                   Confirm = $false }
                @{ Label = "Audio devices"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_SoundDevice ^| Select-Object Name,Manufacturer,Status ^| Format-Table -AutoSize'
                   Desc  = "Lists detected audio devices (built-in sound card, USB headset/DAC, etc.) with their status. Nothing else in the catalog covered audio until now, even though sound driver issues are common."
                   Confirm = $false }
                @{ Label = "Current display resolution and refresh rate"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_VideoController ^| Where-Object { $_.CurrentHorizontalResolution } ^| Select-Object Name,CurrentHorizontalResolution,CurrentVerticalResolution,CurrentRefreshRate ^| Format-Table -AutoSize'
                   Desc  = "Shows the resolution and refresh rate currently in use. The filter only keeps the graphics controller actually active (on a setup with several GPUs, the one not driving the display returns empty values and naturally disappears from the result). Reflects the active mode at the GPU level, not necessarily a distinct detail per monitor on a multi-monitor setup."
                   Confirm = $false }
                @{ Label = "Export installed drivers"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Exports all currently installed third-party drivers (excluding native Windows drivers) to a timestamped folder under Desktop\Maintenance_Reports\Export_Drivers\, along with a manifest (Drivers_Manifest.txt/.csv) that maps each folder - named after its technical .inf file, usually not recognizable - to its real manufacturer and category. Useful as a preventive backup before reinstalling Windows or a major hardware change (motherboard, GPU...). Generally requires administrator rights."
                   Confirm = $false
                   Help  = "Export-WindowsDriver copies, for every installed and signed third-party driver (excluding drivers natively shipped with Windows), all of its files (.inf, .sys, .cat, associated .dll) into a dedicated subfolder of the destination folder - a complete backup, directly reinstallable via 'pnputil /add-driver *.inf /subdirs /install', with no need to go back to Windows Update or the manufacturer's site to find them.`n`nWhat this does NOT include: drivers built into Windows itself (stored in the driver store but never installed separately as a third-party package), and applications associated with a driver (for example a GPU management application like NVIDIA App, AMD Software, or Intel Graphics Command Center is not exported, only the driver itself is).`n`nWHY THE FOLDER NAMES ARE CRYPTIC: each subfolder is named after the driver package's original .inf file (e.g. 'acer_s271hl.inf_amd64_f829e28ddd19503b'), exactly as it was submitted to Windows Update or by the manufacturer - an internal technical name, not the hardware's commercial name. It is entirely normal to not recognize any of these names at first glance, even on a single-manufacturer machine: many drivers (generic USB, chipset, shared components) are certified under a package whose name matches neither the machine's manufacturer nor the device involved.`n`nThis is why this command additionally generates a manifest (Drivers_Manifest.txt and .csv, in the same folder as the export) that queries Get-WindowsDriver to map each folder to its real manufacturer (ProviderName), category (ClassName, e.g. Monitor/USB/System/MEDIA), and version - enough to identify each folder without having to manually open every .inf to read its content. An 'Unknown' line in the manifest means the match couldn't be established automatically (rare, usually due to a renaming between the export and the driver-store query) - the folder is nevertheless still valid and reinstallable, only the identification failed.`n`nA new timestamped subfolder (format YYYYMMDD_HHMMSS) is created on every run rather than overwriting the previous one, to keep several backup points over time if needed - clean up manually in Maintenance_Reports\\Export_Drivers\\ if the accumulation becomes bothersome over time.`n`nIf the command fails with a message related to access/permissions denied, that's the most common case: Export-WindowsDriver requires an elevated (administrator) PowerShell session to fully read the driver store." }
                @{ Label = "Manually disabled devices"
                   Cmd   = 'powershell -NoExit -Command $disabled = Get-CimInstance Win32_PnPEntity ^| Where-Object { $_.ConfigManagerErrorCode -eq 22 }; if ($disabled) { $disabled ^| Select-Object Name,DeviceID ^| Format-Table -AutoSize } else { Write-Host ''No manually disabled device detected.'' -ForegroundColor Green }'
                   Desc  = "Lists devices intentionally disabled in Device Manager (error code 22 = CM_PROB_DISABLED), distinct from devices actually failing or with a missing driver already covered by 'Devices in error'. Avoids confusing an intentional disable (webcam, unused Bluetooth, etc.) with a real hardware problem."
                   Confirm = $false
                   Help  = "Get-PnpDevice's Status field (used by 'Devices in error' above) groups several very different situations under the single value 'Error': a driver actually missing or failing, AND a device simply disabled by hand - which can raise a false alarm when everything is perfectly normal.`n`nThis command directly queries the Win32_PnPEntity CIM class and its ConfigManagerErrorCode field, more precise than Get-PnpDevice's simplified Status: code 22 specifically means 'CM_PROB_DISABLED' (intentionally disabled device), to be distinguished from other codes like 28 (driver not installed) or 31 (driver loaded but device refusing to start), which stay covered by 'Devices in error'.`n`nTypically useful after intentionally disabling a webcam, a secondary network card, or an unused Bluetooth adapter via Device Manager: this command confirms it is indeed a recorded intentional disable, without confusing it with an actual failure." }
                @{ Label = "Devices on a Microsoft driver"
                   Cmd   = 'powershell -NoExit -Command try { $classes = @(''Display'',''Net'',''MEDIA'',''HDC'',''SCSIAdapter''); $exclusions = ''WAN Miniport^|Wi-Fi Direct Virtual Adapter^|Kernel Debug Network Adapter^|Storage Spaces Controller^|Streaming Service Proxy^|ISATAP Adapter^|Teredo Tunneling^|6to4 Adapter^|RAS Async Adapter^|Hyper-V Virtual^|Virtual WiFi Miniport^|Bluetooth Device \(Personal Area Network\)''; $drivers = Get-CimInstance Win32_PnPSignedDriver -ErrorAction Stop ^| Where-Object { $_.DriverProviderName -eq ''Microsoft'' -and $classes -contains $_.DeviceClass -and $_.DeviceName -notmatch $exclusions }; if ($drivers) { $drivers ^| Select-Object DeviceName,DeviceClass,DriverVersion ^| Format-Table -AutoSize -Wrap } else { Write-Host ''No physical device (graphics, network, audio, storage) is running on a generic Microsoft driver - all use a specific vendor driver.'' -ForegroundColor Green } } catch { Write-Host ''Unable to query Win32_PnPSignedDriver.'' -ForegroundColor Red }'
                   Desc  = "Looks for PHYSICAL graphics, network, audio, or storage devices (classes Display/Net/MEDIA/HDC/SCSIAdapter) currently running on a driver provided by Microsoft rather than the hardware's vendor. Virtual system adapters (WAN Miniport for VPN, Wi-Fi Direct, Storage Spaces, etc.) are excluded from the result: they are Microsoft by nature and never have a vendor driver, their presence would just be noise with no diagnostic value. A different signal from 'Devices in error': the hardware works, but potentially in a degraded mode (reduced features, lower performance) for lack of the specific driver installed."
                   Confirm = $false
                   Help  = "Every installed driver declares a provider (DriverProviderName) in its metadata - generally the manufacturer's name (NVIDIA, Realtek, Intel...) for a hardware-specific driver, or Microsoft for the generic drivers natively built into Windows (used by default when no specific driver is installed, or temporarily right after a Windows reinstall before manually installing vendor drivers).`n`nThis command deliberately targets hardware classes where a specific vendor driver generally brings a real functional benefit (Display = graphics card, Net = network, MEDIA = audio, HDC/SCSIAdapter = storage controllers) rather than every device - a mouse or keyboard running on a generic Microsoft driver is perfectly normal and comes with no limitation, unlike a graphics card, which would then lose full 3D acceleration, fan control, overclocking, etc.`n`nAn exclusion list further filters out the purely virtual adapters and controllers that Windows creates itself and which, by design, never have a vendor driver to install: WAN Miniports (virtual VPN/dial-up protocol stacks), the Wi-Fi Direct adapter, the kernel debug adapter, the Storage Spaces controller, the streaming service proxy, and IPv6 tunnels (ISATAP, Teredo, 6to4). Without this filter, these normal, ubiquitous system devices would have drowned out any genuinely useful signal under a long list with no diagnostic value.`n`nAn important nuance: Microsoft showing up here is not automatically a problem to fix. Some devices, notably some standard AHCI/NVMe storage controllers, are deliberately handled by the generic Microsoft driver even on a healthy install, that driver being perfectly sufficient and sometimes more stable than certain vendor alternatives. This is mostly worth checking for the GPU (cross-reference with 'NVIDIA GPU status (nvidia-smi)' or 'Detected GPUs' earlier in this catalog) and the physical network card, where the performance and feature gap between generic and vendor driver is generally most visible." }
            )
        }
        @{
            Name = "Quick security"
            Commands = @(
                @{ Label = "Windows Defender status"
                   Cmd   = 'powershell -NoExit -Command Get-MpComputerStatus ^| Format-List AntivirusEnabled,RealTimeProtectionEnabled,AntivirusSignatureLastUpdated,QuickScanAge'
                   Desc  = "Quick view of Windows Defender's status (protection active, last signature date, last quick scan age), without running a full security audit."
                   Confirm = $false }
                @{ Label = "Is SMBv1 active?"
                   Cmd   = 'powershell -NoExit -Command try { $smb = Get-SmbServerConfiguration -ErrorAction Stop; $etat = if ($smb.EnableSMB1Protocol) { ''ACTIVE - obsolete and vulnerable protocol (EternalBlue/WannaCry), disable unless there is an explicit need with very old hardware'' } else { ''Inactive (recommended state)'' }; Write-Host (''SMBv1: '' + $etat) -ForegroundColor Cyan } catch { Write-Host ''Unable to check SMBv1 state (Get-SmbServerConfiguration unavailable).'' -ForegroundColor Red }'
                   Desc  = "Checks whether the SMBv1 protocol is active on the machine - an obsolete file-sharing protocol, replaced by SMBv2/v3 long ago, and a major historical attack vector (EternalBlue, exploited by the WannaCry ransomware in 2017). Disabled by default since several Windows versions, but may have been manually re-enabled for compatibility with a very old NAS or network printer."
                   Confirm = $false
                   Help  = "SMBv1 dates back to the 1990s and suffers from known design weaknesses (no encryption, weak authentication, vulnerable to attacks like EternalBlue exploited by WannaCry and NotPetya in 2017). Windows 10/11 has disabled it by default for several years precisely for this reason.`n`nIf it shows up ACTIVE here, the most common cause is a prior manual re-enable to allow compatibility with an old network device (NAS, a very old network printer) that only supports this protocol - in that case, the risk is limited to the local network but remains real if other devices on the same network are compromised.`n`nThis command is read-only. To disable, the native command is Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol (requires a restart) - not included directly here as a precaution: a change that could potentially impact a network device currently in use deserves a manual check beforehand of what actually depends on it on the local network." }
                @{ Label = "Active network profile"
                   Cmd   = 'powershell -NoExit -Command try { Get-NetConnectionProfile -ErrorAction Stop ^| Select-Object Name,InterfaceAlias,NetworkCategory ^| Format-Table -AutoSize } catch { Write-Host ''Unable to retrieve the network profile.'' -ForegroundColor Red }'
                   Desc  = "Shows the network category (Public/Private/Domain) currently applied to each connected network interface. A 'Private' category on a network that should be 'Public' (cafe, hotel, airport Wi-Fi) exposes far more than necessary: active network discovery, simplified sharing, more permissive firewall rules - complementary to 'Active network shares' already present, which shows WHAT is shared without saying ON WHAT kind of network that share is visible."
                   Confirm = $false
                   Help  = "Windows applies different firewall and network discovery rules depending on the category assigned to each network the machine connects to:`n`n- Public: the most restrictive profile, meant for untrusted networks (public Wi-Fi, mobile hotspot). Network discovery disabled, file/printer sharing blocked by default, stricter firewall rules.`n`n- Private: meant for a trusted home or work network. Network discovery enabled, simplified sharing between devices on the same network.`n`n- Domain: automatically assigned on a corporate network with Active Directory, rules generally managed via GPO rather than manually.`n`nThe category is normally requested from the user on first connecting to a new network, but can end up incorrect if the answer was given by mistake, or if the network's nature changed without a new prompt (e.g. a personal router replaced by a mobile hotspot under the same remembered Wi-Fi network name).`n`nTo fix an incorrect category: Settings > Network & Internet > the network in question > toggle Public/Private. This command is read-only and changes nothing." }
                @{ Label = "Firewall check"
                   Cmd   = 'powershell -NoExit -Command Get-NetFirewallProfile ^| Select-Object Name,Enabled,DefaultInboundAction,DefaultOutboundAction ^| Format-Table -AutoSize; netsh advfirewall show allprofiles state; Get-Service MpsSvc ^| Select-Object Name,Status ^| Format-Table -AutoSize'
                   Desc  = "Checks the Windows Firewall's state on three levels: active profiles (Domain/Private/Public), the real default policy via netsh (more reliable than Get-NetFirewallProfile's 'NotConfigured', which can be misleading), and the status of the underlying MpsSvc service. All three must be consistent to confirm protection is genuinely active."
                   Confirm = $false }
                @{ Label = "Secure Boot / TPM state"
                   Cmd   = 'powershell -NoExit -Command try { $sb = Confirm-SecureBootUEFI; Write-Host ''Secure Boot:'' $sb } catch { Write-Host ''Secure Boot: not applicable (Legacy BIOS mode, not UEFI).'' -ForegroundColor Yellow }; Get-Tpm ^| Select-Object TpmPresent,TpmReady,TpmEnabled ^| Format-Table -AutoSize'
                   Desc  = "Quickly checks Secure Boot and TPM status without running a full security audit. Clear message if the machine is in Legacy BIOS instead of a blocking error (Confirm-SecureBootUEFI fails on a non-UEFI system). TpmPresent = False signals the absence of an active or functional TPM chip on the machine - worth cross-referencing with a possible structural BitLocker FAIL if that's the case, rather than something to fix via this command alone."
                   Confirm = $false }
                @{ Label = "2023 Secure Boot certificates (DB / KEK)"
                   Cmd   = 'powershell -NoExit -Command try { $sbActif = Confirm-SecureBootUEFI; Write-Host (''Secure Boot active: '' + $sbActif) -ForegroundColor Green; $dbTexte = [System.Text.Encoding]::ASCII.GetString((Get-SecureBootUEFI db).bytes); $db2023uefi = $dbTexte -match ''Microsoft UEFI CA 2023''; Write-Host (''DB contains Microsoft UEFI CA 2023 (third-party bootloaders): '' + $db2023uefi) -ForegroundColor Green; $db2023win = $dbTexte -match ''Windows UEFI CA 2023''; Write-Host (''DB contains Windows UEFI CA 2023 (Windows Boot Manager): '' + $db2023win) -ForegroundColor Green; $kekTexte = [System.Text.Encoding]::ASCII.GetString((Get-SecureBootUEFI KEK).bytes); $kek2023 = ($kekTexte -match ''KEK'') -and ($kekTexte -match ''CA 2023''); Write-Host (''KEK contains Microsoft Corporation KEK 2K CA 2023: '' + $kek2023) -ForegroundColor Green } catch { Write-Host ''Secure Boot not active or not supported on this system (Legacy BIOS or Secure Boot disabled).'' -ForegroundColor Yellow }'
                   Desc  = "Checks in detail whether the THREE 2023 UEFI certificates (replacements for the 2011 certificates expiring between June and October 2026) are properly present in the Secure Boot DB and KEK databases. Complementary to 'Secure Boot / TPM state': that one just confirms whether Secure Boot is active, this one precisely checks which trusted certificates are registered. Clear message if Secure Boot is not active or not supported, instead of a blocking error."
                   Confirm = $false
                   Help  = "Context: in 2026 Microsoft is renewing three Secure Boot certificates issued in 2011, which expire on different dates:`n- Microsoft Corporation KEK CA 2011 (June 24, 2026) - authorizes DB/DBX updates`n- Microsoft Corporation UEFI CA 2011 (June 27, 2026) - signs third-party bootloaders/option ROMs`n- Microsoft Windows Production PCA 2011 (October 19, 2026) - signs the Windows Boot Manager itself (the most critical of the three)`n`nWithout updating to the corresponding 2023 certificates, a machine keeps booting normally, but risks no longer being able to receive future boot-related security updates - a state Microsoft itself describes as 'degraded security'.`n`nWhat this command precisely checks, one line per certificate:`n- DB must contain 'Microsoft UEFI CA 2023' (replaces UEFI CA 2011, third-party bootloaders)`n- DB must ALSO contain 'Windows UEFI CA 2023' (replaces Production PCA 2011, Windows Boot Manager - not to be confused with the previous one, very similar names but distinct certificates)`n- KEK must contain 'Microsoft Corporation KEK 2K CA 2023' (replaces KEK CA 2011)`n`nIf any check returns 'False', the corresponding update hasn't happened on this machine yet. Generally applied automatically by Windows Update if the firmware allows it, but some older firmware requires manual action from the manufacturer." }
                @{ Label = "BitLocker status"
                   Cmd   = 'powershell -NoExit -Command Get-BitLockerVolume ^| Select-Object MountPoint,VolumeStatus,ProtectionStatus,EncryptionPercentage ^| Format-Table -AutoSize'
                   Desc  = "Shows the BitLocker encryption status of each volume (protected/unprotected, encryption percentage). Useful for a quick security audit - the result varies widely from machine to machine depending on the presence of a functional TPM."
                   Confirm = $false }
                @{ Label = "Local accounts and administrators"
                   Cmd   = 'powershell -NoExit -Command Get-LocalUser ^| Select-Object Name,Enabled,LastLogon ^| Format-Table -AutoSize; Get-LocalGroupMember -SID ''S-1-5-32-544'' ^| Select-Object Name,PrincipalSource ^| Format-Table -AutoSize'
                   Desc  = "Lists local accounts (enabled/disabled, last logon) then the members of the Administrators group via its fixed SID (S-1-5-32-544) rather than its localized name - so it works identically on an English- or French-language Windows machine. Checks that no unexpected account has admin rights."
                   Confirm = $false }
                @{ Label = "Failed logon attempts"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''Security'';Id=4625} -MaxEvents 10 ^| Select-Object TimeCreated,Message ^| Format-List } catch { Write-Host ''No failed logon attempt found in the Security log.'' -ForegroundColor Green }'
                   Desc  = "Lists the last 10 failed logon attempts (event 4625 from the Security log). Complementary to 'Local accounts and administrators': that one shows who has access, this one shows who tried and failed - a simple indicator of a local brute-force attempt. Clear message if the log has no matching event, instead of a blocking error."
                   Confirm = $false }
                @{ Label = "Defender ASR rules status"
                   Cmd   = 'powershell -NoExit -Command $asr = Get-MpPreference; if ($asr.AttackSurfaceReductionRules_Ids) { $legendeAction = @{ ''0''=''Disabled''; ''1''=''Block''; ''2''=''Audit mode (log only, nothing blocked)''; ''6''=''Warn (blocked with a user bypass option)'' }; $nomsRegles = @{ ''01443614-cd74-433a-b99e-2ecdc07bfc25''=''Block executable files from running unless they meet a prevalence, age, or trusted list criterion''; ''26190899-1602-49e8-8b27-eb1d0a1ce869''=''Block Office communication application from creating child processes''; ''33ddedf1-c6e0-47cb-833e-de6133960387''=''Block rebooting machine in Safe Mode (preview)''; ''3b576869-a4ec-4529-8536-b80a7769e899''=''Block Office applications from creating executable content''; ''56a863a9-875e-4185-98a7-b882c64b5ce5''=''Block abuse of exploited vulnerable signed drivers''; ''5beb7efe-fd9a-4556-801d-275e5ffc04cc''=''Block execution of potentially obfuscated scripts''; ''75668c1f-73b5-4cf0-bb93-3ecf5cb7cc84''=''Block Office applications from injecting code into other processes''; ''7674ba52-37eb-4a4f-a9a1-f0f9a1619a2c''=''Block Adobe Reader from creating child processes''; ''92e97fa1-2edf-4476-bdd6-9dd0b4dddc7b''=''Block Win32 API calls from Office macros''; ''9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2''=''Block credential stealing from the Windows local security authority subsystem (lsass.exe)''; ''b2b3f03d-6a65-4f7b-a9c7-1c7ef74a9ba4''=''Block untrusted and unsigned processes that run from USB''; ''be9ba2d9-53ea-4cdc-84e5-9b1eeee46550''=''Block executable content from email client and webmail''; ''c0033c00-d16d-4114-a5a0-dc9b3a7d2ceb''=''Block use of copied or impersonated system tools (preview)''; ''c1db55ab-c21a-4637-bb3f-a12568109d35''=''Use advanced protection against ransomware''; ''d1e49aac-8f56-4280-b9ba-993a6d77406c''=''Block process creations originating from PSExec and WMI commands''; ''d3e037e1-3eb8-44c8-a917-57927947596d''=''Block JavaScript or VBScript from launching downloaded executable content''; ''d4f940ab-401b-4efc-aadc-ad5f3c50688a''=''Block all Office applications from creating child processes''; ''e6db77e5-3df2-4cf1-b95a-636979351e5b''=''Block persistence through WMI event subscription'' }; for ($i = 0; $i -lt $asr.AttackSurfaceReductionRules_Ids.Count; $i++) { $id = $asr.AttackSurfaceReductionRules_Ids[$i]; $idKey = $id.ToLower(); $action = [string]$asr.AttackSurfaceReductionRules_Actions[$i]; $labelAction = if ($legendeAction.ContainsKey($action)) { $legendeAction[$action] } else { ''Unknown'' }; $nomRegle = if ($nomsRegles.ContainsKey($idKey)) { $nomsRegles[$idKey] } else { ''Unlisted rule (GUID: '' + $id + '')'' }; Write-Host ($nomRegle + '' : '' + $labelAction + '' (code '' + $action + '')'') } } else { Write-Host ''No ASR (Attack Surface Reduction) rule configured on this machine.'' -ForegroundColor Yellow }'
                   Desc  = "Shows the status of Windows Defender's ASR (Attack Surface Reduction) rules: for each configured rule, its name and current action (Disabled/Block/Audit mode/Warn). Complementary to 'Windows Defender status' and 'Firewall check': ASR rules block precise behaviors (Office macros launching code, credential theft from LSASS, etc.), a layer nothing else in the catalog covered until now. Clear message if no rule is configured, instead of an empty table."
                   Confirm = $false
                   Help  = "ASR (Attack Surface Reduction) rules are a set of 19 rules predefined by Microsoft (18 listed here, the 19th - Block Webshell creation for Servers - only applies to Exchange servers), each identified on the system side by a fixed GUID rather than a readable name. This command translates each GUID encountered into its name via a lookup table verified against the official Microsoft documentation (Attack surface reduction rules reference). If a GUID unknown to this table shows up (a new rule added by Microsoft since), it is shown as-is with the label 'Unlisted rule' instead of silently failing.`n`nMeaning of the displayed action codes:`n- 0 = Disabled (rule present but inactive)`n- 1 = Block (the action is prevented)`n- 2 = Audit mode (nothing is blocked, only logged to Event Viewer - useful for testing a rule before turning on real blocking)`n- 6 = Warn (blocked by default, with an option for the user to force a bypass via a notification)`n`nOn a consumer machine (outside Defender for Endpoint / corporate GPO), it's perfectly normal for no rule to be configured by default - the corresponding message shows up instead of an empty table, without this being an anomaly to fix." }
                @{ Label = "UAC status"
                   Cmd   = 'powershell -NoExit -Command try { $uac = Get-ItemProperty -Path ''HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'' -ErrorAction Stop; $etatLua = if ($uac.EnableLUA -eq 1) { ''Active'' } else { ''INACTIVE - UAC completely disabled (strongly discouraged)'' }; Write-Host (''EnableLUA (UAC active): '' + $etatLua) -ForegroundColor Cyan; $cle = [string]$uac.ConsentPromptBehaviorAdmin + ''-'' + [string]$uac.PromptOnSecureDesktop; $niveau = switch ($cle) { ''2-1'' { ''Always notify (the slider''''s highest level)'' } ''5-1'' { ''Notify only when an app tries to make changes - Windows default setting'' } ''5-0'' { ''Notify only when an app tries to make changes, without dimming the desktop'' } ''0-0'' { ''Never notify (the lowest level - strongly discouraged)'' } default { ''Non-standard combination (ConsentPromptBehaviorAdmin='' + $uac.ConsentPromptBehaviorAdmin + '', PromptOnSecureDesktop='' + $uac.PromptOnSecureDesktop + '')'' } }; Write-Host (''UAC slider level: '' + $niveau) -ForegroundColor Cyan } catch { Write-Host ''UAC registry key not found (EnableLUA defaults to active on a standard Windows install).'' -ForegroundColor Yellow }'
                   Desc  = "Checks whether UAC (User Account Control) is active (EnableLUA) and identifies the exact configured slider level (Always notify / Notify only on changes / same without dimming the desktop / Never notify), by combining ConsentPromptBehaviorAdmin and PromptOnSecureDesktop rather than a single isolated value that would be ambiguous. Clear message if the registry key doesn't exist (UAC active by default in that case), instead of a blocking error."
                   Confirm = $false
                   Help  = "UAC relies on two distinct registry keys under HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System, and the level shown by the Control Panel slider is actually a COMBINATION of the two, not a single value:`n`n- EnableLUA: the global toggle (1=active, 0=UAC entirely disabled - the machine then runs permanently with full admin rights, with no confirmation prompt at all, even for malicious software).`n`n- ConsentPromptBehaviorAdmin + PromptOnSecureDesktop: together, these two values determine which of the 4 UAC slider positions is active:`n  - 2/1 = Always notify (highest position)`n  - 5/1 = Notify only when an app tries to make changes, desktop dimmed (Windows' default setting)`n  - 5/0 = Same level as default but WITHOUT dimming the desktop (the secure/dimmed desktop normally prevents malware from simulating an automatic click on the UAC dialog - removing it slightly reduces this protection)`n  - 0/0 = Never notify (lowest position, practically equivalent to EnableLUA=0 for applications in practice, even though UAC technically stays active)`n`nIf the combination found matches none of the 4 standard slider positions, the command shows it as-is rather than forcing an approximate match - a rare situation, generally the sign of a manual registry edit rather than one made through the Control Panel." }
                @{ Label = "Exploit Protection (system mitigations)"
                   Cmd   = 'powershell -NoExit -Command try { $m = Get-ProcessMitigation -System -ErrorAction Stop; Write-Host (''DEP (Data Execution Prevention): '' + $m.DEP.Enable) -ForegroundColor Cyan; Write-Host (''SEHOP: '' + $m.SEHOP.Enable) -ForegroundColor Cyan; Write-Host (''CFG (Control Flow Guard): '' + $m.CFG.Enable) -ForegroundColor Cyan; Write-Host (''ASLR BottomUp: '' + $m.ASLR.BottomUp) -ForegroundColor Cyan; Write-Host (''ASLR ForceRelocateImages: '' + $m.ASLR.ForceRelocateImages) -ForegroundColor Cyan; Write-Host (''ASLR HighEntropy: '' + $m.ASLR.HighEntropy) -ForegroundColor Cyan } catch { Write-Host ''Unable to retrieve Exploit Protection settings (Get-ProcessMitigation unavailable).'' -ForegroundColor Red }'
                   Desc  = "Shows Exploit Protection's main system mitigations (DEP, SEHOP, CFG, ASLR in its three variants) as globally configured for the machine. Complementary to Defender's ASR rules already present: ASR blocks precise application behaviors, Exploit Protection acts at a lower level, on the memory mechanisms exploited by most vulnerability-exploitation techniques, independently of any signature or behavioral rule."
                   Confirm = $false
                   Help  = "Exploit Protection (formerly EMET, natively built into Windows Defender since Windows 10) applies a set of operating-system-level mitigations that make exploiting memory vulnerabilities (buffer overflow, heap corruption, etc.) structurally harder, regardless of the exact nature of the malware or vulnerability exploited:`n`n- DEP (Data Execution Prevention): prevents code execution from memory regions marked as data-only - the oldest and most fundamental mitigation, active by default for a long time.`n`n- SEHOP: protects the structured exception handling chain against hijacking, a classic exploitation technique on 32-bit systems.`n`n- CFG (Control Flow Guard): checks at runtime that indirect function calls point to a legitimate destination known at compile time, strongly complicating execution-flow hijacking techniques (ROP/JOP).`n`n- ASLR (Address Space Layout Randomization, three variants): randomizes the memory location of code and data on every run, preventing an attacker from predicting in advance where a function or structure to target sits.`n`nA value of 'NOTSET' for a setting does not mean disabled: it indicates that no explicit system-level configuration has been applied, and that Windows' default behavior (generally active for most of these mitigations on modern systems) silently applies. An explicit 'OFF' value, on the other hand, would be the sign of a deliberate disabling, potentially problematic if unintentional." }
                @{ Label = "Active network shares"
                   Cmd   = 'powershell -NoExit -Command try { Get-SmbShare -ErrorAction Stop ^| Select-Object Name,Path,@{N=''Type'';E={if ($_.Special) { ''Administrative (cache, system)'' } else { ''User share'' }}} ^| Format-Table -AutoSize } catch { Write-Host ''Unable to retrieve the SMB share list.'' -ForegroundColor Red }'
                   Desc  = "Lists all active SMB shares on the machine (manually created user shares and default administrative shares like C`$, ADMIN`$, IPC`$), with their local path. A quick audit of what's exposed on the local network, absent from the catalog until now - worth checking in particular on a machine that shouldn't normally be sharing anything."
                   Confirm = $false
                   Help  = "Windows automatically creates several hidden administrative shares at startup (marked Administrative in the Type column): C`$ (root of each drive), ADMIN`$ (Windows folder), IPC`$ (inter-process communication). These shares are normal on any standard Windows install, accessible only by an administrator account of the domain/machine, and are not an anomaly to fix - disabling them breaks remote administration features (MMC management, software deployment, etc.).`n`nWhat's worth attention are shares marked User share: any folder deliberately shared (or by an application, a game, network backup software...) shows up here with its exact local path. On a machine that shouldn't normally be sharing anything on the network, the presence of an unexpected user share is worth investigating - either a share created deliberately and forgotten, or installed by third-party software without it being obvious at first glance." }
                @{ Label = "LSA Protection (RunAsPPL)"
                   Cmd   = 'powershell -NoExit -Command try { $lsa = Get-ItemProperty -Path ''HKLM:\SYSTEM\CurrentControlSet\Control\Lsa'' -ErrorAction Stop; $val = $lsa.RunAsPPL; $etat = if ($null -eq $val -or $val -eq 0) { ''INACTIVE - LSASS not protected against credential extraction (not recommended)'' } elseif ($val -eq 1) { ''Active'' } elseif ($val -eq 2) { ''Active with UEFI lock (reinforced protection, cannot be disabled remotely)'' } else { ''Non-standard value ('' + $val + '')'' }; Write-Host (''RunAsPPL (LSASS protection): '' + $etat) -ForegroundColor Cyan } catch { Write-Host ''Unable to read the LSA registry key.'' -ForegroundColor Red }'
                   Desc  = "Checks whether LSA Protection (RunAsPPL) is active, which turns the LSASS process into a protected process (PPL) preventing even an administrator account from injecting code into it or extracting its memory content directly. A direct complement to the ASR rule 'Block credential stealing from LSASS' already present: ASR blocks a typical attack behavior, RunAsPPL protects the process itself at the kernel level, an independent and more fundamental layer."
                   Confirm = $false
                   Help  = "LSASS (Local Security Authority Subsystem Service) is the process that manages the active session's credentials in memory (password hashes, Kerberos tickets...) - a classic prime target for credential-extraction tools (Mimikatz and equivalents), even with local administrator privileges that are normally enough to read any process's memory.`n`nRunAsPPL turns LSASS into a protected process (Protected Process Light): only other processes that are also protected and signed by a specific trusted publisher can then interact with its memory, which structurally blocks most extraction tools even when run with full administrator privileges.`n`nThree possible states:`n- 0 or absent: protection inactive (Windows' historical default behavior, still the case on many installs).`n- 1: protection active, but can be disabled via the registry by an administrator (including by malware with sufficient privileges).`n- 2: protection active with UEFI lock - the value is then also stored in firmware and can no longer be disabled simply by editing the registry, even with full administrator privileges; requires physical access and a dedicated tool to disable it.`n`nEnabling this protection can occasionally prevent certain older third-party drivers or security software from working correctly if they expect to interact directly with LSASS - worth testing before wide deployment if third-party security software is used alongside Defender." }
                @{ Label = "Credential Guard active?"
                   Cmd   = 'powershell -NoExit -Command try { $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace ''root\Microsoft\Windows\DeviceGuard'' -ErrorAction Stop; if ($dg.SecurityServicesRunning -contains 1) { Write-Host ''Credential Guard: ACTIVE'' -ForegroundColor Green } else { Write-Host ''Credential Guard: INACTIVE'' -ForegroundColor Yellow; Write-Host ''Normal state on a personal machine not joined to a domain - see the ? button for details.'' -ForegroundColor Yellow } } catch { Write-Host ''Unable to query Win32_DeviceGuard (WMI namespace absent, Windows Home edition, or feature not supported on this hardware).'' -ForegroundColor Red }'
                   Desc  = "Checks whether Credential Guard is active. WARNING - an enterprise/domain-oriented feature: protects domain credentials (cached NTLM/Kerberos secrets) against theft by tools like Mimikatz, on a machine joined to a local Active Directory or Entra ID. On a personal machine with only local accounts (not joined to a domain), an INACTIVE state is normal, expected behavior, not an anomaly to fix - there simply are no domain credentials to protect in that context."
                   Confirm = $false
                   Help  = "Credential Guard isolates locally cached domain credentials - NTLM hashes, Kerberos tickets - inside a virtualized container (via VBS, the same foundation as HVCI already covered in the Performance category), to prevent an attacker who has already compromised the machine, even with full administrator privileges, from extracting them and pivoting to other machines on the same domain (pass-the-hash or pass-the-ticket style attacks).`n`nThis is a protection specifically designed for enterprise environments, where machines are joined to a local Active Directory or Entra ID (formerly Azure AD) and where Credential Guard is generally deployed and managed centrally via GPO or Intune, rather than enabled manually machine by machine.`n`nOn a personal machine using only local accounts or a Microsoft account, with no enterprise domain join, there simply are no cached domain credentials to protect - Credential Guard then has nothing concrete to secure. An INACTIVE state in this specific context is therefore normal default behavior for a consumer machine, not a weakness to fix - unlike, for example, LSA protection (RunAsPPL) just above in this same catalog, which stays relevant on any machine regardless of any notion of a domain.`n`nIf this command fails with an error message rather than showing an ACTIVE/INACTIVE status, the most common cause is the installed Windows edition: the Win32_DeviceGuard WMI class and Credential Guard itself are only available on the Pro, Enterprise, and Education editions of Windows - absent by design on Windows Home, even if the hardware would technically be compatible (VBS active, TPM present, etc.)." }
                @{ Label = "AutoPlay / AutoRun - current state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Shows the current state of the NoDriveTypeAutoRun registry setting, which controls automatic opening/execution of removable media (USB drive, CD/DVD) as soon as it's inserted - both AutoRun (silent program execution, already blocked by default since Windows 7) and AutoPlay (automatic content opening or a dialog box, active by default on Windows 10/11 - see Help for the distinction). Absent or 0 = Windows default behavior (AutoPlay active); 255 (0xFF) = every automatic behavior explicitly disabled on all drive types, including automatic content opening."
                   Confirm = $false
                   Help  = "Two distinct mechanisms, often lumped together under the same generic term 'autorun':`n`n- AutoRun: automatic, silent execution of a program referenced in an autorun.inf file at the root of a media, with no user action at all. A major malware-propagation vector in the 2000s-2010s (the Conficker worm is the best-known example). Since Windows 7 (following a security update backported all the way to Vista SP1), this automatic execution is disabled by default on removable drives (USB sticks) - a native system protection, independent of the NoDriveTypeAutoRun registry key.`n`n- AutoPlay: a distinct behavior that stays active by default on Windows 10/11, independently of the AutoRun protection above. When media is inserted, Windows offers an action-choice dialog box, or directly opens the content in File Explorer if a default behavior has been configured (via Settings > Devices > AutoPlay, or via this same NoDriveTypeAutoRun key). This is what explains content automatically opening when a USB drive is inserted on an otherwise up-to-date Windows 10/11 machine: no contradiction with native AutoRun protection, which only blocks silent program execution, not a window opening.`n`nWhat this command precisely checks: the NoDriveTypeAutoRun value, a historically older mechanism driven by group policy (GPO), which lets you explicitly harden this behavior by disabling AutoPlay itself (not just AutoRun) for one or more drive types. A value of 255 (0xFF) cuts off AutoPlay notifications/automatic openings on every drive type, which concretely translates into no automatic opening at all when media is inserted, unlike Windows' default behavior described above. An absent value means no explicit hardening of this kind has been configured - AutoPlay then follows its default behavior (active), even though AutoRun (execution) stays natively protected." }
                @{ Label = "Scheduled tasks with a non-Microsoft author"
                   Cmd   = 'powershell -NoExit -Command Get-ScheduledTask -ErrorAction SilentlyContinue ^| Where-Object { $_.Author -notmatch ''(?i)^Microsoft'' } ^| Select-Object TaskName,TaskPath,Author,State ^| Sort-Object TaskPath,TaskName ^| Format-Table -AutoSize'
                   Desc  = "Lists scheduled tasks whose declared author doesn't start with Microsoft (including tasks with no author set), to quickly spot ones added by third-party software or, in the worst case, a malicious persistence mechanism. Complements 'Active scheduled tasks (excluding logon)' already present in this catalog: this one specifically filters on origin rather than active/inactive state."
                   Confirm = $false
                   Help  = "A scheduled task is one of the most common persistence mechanisms, both for legitimate software (automatic updates, a sync service, a manufacturer utility) and for malware seeking to automatically relaunch after a restart without going through more closely watched startup locations (the Startup folder, the registry Run key).`n`nThe Author field is set by the task's creator at creation time and is not verified or signed by Windows - malicious software could theoretically write any value there, including a string resembling 'Microsoft'. This command is therefore a quick sorting filter and a starting point for investigation, not definitive proof of legitimacy or malice on its own.`n`nA task with no author set (empty field) isn't necessarily suspicious: many legitimate third-party installers, especially older ones or ones created via schtasks.exe on the command line without the corresponding option, simply don't fill in this field. Conversely, the presence of a known publisher name consistent with software actually installed on the machine (visible for example in the list of installed programs) is a good sign of legitimacy. What deserves the most attention: an absent, generic, or inconsistent author name, combined with a task whose action path (visible in Task Scheduler, Actions tab) points to an executable in an unusual location (a temp folder, AppData with a random name, etc.)." }
                @{ Label = "Remote Desktop (RDP) - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks at a glance whether Remote Desktop connections are allowed (fDenyTSConnections registry key), how many associated firewall rules are active, and the state of the TermService service that carries the feature."
                   Confirm = $false
                   Help  = "Three complementary checks, since none of the three alone is enough to confirm RDP's real state on a machine:`n`nfDenyTSConnections (registry)`nThe main toggle: 0 = connections allowed, 1 (or absent depending on config) = blocked. This is the setting changed by the Windows Settings panel / group policy.`n`nFirewall rules`nEven with fDenyTSConnections at 0, a disabled firewall rule prevents any real inbound connection - the two need to be aligned for functional RDP access. Since the rule group's name is localized based on the system language, the command tries 'Remote Desktop' then 'Bureau a distance' as a fallback.`n`nTermService service`nThe underlying Windows service: even with correct config and rules, a stopped service prevents any connection.`n`nLEGEND (line 1): ALLOWED = RDP accessible in theory (confirm with the other two lines) - BLOCKED = RDP explicitly disabled at the system level, the most reliable way to close it completely. Since RDP is a frequently targeted attack vector (brute-force, exploits), a BLOCKED state is recommended on any machine where remote access isn't needed." }
                @{ Label = "Controlled Folder Access - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks the state of Controlled Folder Access, Windows Defender's anti-ransomware protection that blocks unauthorized changes in protected folders (Documents, Pictures, Desktop, etc. by default)."
                   Confirm = $false
                   Help  = "Controlled Folder Access monitors Windows' default protected folders (Documents, Pictures, Desktop, Music, Videos, Favorites) and blocks any application not explicitly allowed from trying to modify or encrypt files in them - the key protection against ransomware that encrypts personal documents.`n`nVALUE LEGEND:`n0 = Disabled (Windows' out-of-the-box default behavior).`n1 = Active - the protection genuinely blocks suspicious changes.`n2 = Audit mode - logs what would have been blocked, without actually blocking anything (useful for pre-identifying which legitimate applications to allow, before turning on full protection).`n`nThe 'additional protected folders' count shows whether folders have been added to the default list (e.g. a personal projects folder, a local network share).`n`nPoint of caution: once active, any legitimate application that modifies files in protected folders (less common text editors, some backup/sync tools, games that save to Documents) will need to be explicitly allowed via Windows Security > Virus & threat protection > Manage ransomware protection - otherwise its writes will be silently blocked." }
                @{ Label = "Enable Controlled Folder Access"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "WARNING: enables the Controlled Folder Access anti-ransomware protection (EnableControlledFolderAccess = Enabled). Can block unrecognized legitimate applications that write to protected folders (Documents, Pictures, Desktop, etc.) - worth testing before wide deployment across a fleet, or enable in audit mode first (not covered by this command) to identify which applications to allow beforehand."
                   Confirm = $true
                   Help  = "Applies Set-MpPreference -EnableControlledFolderAccess Enabled - refer to 'Controlled Folder Access - state' just above for the full detail of what this protection does and its possible side effects on existing applications.`n`nIf a legitimate application ends up blocked after enabling (a silent write failure to Documents/Pictures/Desktop typically), two options: add it to exceptions via Windows Security > Virus & threat protection > Manage ransomware protection > Allow an app through controlled folder access, or revert with the 'Disable Controlled Folder Access' command just below while you investigate." }
                @{ Label = "Disable Controlled Folder Access"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Disables the Controlled Folder Access protection (EnableControlledFolderAccess = Disabled). Typically used to work around a legitimate application being blocked while you investigate, or if this protection isn't wanted on the machine."
                   Confirm = $true
                   Help  = "Applies Set-MpPreference -EnableControlledFolderAccess Disabled - undoes the effect of 'Enable Controlled Folder Access'. Any additional protected-folder list previously configured (visible via 'Controlled Folder Access - state') isn't erased by this command, it's just inactive while the protection stays disabled - switching back to 'Enabled' later will re-enable it with the same list." }
                @{ Label = "Active firewall rules summary"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Counts active Windows firewall rules by direction (inbound/outbound) and by action (allow/block) - a complement to 'Firewall check' (which checks the Domain/Private/Public profiles and the default policy) by this time giving an overview at the level of the individual rules themselves."
                   Confirm = $false
                   Help  = "While 'Firewall check' answers the question 'is the firewall active and what is its default policy?', this command answers 'how many specific rules are currently active, and in which direction?'.`n`nParticularly useful for spotting drift over time on a given machine (e.g. an abnormally high number of allowed inbound rules compared to another machine in the same fleet, a possible sign of an application having opened ports unintentionally) - a comparison between several machines assumed to be identical is the most telling use case.`n`nThis command does not list the detail of each individual rule (the volume would be unreadable in the console window - several hundred rules typically exist on a standard Windows install, between system rules and ones added by installed applications): it only gives the totals. To inspect a specific rule, use Get-NetFirewallRule directly with a filter." }
            )
        }
        @{
            Name = "Privacy / Telemetry"
            Commands = @(
                @{ Label = "Windows telemetry level"
                   Cmd   = 'powershell -NoExit -Command try { $val = Get-ItemProperty -Path ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection'' -Name AllowTelemetry -ErrorAction Stop; $niveau = switch ($val.AllowTelemetry) { 0 { ''Security (0) - Enterprise/Education only, absolute minimum'' } 1 { ''Basic (1) - essential diagnostic data only'' } 2 { ''Enhanced (2) - removed since Windows 10 1803+, merged into 1 or 3 depending on build'' } 3 { ''Full (3) - maximum data collected'' } default { ''Non-standard value ('' + $val.AllowTelemetry + '')'' } }; Write-Host (''Explicitly configured telemetry level: '' + $niveau) -ForegroundColor Cyan } catch { Write-Host ''No AllowTelemetry value explicitly set - the installed Windows edition''''s default level applies (see the ? button for details).'' -ForegroundColor Yellow }'
                   Desc  = "Checks the explicitly configured Windows telemetry level (AllowTelemetry), the master key that determines how much diagnostic data is collected and sent to Microsoft. Distinct from any network/DNS blocking (like NextDNS or a hosts file): even with traffic blocked at the network level, Windows keeps generating and trying to send this data as long as this level isn't lowered at the application level."
                   Confirm = $false
                   Help  = "Windows defines four possible telemetry levels (0 to 3), from the absolute minimum to maximum collection. Level 2 (Enhanced) has been removed in recent versions of Windows 10/11 and merged into neighboring levels depending on the exact build.`n`nImportant point specific to consumer editions: on Windows Home and Pro (outside corporate GPO/MDM management), the minimum level accessible via the interface is generally 1 (Basic) - level 0 (Security) is only available on Enterprise, Education, and Windows Server editions, or via centralized management. It is therefore normal, on a consumer machine, to never be able to go below level 1 through standard means.`n`nThis command only reads the value if it has been set EXPLICITLY (via GPO, manually edited registry, or a third-party hardening tool) under the policy key. In the absence of this key, Windows applies its default behavior depending on the installed edition - which isn't necessarily the minimal level 1, simply the standard, non-forced setting.`n`nThis command is read-only. The change is made via Settings > Privacy & security > Diagnostics & feedback, or by directly setting AllowTelemetry under this registry key (requires administrator rights).`n`nVALUE LEGEND: unlike most other status commands in this category which show a simple binary (0 or 1), this is a 4-level scale (0 to 3, detailed above) - the higher the number, the more data is collected." }
                @{ Label = "Apps with camera/mic/GPS access"
                   Cmd   = 'powershell -NoExit -Command try { $capacites = @{ ''webcam''=''Camera''; ''microphone''=''Microphone''; ''location''=''Location'' }; $resultats = foreach ($cle in $capacites.Keys) { $chemin = ''HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\'' + $cle; if (Test-Path $chemin) { Get-ChildItem $chemin -ErrorAction SilentlyContinue ^| ForEach-Object { $v = (Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue).Value; if ($v -eq ''Allow'') { $nom = if ($_.PSChildName -eq ''NonPackaged'') { ''Desktop apps (non-Store, blanket permission)'' } else { $_.PSChildName }; [PSCustomObject]@{ Capability = $capacites[$cle]; Application = $nom } } } } }; if ($resultats) { $resultats ^| Sort-Object Capability,Application ^| Format-Table -AutoSize -Wrap } else { Write-Host ''No app with explicitly allowed access found.'' -ForegroundColor Green } } catch { Write-Host ''Unable to read the ConsentStore.'' -ForegroundColor Red }'
                   Desc  = "Lists apps that have explicitly been granted permission to access the camera, microphone, or location (only currently allowed access). A concrete, actionable angle: rather than only knowing whether these capabilities are globally enabled, seeing precisely WHICH apps benefit from them lets you spot a forgotten or unexpected access."
                   Confirm = $false
                   Help  = "Windows records the consent given to each app for these three sensitive capabilities in the registry (CapabilityAccessManager\ConsentStore), under HKCU (so specific to the active user session, not the machine as a whole - another user account on the same machine would have its own independent permissions).`n`nTwo types of entries show up: Microsoft Store/UWP apps, individually identified by their package family name (e.g. Microsoft.WindowsCamera_8wekyb3d8bbwe), and a single entry shown as 'Desktop apps (non-Store, blanket permission)' which represents the COLLECTIVE permission given to all classic desktop (Win32) apps at once - Windows does not track this consent individually per desktop app, unlike Store apps which each have their own distinct entry.`n`nOnly currently ALLOWED access is shown; access explicitly denied or never requested does not appear, to only show what represents a real exposure. Worth cross-referencing with Settings > Privacy & security > App permissions to revoke access deemed unnecessary - this command is read-only and changes nothing." }
                @{ Label = "Advertising ID"
                   Cmd   = 'powershell -NoExit -Command try { $val = Get-ItemProperty -Path ''HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo'' -Name Enabled -ErrorAction Stop; $etat = if ($val.Enabled -eq 1) { ''ACTIVE - apps can use this identifier to personalize ads'' } else { ''Inactive'' }; Write-Host (''Advertising ID: '' + $etat) -ForegroundColor Cyan } catch { Write-Host ''AdvertisingInfo key not found - Windows default state applies (generally active).'' -ForegroundColor Yellow }'
                   Desc  = "Checks whether the Windows Advertising ID is active, a per-user unique identifier apps can use to personalize the ads shown and track usage across apps. Distinct from general telemetry (AllowTelemetry): this is specifically an ad-tracking identifier, not system diagnostic data."
                   Confirm = $false
                   Help  = "The Advertising ID is a unique identifier generated per Windows user, comparable in principle to iOS's IDFA or Android's GAID: apps that use it can build an advertising profile tied to this identifier rather than the user by name, and share it between themselves for coordinated ad targeting (an app can know that the user of a given ID also used some other app).`n`nDisabling this setting does not block advertising itself (apps can still show ads), but prevents personalized targeting based on this specific identifier - an app can still use its own tracking mechanisms independent of this one.`n`nThis command is read-only. The simplest way to disable it is Settings > Privacy & security > General permissions > toggle 'Let apps show me personalized ads' - a one-click setting, no direct registry change needed.`n`nVALUE LEGEND (Enabled): 1 = active, 0 or absent = inactive - standard polarity (the setting's name starts with 'Enable', a value of 1 enables the feature)." }
                @{ Label = "Activity history (Timeline)"
                   Cmd   = 'powershell -NoExit -Command try { $chemin = ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\System''; if (Test-Path $chemin) { $vals = Get-ItemProperty -Path $chemin; $ef = if ($null -ne $vals.EnableActivityFeed) { $vals.EnableActivityFeed } else { ''not defined'' }; $pub = if ($null -ne $vals.PublishUserActivities) { $vals.PublishUserActivities } else { ''not defined'' }; $up = if ($null -ne $vals.UploadUserActivities) { $vals.UploadUserActivities } else { ''not defined'' }; Write-Host (''EnableActivityFeed (show the feed): '' + $ef) -ForegroundColor Cyan; Write-Host (''PublishUserActivities (record locally): '' + $pub) -ForegroundColor Cyan; Write-Host (''UploadUserActivities (send to Microsoft cloud): '' + $up) -ForegroundColor Cyan } else { Write-Host ''No group policy set on activity history - Windows default behavior applies.'' -ForegroundColor Yellow } } catch { Write-Host ''Unable to check activity history.'' -ForegroundColor Red }'
                   Desc  = "Checks whether group policy restricts the Timeline/activity history feature: local recording of recent activities (apps used, documents opened) and their possible upload to the Microsoft account for syncing across devices (Continue on this PC). Distinct from the general telemetry level: this is specifically application usage history, not technical diagnostic data."
                   Confirm = $false
                   Help  = "Three distinct settings control this feature, generally managed together via GPO/registry but technically independent:`n`n- EnableActivityFeed: turns the activity feed display itself on or off (Task View / Timeline in the interface).`n`n- PublishUserActivities: controls whether Windows locally records recent activities (which app was used, which document opened, at what time) - even without a Microsoft account, this local history exists by default.`n`n- UploadUserActivities: specifically controls sending this history to the Microsoft cloud, to make it available on other devices linked to the same Microsoft account. Without a Microsoft account associated with the session, this value has no concrete effect since there is nowhere to send the data.`n`nVALUE LEGEND (same for all 3): 0 = the corresponding feature disabled, 1 = enabled - standard polarity (all 3 names start with 'Enable'/'Publish'/'Upload', a value of 1 enables). No value at all (policy key not present, shown as 'not defined') means no restriction is imposed and Windows' default behavior applies, generally active if a Microsoft account is used for the session." }
                @{ Label = "Windows Recall - current state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks whether Windows Recall (periodic screen capture analyzed by AI to enable retroactive search through activity) is explicitly blocked by policy, at both the user (HKCU) and machine (HKLM) level. IMPORTANT: Recall requires a 'Copilot+' PC with an NPU of at least 40 TOPS - absent from nearly all machines from before 2024/2025. On non-compatible hardware, the feature simply does not exist, regardless of what this command shows."
                   Confirm = $false
                   Help  = "Windows Recall captures a screenshot every few seconds, analyzed locally by an embedded AI model, to enable natural-language search through 'everything that has been seen on screen' (documents, web pages, conversations...). A widely debated feature since its 2024 announcement because of privacy implications, even though processing and storage are advertised as local and encrypted (BitLocker/device encryption).`n`nRecall is reserved for 'Copilot+' PCs, a category of machines equipped with an NPU (a dedicated AI compute unit) of at least 40 TOPS of power - a recent hardware requirement that no machine from before 2024 meets, regardless of CPU/GPU power. On a non-compatible machine, the 'Recall & snapshots' entry doesn't even appear in Settings > Privacy & security, and this command then only confirms the absence of any needed block since there is nothing to block.`n`nThis command specifically checks the DisableAIDataAnalysis policy, the official mechanism documented by Microsoft for blocking Recall (distinct from any other privacy setting in the catalog) - unrelated to the DiagTrack service or general telemetry, which are entirely independent mechanisms.`n`nVALUE LEGEND - careful, INVERTED polarity compared to most other status commands in this category: 1 = Recall BLOCKED (the policy's name starts with 'Disable' - a value of 1 enables this block, exactly the opposite of an 'Enable' setting). 0 or 'not defined' = no explicit block imposed - which does NOT mean Recall is active, only that no restriction has been configured (and reminder: without a Copilot+ NPU, the question is moot anyway since the feature doesn't exist on the machine)." }
                @{ Label = "Block Windows Recall by policy"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "WARNING: blocks Windows Recall via explicit policy (HKCU + HKLM), preventing its activation even on future Copilot+ compatible hardware. No visible effect on a machine without a compatible NPU (nothing to block), but useful as a preventive lock ahead of a possible hardware upgrade."
                   Confirm = $true
                   Help  = "Creates/modifies the DisableAIDataAnalysis value both under HKCU (current user) and HKLM (the whole machine, requires the admin rights already provided by the Toolbox's auto-elevation) - the mechanism officially documented by Microsoft to durably disable Recall, distinct from the simple toggle in Settings which stays one click away from being changed back by any user of the session.`n`nOn a machine without a Copilot+ compatible NPU (the vast majority of the current install base), this command has no visible effect since Recall isn't installed there - it then acts as a preventive lock, in case the machine is later replaced or upgraded to compatible hardware, without having to remember at that point.`n`nA restart is recommended for full effect, even though the policy is generally read when the relevant components start rather than continuously." }
                @{ Label = "Start menu web search (Bing) - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks whether Start menu search sends typed text to Bing/Microsoft (built-in web search) in addition to local search (files, apps, settings). An angle never covered by the rest of the catalog - distinct from the Advertising ID or the general telemetry level."
                   Confirm = $false
                   Help  = "By default, typing in Start menu search isn't limited to searching local files and apps: the typed text can be sent to Bing to enrich results with web content, even for a search that originally had nothing web-related about it (searching for a simple local file still triggers a background network request).`n`nThis behavior is often discovered by accident (a network connection visible in a firewall or traffic monitor when no web search was intended), rather than consciously chosen - few people know this setting exists independently of local search itself.`n`nVALUE LEGEND (BingSearchEnabled): 0 = disabled (local search only), 1 or absent = active - standard polarity." }
                @{ Label = "Disable Start menu web search (Bing)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Disables web search (Bing) in the Start menu, leaving local search (files, apps, settings) intact. May require a session logoff/login to take full effect on the interface."
                   Confirm = $true
                   Help  = "Only changes the BingSearchEnabled value - no other search feature is touched. Local search (files, folders, installed apps, system settings) keeps working normally after this change, only the 'web results' pane disappears from Start menu search.`n`nIf the change doesn't seem immediately visible, a session logoff/login (or restarting Explorer) generally forces it to take effect, since the search interface can cache its behavior during the current session." }
                @{ Label = "Sponsored suggestions/apps (Start menu) - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks the state of 4 settings grouped under ContentDeliveryManager that control ad suggestions and the automatic reinstallation of third-party apps (bloatware) in the Start menu. A value of 0 means disabled, 1 (or absent) means active."
                   Confirm = $false
                   Help  = "Detail of the 4 settings checked:`n`nSystemPaneSuggestionsEnabled`nShows app or content suggestions in the Start menu, generally based on usage or Microsoft commercial partnerships.`n`nSilentInstalledAppsEnabled`nAllows Windows to automatically install certain third-party apps in the background, without prior confirmation - the most direct source of 'bloatware coming back' after uninstalling it.`n`nSubscribedContent-338388Enabled`nA specific technical identifier corresponding to suggestions shown directly in the Start menu's app list.`n`nOemPreInstalledAppsEnabled`nControls whether apps pre-installed by the machine's manufacturer (OEM) are allowed to reinstall themselves or be promoted automatically.`n`nThese settings are partially exposed in Settings > Personalization > Start (the 'Show suggestions occasionally' toggle), but this single toggle doesn't necessarily cover all the sub-settings listed here individually - hence the value of a direct registry check.`n`nVALUE LEGEND (identical for all 4, reminder from the description above): 0 = disabled, 1 or absent = active - standard polarity, the same across all 4 settings." }
                @{ Label = "Disable sponsored suggestions/apps (Start menu)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "WARNING: disables all 6 ContentDeliveryManager settings related to Start menu suggestions and automatic third-party app reinstallation in one go. Deliberately groups the action rather than requiring hunting down every individual toggle in Settings."
                   Confirm = $true
                   Help  = "Groups the action across 6 settings total (the 4 detailed in 'Sponsored suggestions/apps (Start menu) - state', plus PreInstalledAppsEnabled and RotatingLockScreenEnabled, which respectively control pre-installed app reinstallation broadly and lock-screen suggestions) - refer to the status command just above for the detail of each.`n`nNo loss of functionality for everyday Windows use: these settings only control commercial suggestions/reinstalls, not a technical system feature. The Start menu and lock screen keep working normally, simply without suggestions or automatically reinstalled third-party apps appearing there." }
                @{ Label = "Tailored content (diagnostic) - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks whether Microsoft is allowed to use collected diagnostic data to tailor content in Windows (tips, suggestions, lock screen). Distinct from the general telemetry level (Windows telemetry level): that one controls the VOLUME of data collected, this one controls its USE for tailoring purposes once collected."
                   Confirm = $false
                   Help  = "Even with a telemetry level already reduced to the minimum (see 'Windows telemetry level' in this same catalog), this setting stays independent: it determines whether the diagnostic data still collected (even in reduced quantity) can be used to tailor the Windows experience - contextual tips, suggestions in Settings, lock screen content.`n`nMany people disable general telemetry without knowing this separate setting exists, leaving Microsoft free to keep using what's still collected for tailoring purposes - two independent decisions that should each be made consciously rather than assuming one covers the other.`n`nVALUE LEGEND (TailoredExperiencesWithDiagnosticDataEnabled): 0 = disabled, 1 or absent = active - standard polarity." }
                @{ Label = "Disable tailored content (diagnostic)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Disables the use of diagnostic data for Windows content tailoring purposes (tips, suggestions, lock screen). Does not affect the collection volume itself (see 'Windows telemetry level' for that separate setting)."
                   Confirm = $true
                   Help  = "Only changes TailoredExperiencesWithDiagnosticDataEnabled - the general telemetry level (AllowTelemetry) is not touched by this command and must be managed separately if wanted, via 'Windows telemetry level' elsewhere in this catalog.`n`nNo technical loss of functionality: Windows keeps working normally, simply without tips or suggestions tailored based on usage observed via diagnostic data." }
                @{ Label = "Cloud Clipboard - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks whether clipboard syncing between devices linked to the same Microsoft account (Cloud Clipboard) is active. Distinct from local clipboard history (Win+V, EnableClipboardHistory, a different key not covered here), which stays purely local and is not involved."
                   Confirm = $false
                   Help  = "Cloud Clipboard syncs copied content (text, and in some cases images/HTML) to the Microsoft account associated with the session, making it available on other devices linked to the same account - convenient, but with a real risk if a password, a key, or sensitive data ends up copied without thinking about it.`n`nSee 'Disable Cloud Clipboard' just below to disable it directly from the Toolbox rather than via Settings > System > Clipboard ('Sync across devices'/Cloud Clipboard).`n`nNot to be confused with local clipboard history (Win+V shortcut, enabled independently), which simply keeps the most recently copied items in local memory on this machine without ever sending anything to the cloud - a completely different feature, not covered by this command.`n`nVALUE LEGEND (EnableCloudClipboard): 1 = active, 0 or absent = inactive - standard polarity." }
                @{ Label = "Disable Cloud Clipboard"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Disables clipboard sync between devices (user preference EnableCloudClipboard=0) and blocks the setting by policy (AllowCrossDeviceClipboard=0 under HKLM) to prevent any later re-enabling, including by another user on the same machine."
                   Confirm = $true
                   Help  = "Two levels applied together:`n`n1. EnableCloudClipboard=0 under HKCU:\Software\Microsoft\Clipboard - the same setting read by 'Cloud Clipboard - state' just above, for an immediate, right-away verifiable effect via that same command.`n`n2. AllowCrossDeviceClipboard=0 under HKLM:\SOFTWARE\Policies\Microsoft\Windows\System - the official policy documented by Microsoft, which fully grays out the option in Settings > System > Clipboard for every user on the machine, preventing any manual re-enabling as long as the policy stays in place.`n`nLocal clipboard history (Win+V) is not affected by this command and keeps working normally - only syncing to the Microsoft account is blocked.`n`nTo revert: remove both values (or set them back to 1), then re-enable from Settings if desired." }
                @{ Label = "Widgets (News and interests) - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks whether the Widgets panel (button in the taskbar, personalized news feed based on user engagement) is blocked at the system policy level, as opposed to the simple Settings toggle which only hides the button without disabling the underlying feature."
                   Confirm = $false
                   Help  = "The Widgets panel (Win+W) shows a personalized feed of news and information, whose relevance relies on tracking the user's engagement with the content offered - a data-collection mechanism comparable in principle to any personalized online news feed, integrated directly into the Windows taskbar.`n`nTwo clearly distinct levels of disabling:`n- The toggle in Settings > Personalization > Taskbar > Widgets: only hides the BUTTON in the taskbar. The panel stays accessible via the Win+W shortcut, and the feature keeps running in the background.`n- The AllowNewsAndInterests policy (what this command checks): blocks the feature as a WHOLE - button grayed out, Win+W shortcut has no effect, the toggle itself grayed out in Settings to prevent accidental re-enabling.`n`nThis command specifically checks the second level, more complete and harder to inadvertently bypass than the simple interface toggle.`n`nVALUE LEGEND: 0 = blocked by policy, 1 or absent = not blocked. Unlike 'Windows Recall - current state' earlier in this same catalog, where it's the value 1 that means blocked: the number alone is never enough to interpret a privacy state, you always have to check the setting's name and whether it explicitly allows ('Allow...') or blocks ('Disable...') before concluding." }
                @{ Label = "Disable Widgets (News and interests)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "WARNING: completely blocks Widgets via system policy (HKLM, the whole machine) - button grayed out in the taskbar, Win+W shortcut disabled, the Settings toggle itself grayed out. More thorough than the simple Settings > Personalization > Taskbar toggle, which only hides the button without blocking the feature."
                   Confirm = $true
                   Help  = "Applies the AllowNewsAndInterests=0 policy under HKLM\SOFTWARE\Policies\Microsoft\Dsh, the official mechanism documented by Microsoft (identical to the one used by corporate management tools like Intune) to disable Widgets as a whole rather than just its visual presence in the taskbar.`n`nA restart is needed for full effect. To revert: remove the AllowNewsAndInterests value (or set it back to 1) then restart - the toggle in Settings then becomes changeable normally again." }
                @{ Label = "Check telemetry services"
                   Cmd   = 'powershell -NoExit -Command Get-Service DiagTrack,dmwappushservice,DoSvc,WerSvc,CDPSvc ^| Select-Object Name,Status,StartType ^| Format-Table -AutoSize'
                   Desc  = "Checks the state (Running/Stopped) and startup mode of five services related to telemetry and tracking (DiagTrack, dmwappushservice, Delivery Optimization, Windows Error Reporting, Connected Devices Platform). Useful for confirming that hardening (registry, GPO) is actually effective at the service level. Windows Search (WSearch), which has nothing to do with telemetry, was deliberately excluded from this list - see 'Check the WSearch service' in the Performance category."
                   Confirm = $false
                   Help  = "Detail of the five services checked:`n`nDiagTrack (Connected User Experiences and Telemetry)`nWindows' main telemetry service: collects diagnostic and usage data and sends it to Microsoft (detailed crash reports, feature usage statistics, etc.). Disabling it directly reduces the amount of data sent to Microsoft - no loss of functionality for everyday use.`n`ndmwappushservice (WAP Push Message Routing Service)`nInherited from an old mobile messaging technology (WAP), today associated with certain device-management notifications. Not well publicly documented in its exact current use, but classed by general consensus as related to telemetry/notification push rather than an active user feature. No notable loss from disabling it for personal use.`n`nDoSvc (Delivery Optimization)`nLets Windows both download AND share Windows/Store app updates peer-to-peer - the machine can serve as a download source for other machines (on the local network, or even on the internet depending on the default config), and vice versa. Disabling it forces Windows to download only from direct Microsoft servers: more predictable bandwidth, but sometimes slightly slower for large updates. Often configured with StartType Manual by default (rather than Disabled): it then only runs during an active update download, not permanently.`n`nWerSvc (Windows Error Reporting)`nSends Microsoft crash reports for applications and the system (crash dumps, exception info). Disabling it stops this automatic sending - automatic crash reporting to Microsoft stops, but nothing affecting normal application operation itself.`n`nCDPSvc (Connected Devices Platform)`nPowers continuity features between devices linked to a Microsoft account: 'Continue on this PC' from a phone, Nearby Sharing, activity syncing. If the Windows session uses a LOCAL account rather than a Microsoft account, this service is genuinely useless - worth checking case by case depending on the type of account used on the machine." }
                @{ Label = "Disable telemetry services"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "WARNING: stops and disables the telemetry services listed by 'Check telemetry services'. DoSvc (Delivery Optimization) is an exception: Windows refuses to fully disable this service on many configurations, so it is left at the maximum achievable state (stopped, Manual startup) - see 'Disable Delivery Optimization P2P' just below to actually block peer-to-peer sharing independently of this service's state. Reduces data sent to Microsoft with no loss of functionality for everyday use. Windows Search (WSearch) is NOT included here (a performance trade-off unrelated to privacy) - see 'Disable WSearch (indexing)' in the Performance category if both are wanted."
                   Confirm = $true
                   Help  = "Groups the action across the 5 services detailed individually via the ? button on 'Check telemetry services' just above - refer to that command to understand precisely what each service does before disabling them all at once.`n`nThese 5 services used to be grouped together with Windows Search (WSearch) in a single common command; splitting them into two distinct categories (Privacy / Telemetry here, Performance for WSearch) reflects the fact that these are two decisions of a different nature: reducing data sent to Microsoft comes with no functional trade-off, whereas disabling indexing genuinely slows down everyday file search - two independent trade-offs, which shouldn't be presented as a single grouped choice.`n`nSpecial case of DoSvc: unlike the other 4 services, DoSvc structurally refuses Set-Service -StartupType Disabled on many Windows configurations (the Service Control Manager blocks this full disable for this specific service) - even after this command runs successfully, DoSvc stays visible with Manual startup rather than Disabled, which is normal and expected, not a sign of failure. It therefore remains technically startable on demand (typically by Windows Update itself). To actually block peer-to-peer sharing independently of this service state, use 'Disable Delivery Optimization P2P' (category below), which acts via policy rather than stopping a service and is not affected by this limitation." }
                @{ Label = "Delivery Optimization P2P - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks the peer-to-peer (P2P) sharing mode used by Delivery Optimization for Windows updates and Microsoft Store apps, as well as the state of the DoSvc service that carries it."
                   Confirm = $false
                   Help  = "Delivery Optimization spreads the downloading of Windows and Store app updates across several PCs (somewhat like torrent-style sharing), rather than each machine downloading entirely from Microsoft servers. Depending on the configured mode, the machine can both receive data from other PCs AND send data to them - including, depending on the setting, unknown PCs anywhere on the Internet, not just on the local network.`n`nVALUE LEGEND (DODownloadMode):`n0 = HTTP only, no P2P - the most conservative behavior, direct download from Microsoft only.`n1 = Sharing with local network (LAN) devices only.`n2 = Sharing within a defined group (used in corporate environments, via DOGroupID or domain membership).`n3 = Sharing extended to the Internet in addition to the local network - the machine can then distribute data to unknown PCs.`n99 = Simple mode - functionally equivalent to 0 (reliable HTTP, no P2P).`n100 = Bypass mode (switches to BITS) - discouraged on Windows 11, a source of documented download errors in this mode.`n`nIf no value is set by policy (the most common case on a Windows install not managed by a business), the setting visible in Settings > Windows Update > Advanced options > Delivery Optimization > 'Allow downloads from other devices' applies instead - with the scope (local network only, or Internet too) chosen there." }
                @{ Label = "Disable Delivery Optimization P2P"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "WARNING: blocks Delivery Optimization P2P sharing by policy (DODownloadMode=0) - no more sharing with other PCs, neither uploading nor downloading. Complements 'Disable telemetry services', which cannot fully stop DoSvc on many machines."
                   Confirm = $true
                   Help  = "Unlike 'Disable telemetry services' (which tries to stop and disable the DoSvc service itself, without fully succeeding for this specific service - Windows refuses full DoSvc disabling on many configurations, the maximum achievable being Manual startup), this command acts directly on the DODownloadMode policy: it lets the service keep running as-is but explicitly forbids it any use of sharing between PCs.`n`nThis approach is more reliable over time than stopping the service: Windows Update has self-repair mechanisms (notably via the Windows Update Medic Service and dedicated scheduled tasks) that can restore a service deemed necessary for updates to work correctly, even after a manual disable - a stopped/disabled service can therefore end up re-enabled with no warning, typically around a major update. The policy-based setting, on the other hand, is designed to be durably respected by Windows Update regardless of the service's state.`n`nNo loss of functionality for updates themselves: they keep downloading normally, just directly from Microsoft servers rather than via other PCs. To revert: remove the DODownloadMode value (or set it back to 1 for sharing limited to the local network only)." }
                @{ Label = "Windows Error Reporting (WER) - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks whether automatically sending crash reports to Microsoft (Windows Error Reporting) is blocked by policy, along with the state of the WerSvc service that carries it."
                   Confirm = $false
                   Help  = "When an application or system component crashes, Windows Error Reporting collects information about the incident (and, depending on the nature of the crash, potentially a partial or full memory dump of the process at the moment of the crash) then offers to send it to Microsoft for analysis.`n`nThis risk isn't just theoretical: a memory dump captured at the moment of a crash can contain data that was in memory at that exact instant - typed passwords, session tokens, fragments of open documents - regardless of any targeted collection intent, simply because that's what happened to be in memory.`n`nThe WerSvc service is already covered by 'Disable telemetry services' (category above) - this command additionally checks the Disabled policy under Windows Error Reporting, which blocks the subsystem more broadly than just stopping the service (it also disables the associated Control Panel interface, and stays respected even if the service restarts for any reason)." }
                @{ Label = "Disable Windows Error Reporting (WER)"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Blocks sending crash reports to Microsoft via policy (Disabled=1 under Windows Error Reporting) - complements stopping the WerSvc service already done by 'Disable telemetry services', for a more complete and durable subsystem disable."
                   Confirm = $true
                   Help  = "Applies the Disabled=1 value under HKLM:\SOFTWARE\Microsoft\Windows\Windows Error Reporting - the official mechanism documented by Microsoft (identical to the one used by Group Policy) to fully disable Windows Error Reporting, beyond just stopping the service.`n`nNo loss of functionality for local diagnostics: events remain visible in Windows Event Viewer as usual, only sending to Microsoft and the associated interface are affected.`n`nTo revert: remove the Disabled value (or set it back to 0) under this same key." }
                @{ Label = "Windows Copilot - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks whether Copilot integration (Windows' built-in AI assistant, distinct from Recall and any NPU) is explicitly blocked by policy, at both the user (HKCU) and machine (HKLM) level."
                   Confirm = $false
                   Help  = "Copilot is the conversational assistant built into Windows (sidebar or taskbar icon depending on the version): unlike Recall, it requires no particular hardware (no NPU needed) and has been widely rolled out since 2023-2024 on Windows 11. Using it sends the requests you make to Microsoft's cloud services to generate a response.`n`nThis command specifically checks the TurnOffWindowsCopilot policy, the official mechanism documented by Microsoft (identical to the one used by corporate management tools like Intune/GPO) to disable Copilot at the system level rather than just hiding its icon.`n`nVALUE LEGEND: 1 = Copilot disabled by policy (the name starts with 'TurnOff' - a value of 1 enables this block). 0 or 'not defined' = no explicit block imposed - depending on version and region, Copilot may then be present and active by default.`n`nDepending on the Windows build and feature updates, Copilot's implementation (name, location in the interface, distribution method) may have evolved since this policy was first introduced - worth checking case by case if the observed behavior doesn't match what this command reports." }
                @{ Label = "Disable Windows Copilot"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Blocks Copilot via explicit policy (HKCU + HKLM), the official mechanism documented by Microsoft. A session logoff/login or a restart may be needed for the interface to fully reflect this."
                   Confirm = $true
                   Help  = "Creates/modifies the TurnOffWindowsCopilot value both under HKCU (current user) and HKLM (the whole machine, requires the admin rights already provided by the Toolbox's auto-elevation) - identical to the official blocking mechanism used by enterprise management tools (Intune/GPO).`n`nDepending on the Windows version and how Copilot is distributed on the machine (built into the system or installed separately from the Microsoft Store), this policy may not cover every possible entry point - checking via 'Windows Copilot - state' after a restart is still recommended to confirm the effect.`n`nTo revert: remove the TurnOffWindowsCopilot value (or set it back to 0) in both keys, then restart the session." }
                @{ Label = "Residual Edge telemetry - state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks the state of two Edge policies related to sending usage/diagnostic statistics to Microsoft. Relevant to any machine where Edge stays installed (a system component on Windows 11), even if another browser is used day-to-day - Edge can keep running in the background (updates, WebView2, quick startup) independently of the main browser chosen."
                   Confirm = $false
                   Help  = "Detail of the two settings checked:`n`nMetricsReportingEnabled`nControls the sending of usage statistics and crash reports (UMA - User Metrics Analysis) to Microsoft from Edge.`n`nPersonalizationReportingEnabled`nControls whether Edge usage data can be used for content personalization purposes (suggestions, offers, Microsoft Rewards).`n`nOn Windows 11, Edge stays a system component even if another browser is set as default: its residual presence (background updates, WebView2 shared by other applications) can keep reporting data if these policies aren't explicitly set, regardless of the browser actually used day-to-day.`n`nVALUE LEGEND (identical for both): 0 = disabled, 1 or 'not defined' = active - standard polarity." }
                @{ Label = "Disable residual Edge telemetry"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Applies MetricsReportingEnabled=0 and PersonalizationReportingEnabled=0 under HKLM\SOFTWARE\Policies\Microsoft\Edge - reduces statistics and personalization data sent by Edge, without uninstalling the browser or affecting another browser installed on the machine."
                   Confirm = $true
                   Help  = "Creates the Edge policy key if absent and applies the two values detailed in 'Residual Edge telemetry - state' just above - refer to that command for the detail of each setting.`n`nOnly affects the Edge component itself (usage statistics, crash reports, personalization): no impact on another browser installed on the machine (Chrome, Firefox, Brave, LibreWolf, or other) or on Edge's day-to-day browsing features if it ends up being used anyway.`n`nTo revert: remove both values (or set them back to 1) under the Edge policy key." }
                @{ Label = "OneDrive - sync/startup state"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "Checks at a glance whether the OneDrive process is currently running, whether it's configured to start automatically with the session, and whether syncing is blocked by policy. Useful for confirming the actual state on a given machine before acting."
                   Confirm = $false
                   Help  = "Three independent checks:`n`nOneDrive process`nShows whether OneDrive.exe is currently running in memory, regardless of its startup mode (manual or automatic).`n`nAutomatic startup`nChecks for an entry in the current user's Run key (HKCU), the standard mechanism through which OneDrive relaunches on every logon.`n`nSync policy (DisableFileSyncNGSC)`nChecks whether the official policy for blocking OneDrive syncing (documented by Microsoft, identical to the one used in corporate environments) is applied at the machine level (HKLM).`n`nThese three states are independent: a OneDrive process can be running even with sync blocked by policy (the client stays present but inactive), and conversely an automatic-startup entry can exist without the process running at the exact moment of the check." }
                @{ Label = "Disable OneDrive sync"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "WARNING: blocks OneDrive sync via machine policy (DisableFileSyncNGSC), removes the current user's automatic-startup entry, and stops the process if running. Does not uninstall OneDrive - the component stays present but inactive."
                   Confirm = $true
                   Help  = "Combines the three actions needed for a complete, durable block, rather than just closing the process (which would then restart at the next logon):`n`n1. Applies DisableFileSyncNGSC=1 under HKLM\SOFTWARE\Policies\Microsoft\Windows\OneDrive - the official mechanism documented by Microsoft preventing any syncing, including for other users on the same machine.`n`n2. Removes the OneDrive entry from the Run key (HKCU) that causes the client to automatically restart on every logon.`n`n3. Stops the OneDrive process if currently running, for an immediate effect without waiting for the next session.`n`nThe OneDrive component itself is not uninstalled by this command (no impact on any files already synced locally) - it stays present on disk but disabled. To revert: remove the DisableFileSyncNGSC value (or set it back to 0), which lets the user relaunch OneDrive manually if desired (automatic startup won't come back on its own, syncing will have to be relaunched/reconfigured manually)." }
            )
        }
        @{
            Name = "Miscellaneous"
            Commands = @(
                @{ Label = "Battery report"
                   Cmd   = 'powercfg /batteryreport /output %USERPROFILE%\Desktop\battery-report.html && start %USERPROFILE%\Desktop\battery-report.html'
                   Desc  = "Generates a detailed HTML report on battery wear (current capacity vs original capacity, usage history) and opens it automatically."
                   Confirm = $false }
                @{ Label = "Power diagnostic report"
                   Cmd   = 'powercfg /energy /output %USERPROFILE%\Desktop\energy-report.html && start %USERPROFILE%\Desktop\energy-report.html'
                   Desc  = "Analyzes the system for 60 seconds and generates a report on power/sleep issues (drivers preventing sleep, USB errors, etc.)."
                   Confirm = $false }
                @{ Label = "Instant CPU load"
                   Cmd   = 'powershell -NoExit -Command Get-CimInstance Win32_Processor ^| Select-Object LoadPercentage'
                   Desc  = "Shows the CPU usage percentage at the moment of execution. A simple snapshot, not continuous monitoring."
                   Confirm = $false }
                @{ Label = "Disk space (Get-Volume)"
                   Cmd   = 'powershell -NoExit -Command Get-Volume'
                   Desc  = "Lists every partition with its free/total space in a readable format, faster to read than File Explorer."
                   Confirm = $false }
                @{ Label = "Available power states"
                   Cmd   = 'powercfg /a'
                   Desc  = "Shows which sleep/hibernation states are available on the machine, and why some are unavailable if that's the case (useful for diagnosing S3/Modern Standby)."
                   Confirm = $false }
                @{ Label = "Restart PC"
                   Cmd   = 'shutdown /r /t 0'
                   Desc  = "WARNING: restarts the machine IMMEDIATELY, with no delay. Closes all open applications with no prior confirmation from them."
                   Confirm = $true
                   Help  = "Important difference from a classic restart via the Start menu: this uses /t 0 (0-second delay), so Windows does NOT give open applications time to offer saving their current work - unlike a normal restart, which generally shows a 'do you want to save?' prompt for each affected application before closing.`n`nWhat this means in practice: any unsaved document at the moment you click (an Office file, code being edited, a filled-out web form...) is lost, with no warning. Only use this when you're certain your current work is saved, or for a deliberately quick restart with no prior check." }
                @{ Label = "Shut down PC"
                   Cmd   = 'shutdown /s /t 0'
                   Desc  = "WARNING: shuts down the machine IMMEDIATELY, with no delay. Closes all open applications with no prior confirmation from them."
                   Confirm = $true
                   Help  = "Same logic as 'Restart PC' but for a full shutdown: /t 0 means no delay, so no save prompt for open applications before closing. Any unsaved document at the moment you click is lost.`n`nDifference from sleep: this is a full shutdown (power cut), not sleep - on the next startup, Windows boots up entirely rather than instantly resuming where you left off. Only use this knowingly if you have unsaved work in progress." }
                @{ Label = "DirectX report (dxdiag)"
                   Cmd   = 'dxdiag /t %TEMP%\dxdiag.txt && notepad %TEMP%\dxdiag.txt'
                   Desc  = "Generates the DirectX diagnostic report (GPU, drivers, DirectX support) and opens it in Notepad. Useful for gaming troubleshooting."
                   Confirm = $false }
                @{ Label = "Windows activation status"
                   Cmd   = 'slmgr /xpr'
                   Desc  = "Shows Windows activation status (license active or not) in a popup window (slmgr's native behavior, not an error if the console below stays empty)."
                   Confirm = $false }
                @{ Label = "Empty the Recycle Bin"
                   Cmd   = 'powershell -NoExit -EncodedCommand '
                   Desc  = "WARNING: permanently deletes all content of the Recycle Bin, with no way to recover it. Check its content before launching if in doubt."
                   Confirm = $true
                   Help  = "Clear-RecycleBin empties the Recycle Bin on ALL of the machine's drives at once (not just C:), no file-by-file selection possible from this command. Files aren't moved elsewhere or archived - they're erased in the sense that the disk space they occupied is marked as free and reusable, with no second recovery layer.`n`nWhat this means in practice: unlike a simple drag-and-drop into the Recycle Bin (recoverable), this action is genuinely irreversible in Windows' normal operation - only a specialized data-recovery tool (which searches for traces on the disk before they're overwritten by new files) could potentially recover something, with no guarantee. If a recently deleted file might still have value, check the Recycle Bin's content before running this command rather than after." }
                @{ Label = "General system information"
                   Cmd   = 'powershell -NoExit -Command $os = Get-CimInstance Win32_OperatingSystem; $cs = Get-CimInstance Win32_ComputerSystem; $reg = Get-ItemProperty ''HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion''; [PSCustomObject]@{OS=$os.Caption;Version=$reg.DisplayVersion;Build=($os.BuildNumber.ToString() + ''.'' + $reg.UBR.ToString());Manufacturer=$cs.Manufacturer;Model=$cs.Model;InstallDate=$os.InstallDate} ^| Format-List'
                   Desc  = "A quick ID card for the machine (Windows edition, version, build, manufacturer, model, install date). Uses Win32_OperatingSystem.Caption + the registry DisplayVersion/UBR rather than WindowsProductName (a known Microsoft bug, never fixed: the ProductName registry key stays frozen on 'Windows 10 [Edition]' even on an up-to-date Windows 11 install - Get-ComputerInfo inherits this flaw)."
                   Confirm = $false }
                @{ Label = "Open Maintenance_Reports"
                   Cmd   = 'explorer %USERPROFILE%\Desktop\Maintenance_Reports'
                   Desc  = "Directly opens the folder where all HTML/JSON reports generated by the maintenance script suite land."
                   Confirm = $false }
                @{ Label = "Active PowerShell version"
                   Cmd   = 'powershell -NoExit -Command $PSVersionTable; (Get-Command powershell.exe).Source'
                   Desc  = "Shows the exact PowerShell version resolved by 'powershell.exe' on this machine, plus the full path of the executable used. Useful for quickly checking whether powershell.exe points to PowerShell 7 or native Windows PowerShell 5.1 (the two can coexist depending on PATH)."
                   Confirm = $false }
                @{ Label = "Environment variables"
                   Cmd   = 'powershell -NoExit -Command Get-ChildItem Env: ^| Sort-Object Name ^| Format-Table -AutoSize'
                   Desc  = "Lists all active environment variables (PATH, TEMP, USERPROFILE, etc.), sorted by name. A basic but handy diagnostic for quickly checking a PATH value or a custom variable without opening System Properties."
                   Confirm = $false }
                @{ Label = "Unexpected shutdown/restart history"
                   Cmd   = 'powershell -NoExit -Command try { Get-WinEvent -FilterHashtable @{LogName=''System''; Id=41,6008} -MaxEvents 10 -ErrorAction Stop ^| Select-Object TimeCreated,Id,@{N=''Type'';E={if ($_.Id -eq 41) { ''Kernel-Power (abrupt cutoff: power outage, hardware crash, forced shutdown)'' } else { ''EventLog 6008 (Windows itself detected an unplanned shutdown at the next startup)'' }}} ^| Format-Table -AutoSize } catch { Write-Host ''No unexpected shutdown/restart found in the System log (good sign).'' -ForegroundColor Green }'
                   Desc  = "Lists the last 10 unexpected shutdowns/restarts logged in the System log (event 41 Kernel-Power = abrupt cutoff with no clean Windows shutdown, event 6008 = Windows itself detected at the next startup that the previous shutdown wasn't planned). Distinct from 'Recent system errors' (Performance) which covers all generic errors: this one specifically targets cutoffs/crashes, a strong signal of a hardware, power, or low-level driver problem. Clear message if no matching event is found, instead of a blocking error."
                   Confirm = $false
                   Help  = "The two events have a different origin but point to the same symptom: a shutdown that did NOT go through Windows' normal closing sequence.`n`nEvent 41 (Kernel-Power): logged by the kernel at the next startup, when Windows notices the previous session never properly signaled its shutdown before disappearing - typically a power outage, a forced long press on the power button, a total crash (a severe BSOD with not even time to write the crash dump), or a hardware issue like a failing power supply or overheating triggering a hardware protection.`n`nEvent 6008 (EventLog): historically older, logs a similar finding ('the system restarted without shutting down cleanly beforehand') but coming from the EventLog service itself rather than the kernel - the two generally appear together for the same incident, not one instead of the other.`n`nAn isolated event isn't necessarily worrying (a genuine power outage, for instance). What deserves attention is RECURRENCE: several occurrences close together in time are a strong signal worth investigating on the power supply side (an aging or undersized PSU), overheating (check via a hardware monitoring tool, CPU/GPU temperatures), or an unstable low-level driver (GPU, chipset) rather than coincidence. Unrelated to a deliberate shutdown via 'Restart PC'/'Shut down PC' in this same catalog - those go through the normal sequence and generate neither event 41 nor 6008." }
                @{ Label = "Time synchronization"
                   Cmd   = 'w32tm /query /status'
                   Desc  = "Shows the system clock's sync status: current time source (NTP server, hardware source...), last measured offset, and sync frequency. A significant clock offset can cause silent authentication failures (Kerberos), TLS connection failures, or scheduled task failures, with no explicit error message pointing to the time itself."
                   Confirm = $false
                   Help  = "The command queries the Windows Time service (W32Time), which by default syncs the system clock against an NTP server (time.windows.com by default, or another server if configured via GPO/registry) at a deliberately low frequency (roughly once a week) - the hardware clock (RTC) drifts very little between two syncs on modern hardware, a higher frequency brings no significant benefit.`n`nIf the command returns an error like 'the service has not been started' rather than a status report, that means the Windows Time service is currently stopped. In everyday desktop use, this service is often configured to start on demand rather than run permanently in the background, which is normal and not necessarily an anomaly to fix.`n`nAn offset of a few hundred milliseconds is normal and has no consequence. An offset of several seconds or more, on the other hand, can genuinely trigger Kerberos authentication failures (Windows' default tolerance is 5 minutes, but some services are stricter) or TLS certificate validation errors if the difference is large enough." }
                @{ Label = "Installed printers"
                   Cmd   = 'powershell -NoExit -Command try { Get-Printer -ErrorAction Stop ^| Select-Object Name,DriverName,PortName,Shared ^| Format-Table -AutoSize } catch { Write-Host ''No printer found or PrintManagement module unavailable.'' -ForegroundColor Yellow }'
                   Desc  = "Lists installed printers (physical, virtual like Microsoft Print to PDF, and network), with their driver, port, and whether they're shared on the network. A simple inventory, absent from the catalog until now."
                   Confirm = $false
                   Help  = "Includes both physically connected printers (USB, network) and virtual printers natively provided by Windows (Microsoft Print to PDF, Microsoft XPS Document Writer) - the latter are normal and present by default on a standard Windows install, not an anomaly.`n`nThe Shared column shows whether the printer is shared on the local network, making it usable from other machines - useful information for a network exposure-surface audit, in the same spirit as 'Active network shares' just above in the Quick security category (a poorly configured or outdated shared printer driver can be an attack vector, as illustrated by the PrintNightmare vulnerability)." }
            )
        }
    )
}

